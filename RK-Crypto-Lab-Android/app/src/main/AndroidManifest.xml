// Google Sheets: Extensions > Apps Script. الصق هذا ثم Deploy > New deployment > Web app
// Execute as: Me  |  Who has access: Anyone
function doPost(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('log') || ss.insertSheet('log');
  if (sh.getLastRow() === 0) sh.appendRow(['time','id','event','appVersion','android','model','lang']);
  try {
    var d = JSON.parse(e.postData.contents);
    sh.appendRow([new Date(), d.id, d.event, d.appVersion, d.android, d.model, d.lang]);
  } catch (err) {}
  return ContentService.createTextOutput('ok');
}
