<div id="toast"><i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400"></i><span id="toastMessage"></span></div>

<script>
// ---------- UI helpers ----------
function showToast(msg, icon='fa-circle-check text-emerald-400'){
  const t=document.getElementById('toast');
  document.getElementById('toastMessage').innerText=msg;
  document.getElementById('toastIcon').className='fa-solid '+icon;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3000);
}
function copyText(txt,okMsg){
  const done=()=>showToast(okMsg);
  const fallback=()=>{
    const ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();
    try{document.execCommand('copy');done();}
    catch(e){showToast('فشل النسخ تلقائياً','fa-circle-xmark text-rose-400');}
    document.body.removeChild(ta);
  };
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(txt).then(done).catch(fallback);}
  else fallback();
}
function copyResult(){
  const txt=document.getElementById('finalResult').innerText;
  if(!txt||txt==='النتيجة ستظهر هنا...'){showToast('لا توجد نتيجة لنسخها!','fa-triangle-exclamation text-amber-400');return;}
  copyText(txt,'تم نسخ النتيجة بنجاح');
}
function copyLog(){
  const txt=document.getElementById('stepsLog').innerText;
  if(!txt||txt.trim().startsWith('// لا يوجد تشغيل')){showToast('لا توجد خطوات لنسخها! شغّل التشفير أولاً','fa-triangle-exclamation text-amber-400');return;}
  copyText(txt,'تم نسخ خطوات الشرح الرياضي بنجاح');
}
function downloadLab(){
  const clone=document.documentElement.cloneNode(true);
  clone.querySelector('#finalResult').textContent='النتيجة ستظهر هنا...';
  clone.querySelector('#stepsLog').textContent='// لا يوجد تشغيل حالياً.\n// أدخل النص واضغط تشفير أو فك التشفير لمشاهدة العمليات الرياضية.';
  const t=clone.querySelector('#toast');if(t)t.classList.remove('show');
  clone.querySelectorAll('link[rel="manifest"],#rkIT,#rkApkDlg').forEach(x=>x.remove());
  const ri=clone.querySelector('#rkIntro');if(ri)ri.remove();
  const html='<!DOCTYPE html>\n'+clone.outerHTML;
  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='Cryptography-Lab.html';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
  showToast('تم تحميل المشروع كملف واحد');
}
function toggleAdvancedSettings(){
  document.getElementById('advancedSettings').classList.toggle('hidden');
  document.getElementById('settingsChevron').classList.toggle('rotate-180');
}
function toggleKeyInputs(){
  const algo=document.getElementById('algorithm').value;
  ['rsaKeys','elgamalKeys','desKeys'].forEach(id=>document.getElementById(id).classList.add('hidden'));
  const t=document.getElementById('algoInfoTitle'),d=document.getElementById('algoInfoDesc');
  if(algo==='rsa'){
    document.getElementById('rsaKeys').classList.remove('hidden');
    t.innerHTML='<i class="fa-solid fa-key"></i> خوارزمية RSA';
    d.innerHTML='تعتمد على صعوبة تحليل حاصل ضرب عددين أوليين كبيرين <b style="color:#fff">(N = P × Q)</b>. يُستخدم المفتاح العام للتشفير والخاص لفك التشفير.';
  }else if(algo==='elgamal'){
    document.getElementById('elgamalKeys').classList.remove('hidden');
    t.innerHTML='<i class="fa-solid fa-shield-halved"></i> خوارزمية ElGamal';
    d.innerHTML='تعتمد على صعوبة حساب <b style="color:#fff">اللوغاريتمات المتقطعة</b>. تنتج لكل حرف قيمتين (c1, c2).';
  }else{
    document.getElementById('desKeys').classList.remove('hidden');
    t.innerHTML='<i class="fa-solid fa-lock"></i> خوارزمية DES المبسطة';
    d.innerHTML='نموذج مبسط للتشفير المتناظر بمفتاح مشترك باستخدام عمليات <b style="color:#fff">XOR</b> مع قيم ASCII.';
  }
}
function fillExample(){
  const a=document.getElementById('algorithm').value;
  document.getElementById('inputText').value=(a==='des')?'Crypto2026':'Hello';
  showToast('تم إدخال نص تجريبي');
}

// ---------- Math ----------
function modPow(base,exp,mod){
  let res=1n;base=BigInt(base)%BigInt(mod);exp=BigInt(exp);mod=BigInt(mod);
  while(exp>0n){if(exp%2n===1n)res=(res*base)%mod;exp=exp/2n;base=(base*base)%mod;}
  return res;
}
function modInverse(e,phi){
  let m0=BigInt(phi),y=0n,x=1n;e=BigInt(e);phi=BigInt(phi);
  if(phi===1n)return 0n;
  while(e>1n){if(phi===0n)break;let q=e/phi,t=phi;phi=e%phi;e=t;t=y;y=x-q*y;x=t;}
  if(x<0n)x+=m0;return x;
}

// ---------- RSA ----------
function rsaParams(){
  const p=BigInt(document.getElementById('rsaP').value||61);
  const q=BigInt(document.getElementById('rsaQ').value||53);
  const e=BigInt(document.getElementById('rsaE').value||17);
  const n=p*q,phi=(p-1n)*(q-1n),d=modInverse(e,phi);
  return {p,q,e,n,phi,d};
}
function runRSAEncrypt(text){
  const {p,q,e,n,phi,d}=rsaParams();
  let log=`=========================================\n  RSA ENCRYPTION PROCESS\n=========================================\n`;
  log+=`1. Prime Numbers: P = ${p}, Q = ${q}\n2. Modulus (N = P * Q): N = ${n}\n3. Euler's Totient φ(N) = (P-1)*(Q-1) = ${phi}\n4. Public Exponent (E): ${e}\n5. Private Exponent (D): ${d}\n`;
  log+=`   --> Public Key:  (e=${e}, n=${n})\n   --> Private Key: (d=${d}, n=${n})\n\n`;
  log+=`-----------------------------------------\nCHAR | ASCII (m) | FORMULA (m^e mod n) | CIPHER (c)\n-----------------------------------------\n`;
  const out=[];
  for(let i=0;i<text.length;i++){
    const m=BigInt(text.charCodeAt(i)),c=modPow(m,e,n);
    out.push(c.toString());
    log+=`  '${text[i]}' |    ${m.toString().padEnd(6)} | ${m}^${e} mod ${n}`.padEnd(38)+` | ${c}\n`;
  }
  return {result:out.join(' '),steps:log};
}
function runRSADecrypt(str){
  const {n,d}=rsaParams();
  let log=`=========================================\n  RSA DECRYPTION PROCESS\n=========================================\nKeys: Private Exponent D = ${d}, Modulus N = ${n}\n\n`;
  log+=`-----------------------------------------\nCIPHER (c) | FORMULA (c^d mod n) | ASCII (m) | CHAR\n-----------------------------------------\n`;
  let plain='';
  for(const tk of str.trim().split(/\s+/)){
    if(!tk)continue;
    const c=BigInt(tk),m=modPow(c,d,n),ch=String.fromCharCode(Number(m));
    plain+=ch;
    log+=` ${c.toString().padEnd(10)} | ${c}^${d} mod ${n}`.padEnd(33)+` | ${m.toString().padEnd(9)} | '${ch}'\n`;
  }
  return {result:plain,steps:log};
}

// ---------- ElGamal ----------
function runElGamalEncrypt(text){
  const p=BigInt(document.getElementById('elgamalP').value||467);
  const g=BigInt(document.getElementById('elgamalG').value||2);
  const x=BigInt(document.getElementById('elgamalX').value||153);
  const k=197n,h=modPow(g,x,p);
  let log=`=========================================\n  ELGAMAL ENCRYPTION PROCESS\n=========================================\n`;
  log+=`1. Prime Modulus (P): ${p}\n2. Generator (G): ${g}\n3. Private Key (X): ${x}\n4. Public Key (H = g^x mod p): ${h}\n5. Ephemeral Key (K): ${k}\n\n`;
  const c1=modPow(g,k,p),s=modPow(h,k,p);
  log+=`c1 = g^k mod p = ${c1}\nShared Secret s = h^k mod p = ${s}\n\n`;
  log+=`-----------------------------------------\nCHAR | ASCII (m) | c2 = (m * s) mod p | PAIR (c1,c2)\n-----------------------------------------\n`;
  const pairs=[];
  for(let i=0;i<text.length;i++){
    const m=BigInt(text.charCodeAt(i)),c2=(m*s)%p;
    pairs.push(`${c1},${c2}`);
    log+=`  '${text[i]}' |    ${m.toString().padEnd(6)} | (${m} * ${s}) mod ${p} = ${c2.toString().padEnd(5)} | (${c1},${c2})\n`;
  }
  return {result:pairs.join(' '),steps:log};
}
function runElGamalDecrypt(str){
  const p=BigInt(document.getElementById('elgamalP').value||467);
  const x=BigInt(document.getElementById('elgamalX').value||153);
  let log=`=========================================\n  ELGAMAL DECRYPTION PROCESS\n=========================================\nParameters: Prime P = ${p}, Private Key X = ${x}\n\n`;
  log+=`---------------------------------------------------\nPAIR (c1,c2) | s = c1^x mod p | s^-1 mod p | ASCII | CHAR\n---------------------------------------------------\n`;
  let plain='';
  for(const tk of str.trim().split(/\s+/)){
    if(!tk)continue;
    const parts=tk.split(',');if(parts.length!==2)continue;
    const c1=BigInt(parts[0]),c2=BigInt(parts[1]);
    const s=modPow(c1,x,p),sInv=modPow(s,p-2n,p),m=(c2*sInv)%p,ch=String.fromCharCode(Number(m));
    plain+=ch;
    log+=` (${c1},${c2})`.padEnd(13)+`| ${s.toString().padEnd(13)}| ${sInv.toString().padEnd(11)}| ${m.toString().padEnd(6)}| '${ch}'\n`;
  }
  return {result:plain,steps:log};
}

// ---------- DES (simplified XOR) ----------
function runDESEncrypt(text){
  const key=parseInt(document.getElementById('desKey').value||'5A',16)||0x5A;
  const K=key.toString(16).toUpperCase().padStart(2,'0');
  let log=`=========================================\n  DES SIMPLIFIED (XOR DEMO)\n=========================================\n1. Shared Secret Key (Hex): 0x${K}\n2. Key Binary: ${key.toString(2).padStart(8,'0')}\n\n`;
  log+=`-----------------------------------------\nCHAR | ASCII (Dec) | ASCII (Hex) | XOR KEY | CIPHER (Hex)\n-----------------------------------------\n`;
  const out=[];
  for(let i=0;i<text.length;i++){
    const dec=text.charCodeAt(i),hex=dec.toString(16).toUpperCase().padStart(2,'0');
    const enc=(dec^key),eh=enc.toString(16).toUpperCase().padStart(2,'0');
    out.push(eh);
    log+=`  '${text[i]}' |     ${dec.toString().padEnd(8)} | 0x${hex}       | XOR 0x${K} | 0x${eh}\n`;
  }
  return {result:out.join(' '),steps:log};
}
function runDESDecrypt(str){
  const key=parseInt(document.getElementById('desKey').value||'5A',16)||0x5A;
  const K=key.toString(16).toUpperCase().padStart(2,'0');
  let log=`=========================================\n  DES SIMPLIFIED DECRYPTION\n=========================================\nKey (Hex): 0x${K}\n\n-----------------------------------------\nCIPHER (Hex) | XOR KEY | ASCII (Dec) | CHAR\n-----------------------------------------\n`;
  let plain='';
  for(const tk of str.trim().split(/\s+/)){
    if(!tk)continue;
    const dec=parseInt(tk,16)^key,ch=String.fromCharCode(dec);
    plain+=ch;
    log+=` 0x${tk.toUpperCase().padStart(2,'0')}`.padEnd(14)+`| XOR 0x${K} | ${dec.toString().padEnd(11)}| '${ch}'\n`;
  }
  return {result:plain,steps:log};
}

// ---------- Handlers ----------
function handleEncrypt(){
  const input=document.getElementById('inputText').value,algo=document.getElementById('algorithm').value;
  if(!input){showToast('يرجى إدخال النص المراد تشفيره أولاً!','fa-triangle-exclamation text-amber-400');return;}
  const r=algo==='rsa'?runRSAEncrypt(input):algo==='elgamal'?runElGamalEncrypt(input):runDESEncrypt(input);
  scrambleTo(document.getElementById('finalResult'),r.result);
  document.getElementById('stepsLog').innerText=r.steps;
  showToast('تمت عملية التشفير وشرح الخطوات بنجاح');
}
function handleDecrypt(){
  const input=document.getElementById('inputText').value,algo=document.getElementById('algorithm').value;
  if(!input){showToast('يرجى إدخال الشفرة المراد فكها!','fa-triangle-exclamation text-amber-400');return;}
  try{
    const r=algo==='rsa'?runRSADecrypt(input):algo==='elgamal'?runElGamalDecrypt(input):runDESDecrypt(input);
    scrambleTo(document.getElementById('finalResult'),r.result);
    document.getElementById('stepsLog').innerText=r.steps;
    showToast('تم فك التشفير وعرض التفاصيل');
  }catch(err){showToast('خطأ في صيغة الإدخال! تأكد من تطابق الخوارزمية','fa-circle-xmark text-rose-400');}
}
// ---------- Mini explainer (lightweight: no work until Play) ----------
const VDUR=4500;
const VGENERAL=[
 {t:'1) ما هو التشفير؟',c:'التشفير هو تحويل رسالة مفهومة (نص أصلي) إلى رموز لا يفهمها إلا من يملك المفتاح الصحيح.',
  h:`<div class="vrow"><div class="vbox plain">Hello<small>النص الأصلي Plaintext</small></div></div>`},
 {t:'2) خطوة التشفير',c:'نطبّق الخوارزمية مع المفتاح على كل حرف. مثال DES المبسط بمفتاح 5A: كل حرف يُجرى عليه XOR مع المفتاح.',
  h:`<div class="vrow"><div class="vbox plain">Hello</div><div class="varrow" style="animation-delay:.3s">➜</div><div class="vbox key" style="animation-delay:.5s">🔑 XOR 5A<small>المفتاح + الخوارزمية</small></div><div class="varrow" style="animation-delay:.8s">➜</div><div class="vbox cipher" style="animation-delay:1s">12 3F 36 36 35<small>النص المشفّر Ciphertext</small></div></div>`},
 {t:'3) الإرسال عبر الشبكة',c:'حتى لو اعترض شخص الرسالة أثناء الإرسال، سيرى رموزاً بلا معنى ولن يستطيع قراءتها.',
  h:`<div class="vrow"><div class="vbox plain">👤 المُرسِل</div><div class="varrow" style="animation-delay:.3s">➜</div><div class="vbox cipher" style="animation-delay:.5s">12 3F 36 36 35</div><div class="varrow" style="animation-delay:.8s">➜</div><div class="vbox net" style="animation-delay:1s">👤 المستلِم</div></div><div class="vrow"><div class="vbox cipher" style="animation-delay:1.4s">🕵️ المتطفّل: لا يفهم شيئاً</div></div>`},
 {t:'4) فك التشفير',c:'المستلم يملك المفتاح الصحيح، فيعكس العملية ويستعيد النص الأصلي كما كان.',
  h:`<div class="vrow"><div class="vbox cipher">12 3F 36 36 35</div><div class="varrow" style="animation-delay:.3s">➜</div><div class="vbox key" style="animation-delay:.5s">🔑 XOR 5A</div><div class="varrow" style="animation-delay:.8s">➜</div><div class="vbox plain" style="animation-delay:1s">Hello ✔</div></div>`},
 {t:'5) أنواع الخوارزميات',c:'التشفير المتناظر يستخدم مفتاحاً واحداً، وغير المتناظر يستخدم مفتاحاً عاماً للتشفير وخاصاً لفك التشفير.',
  h:`<div class="vcards"><div class="vcard"><b>DES 🔑</b>مفتاح واحد مشترك للتشفير وفك التشفير (متناظر).</div><div class="vcard" style="animation-delay:.3s"><b>RSA 🔐</b>مفتاح عام وخاص، وأمانه من صعوبة تحليل N = P × Q.</div><div class="vcard" style="animation-delay:.6s"><b>ElGamal 🧮</b>يعتمد على اللوغاريتمات المتقطعة وينتج (c1, c2).</div></div>`},
 {t:'6) جرّب بنفسك!',c:'اكتب نصاً في المختبر أعلاه، واختر الخوارزمية، واضغط تشفير لترى الخطوات الرياضية كاملة.',
  h:`<div class="vrow"><div class="vbox plain">✍️ اكتب</div><div class="varrow" style="animation-delay:.3s">➜</div><div class="vbox key" style="animation-delay:.5s">🔒 شفّر</div><div class="varrow" style="animation-delay:.8s">➜</div><div class="vbox net" style="animation-delay:1s">📋 انسخ الشرح</div></div>`}
];

// tiny builders to keep scene markup short
const B=(c,t,d=0)=>`<div class="vbox ${c}" style="animation-delay:${d}s">${t}</div>`;
const A=(d=0)=>`<div class="varrow" style="animation-delay:${d}s">➜</div>`;
const F=(t,d=0)=>`<div class="vform" style="animation-delay:${d}s">${t}</div>`;
const R=h=>`<div class="vrow">${h}</div>`;

// DES: 'H' = 0x48 ; key = 0x5A ; 0x48 XOR 0x5A = 0x12
const VDES=[
 {t:'1) مفتاح واحد للطرفين',c:'في DES يتفق المُرسِل والمستلِم مسبقاً على نفس المفتاح السري، ويستخدمانه للتشفير ولفك التشفير معاً. لهذا يُسمّى تشفيراً متناظراً (Symmetric).',
  h:R(B('plain','👤 المُرسِل')+A(.3)+B('key','🔑 5A',.5)+A(.8)+B('plain','👤 المستلِم',1))},
 {t:'2) نحوّل الحرف إلى أرقام',c:'الحاسوب لا يفهم الحروف، فنأخذ رمز ASCII للحرف ثم نكتبه بالنظام الثنائي (8 بت).',
  h:R(B('plain',"'H'",0)+A(.3)+B('net','ASCII = 72',.5)+A(.8)+B('key','0x48',1))+F('72 = <em>0100 1000</em>',1.3)},
 {t:'3) عملية XOR مع المفتاح',c:'XOR تقارن كل بتّين: إذا تطابقا تكون النتيجة 0، وإذا اختلفا تكون 1. نطبّقها بين الحرف والمفتاح 5A.',
  h:F('  H : <em>0 1 0 0 1 0 0 0</em>',0)+F('KEY : <u>0 1 0 1 1 0 1 0</u>',.5)+F('XOR :  0 0 0 1 0 0 1 0',1)},
 {t:'4) النص المشفّر',c:'الناتج 0001 0010 يساوي 12 بالست عشري. نكرر نفس الشيء لكل حرف، فتصبح كلمة Hello هي: 12 3F 36 36 35.',
  h:R(B('plain','Hello')+A(.3)+B('key','XOR 5A',.5)+A(.8)+B('cipher','12 3F 36 36 35',1))},
 {t:'5) فك التشفير',c:'نطبّق XOR بنفس المفتاح مرة ثانية فيعود الحرف الأصلي. هذه خاصية XOR: تطبيقها مرتين بنفس القيمة يلغي أثرها.',
  h:R(B('cipher','12')+A(.3)+B('key','XOR 5A',.5)+A(.8)+B('plain',"48 = 'H' ✔",1))},
 {t:'6) ملاحظة مهمة',c:'DES الحقيقي يعمل على كتل من 64 بت عبر 16 جولة من شبكة Feistel، أما هنا فنموذج مبسط للتعلّم. قوة هذا النوع في سرعته، وتحديه في إيصال المفتاح للطرف الآخر بأمان.',
  h:R(B('key','⚡ سريع')+B('net','🔑 مفتاح مشترك',.3)+B('cipher','⚠️ توزيع المفتاح',.6))}
];

// RSA: p=61 q=53 n=3233 phi=3120 e=17 d=2753 ; 72^17 mod 3233 = 3000
const VRSA=[
 {t:'1) مفتاحان بدل مفتاح واحد',c:'في RSA يملك كل شخص مفتاحاً عاماً (يعطيه للجميع) يُستخدم للتشفير، ومفتاحاً خاصاً (يحتفظ به سراً) يُستخدم لفك التشفير. لهذا يُسمّى غير متناظر (Asymmetric).',
  h:R(B('pub','🔓 المفتاح العام<small>e = 17 , n = 3233</small>')+B('priv','🔐 المفتاح الخاص<small>d = 2753</small>',.4))},
 {t:'2) توليد المفاتيح',c:'نختار عددين أوليين P وQ ونضربهما للحصول على N. ثم نحسب φ ونختار e، ونجد d بحيث يكون (e × d) mod φ = 1.',
  h:F('P = <em>61</em>   Q = <em>53</em>',0)+F('N = P × Q = <u>3233</u>',.4)+F('φ = (P−1)(Q−1) = <u>3120</u>',.8)+F('e = 17  →  d = <em>2753</em>   (17×2753 mod 3120 = 1)',1.2)},
 {t:'3) التشفير بالمفتاح العام',c:'نأخذ الحرف H (ASCII = 72) ونطبّق المعادلة: c = m^e mod n باستخدام المفتاح العام.',
  h:R(B('plain',"'H' = 72")+A(.3)+B('pub','🔓 72^17 mod 3233',.5)+A(.8)+B('cipher','3000',1))},
 {t:'4) فك التشفير بالمفتاح الخاص',c:'صاحب المفتاح الخاص فقط يستطيع تطبيق m = c^d mod n واسترجاع الحرف الأصلي.',
  h:R(B('cipher','3000')+A(.3)+B('priv','🔐 3000^2753 mod 3233',.5)+A(.8)+B('plain',"72 = 'H' ✔",1))},
 {t:'5) لماذا هو آمن؟',c:'لمعرفة المفتاح الخاص يجب تحليل N إلى P × Q. مع 3233 يسهل ذلك (61 × 53)، لكن مع أعداد من مئات الخانات يصبح التحليل غير عملي حاسوبياً.',
  h:R(B('plain','3233 = ?')+A(.3)+B('key','61 × 53',.5)+B('cipher','✔ سهل: رقم صغير',.8))+R(B('net','عدد من 600 خانة = ❌ شبه مستحيل',1.2))},
 {t:'6) ماذا نستفيد؟',c:'لا حاجة لإرسال مفتاح سري عبر الشبكة: الجميع يعرف المفتاح العام ولا يفك الشفرة إلا صاحب الخاص. تُستخدم RSA في الشهادات الرقمية والتوقيعات.',
  h:R(B('pub','👥 الكل يشفّر')+A(.3)+B('priv','👤 صاحب المفتاح الخاص وحده يفك',.6))}
];

// ElGamal: p=467 g=2 x=153 h=224 ; k=197 c1=87 s=367 ; c2=72*367 mod 467=272 ; inverse(367)=14
const VELG=[
 {t:'1) فكرة اللوغاريتم المتقطع',c:'ElGamal يعتمد على مسألة رياضية: حساب g^x mod p سهل وسريع، لكن معرفة x من النتيجة صعبة جداً مع أعداد كبيرة.',
  h:R(B('plain','x  ➜  g^x mod p')+B('key','✔ سهل',.4))+R(B('cipher','g^x mod p  ➜  x')+B('net','❌ صعب',.8))},
 {t:'2) توليد المفاتيح',c:'نختار العدد الأولي P والمولّد G، ونختار مفتاحاً خاصاً X سرياً، ثم نحسب المفتاح العام H.',
  h:F('P = <em>467</em>   G = <em>2</em>',0)+F('X = <u>153</u>  (سري)',.4)+F('H = G^X mod P = 2^153 mod 467 = <em>224</em>  (عام)',.8)},
 {t:'3) سر مشترك مؤقت',c:'عند كل تشفير نختار عدداً عشوائياً k (هنا 197). نحسب c1 للإرسال، ونحسب سراً s من المفتاح العام H.',
  h:F('k = 197',0)+F('c1 = G^k mod P = <em>87</em>',.4)+F('s  = H^k mod P = <u>367</u>',.8)},
 {t:'4) إخفاء الحرف',c:'نضرب الحرف H (ASCII = 72) في السر s فنحصل على c2. الشفرة النهائية قيمتان: (c1 , c2).',
  h:R(B('plain',"'H' = 72")+A(.3)+B('key','× s (367) mod 467',.5)+A(.8)+B('cipher','c2 = 272',1))+F('الشفرة = (<em>87</em> , <u>272</u>)',1.3)},
 {t:'5) فك التشفير',c:'المستلم يملك X فيعيد حساب نفس السر من c1، ثم يقسم c2 عليه (بضرب c2 في مقلوب s). النتيجة: الحرف الأصلي.',
  h:F('s = c1^X mod P = 87^153 mod 467 = <u>367</u>  ✔ نفس السر',0)+F('s⁻¹ = 14   →   m = 272 × 14 mod 467 = <em>72</em>',.6)+R(B('plain',"72 = 'H' ✔",1.1))},
 {t:'6) ملاحظات',c:'ElGamal يعطي قيمتين لكل حرف أي حجماً مضاعفاً. وفي الاستخدام الحقيقي يُختار k جديد لكل رسالة، فتختلف الشفرة حتى لو تكرر النص.',
  h:R(B('pub','📦 (c1 , c2)')+B('net','🎲 k عشوائي كل مرة',.3)+B('key','🔒 أمانه من log المتقطع',.6))}
];
// ======== SIMPLE LEVEL: everyday analogies (apples, locked box, mailbox, paint) ========
const VS_GEN=[
 {t:'1) رسالة سرية',c:'تخيّل أنك كتبت رسالة لصديقك، وتخاف أن يقرأها شخص آخر في الطريق. التشفير هو الطريقة التي نخفي بها الرسالة.',
  h:R(B('plain','💌 رسالتي')+A(.3)+B('net','👦 صديقي',.6))+R(B('cipher','👀 هل سيقرؤها غيري؟',1))},
 {t:'2) الصندوق المقفل',c:'نضع الرسالة داخل صندوق ونغلقه بقفل. هذا هو التشفير: تحويل الرسالة إلى شيء لا يمكن فهمه.',
  h:R(B('plain','💌')+A(.3)+B('cipher','📦🔒 صندوق مقفل',.6))},
 {t:'3) المفتاح',c:'صديقي يملك المفتاح المناسب، فيفتح الصندوق ويقرأ الرسالة. هذا هو فك التشفير.',
  h:R(B('cipher','📦🔒')+A(.3)+B('key','🔑 المفتاح',.6)+A(.9)+B('plain','💌 ✔',1.2))},
 {t:'4) وماذا عن اللص؟',c:'لو سرق اللص الصندوق فلن يرى إلا صندوقاً مقفلاً، ولن يفهم شيئاً لأنه لا يملك المفتاح.',
  h:R(B('net','🕵️ اللص')+A(.3)+B('cipher','📦🔒',.6)+A(.9)+B('cipher','❌ لا يستطيع فتحه',1.2))},
 {t:'5) فكرة مهمة: باقي القسمة',c:'نستخدم في RSA وElGamal فكرة بسيطة: لدينا 17 تفاحة نوزعها على 5 أشخاص. يأخذ كل شخص 3 تفاحات وتبقى تفاحتان. هذا الباقي هو ما نحتاجه، ونكتبه بالرمز mod كما في الأسفل.',
  h:R(B('apple','🍎 × 17')+B('net','÷ 5 👥',.3))+R(B('plain','لكل واحد 3 🍎',.7)+B('apple','الباقي = 2 🍎🍎',1.1))+F('17 mod 5 = <em>2</em>',1.6)},
 {t:'6) ثلاث طرق للتشفير',c:'DES: مفتاح واحد يملكه الطرفان. RSA: قفل مفتوح للجميع ومفتاح خاص لصاحبه. ElGamal: خلط الألوان السري. اختر أحدها من الأزرار أعلاه.',
  h:`<div class="vcards"><div class="vcard"><b>DES 🔑</b>مفتاح واحد للطرفين</div><div class="vcard" style="animation-delay:.3s"><b>RSA 📬</b>قفل للجميع ومفتاح لصاحبه</div><div class="vcard" style="animation-delay:.6s"><b>ElGamal 🎨</b>خلط الألوان السري</div></div>`}
];
const VS_DES=[
 {t:'1) دفتر سرّي',c:'أنا وصديقي نملك دفتراً سرياً، ومع كل منا نسخة متطابقة من المفتاح. هذا هو DES: مفتاح واحد مشترك بيننا.',
  h:R(B('plain','👦 أنا')+B('key','🔑',.3)+B('key','🔑',.5)+B('net','👦 صديقي',.8))},
 {t:'2) زر الإضاءة 💡',c:'فكّر بزر الإضاءة: ضغطة واحدة تقلب الحالة من مطفأ إلى مضاء، وضغطة ثانية تعيدها كما كانت. هذه فكرة XOR.',
  h:R(B('net','💡 مطفأ')+A(.3)+B('key','👆 ضغطة',.5)+A(.8)+B('plain','💡 مضاء',1))+R(B('key','👆 ضغطة ثانية',1.5)+A(1.8)+B('net','💡 مطفأ من جديد',2))},
 {t:'3) الحرف أرقام',c:'الحاسوب يرى الحرف H على شكل أصفار وواحدات، والمفتاح يخبرنا أي رقم نقلبه: حيث المفتاح 1 نقلب الرقم، وحيث 0 نتركه.',
  h:F('  H : <em>0 1 0 0 1 0 0 0</em>',0)+F('KEY : <u>0 1 0 1 1 0 1 0</u>',.5)+F('OUT :  0 0 0 1 0 0 1 0',1)},
 {t:'4) نرسل المقلوب',c:'بعد القلب يصبح الحرف H هو 12، فنرسل 12 بدل H. ومن يراه لا يفهم شيئاً.',
  h:R(B('plain',"'H'")+A(.3)+B('key','🔑 نقلب',.5)+A(.8)+B('cipher','12',1))},
 {t:'5) نعيد القلب',c:'صديقي يملك نفس المفتاح، فيقلب الأرقام مرة ثانية كضغطة الزر الثانية، فيعود الحرف H.',
  h:R(B('cipher','12')+A(.3)+B('key','🔑 نقلب ثانية',.5)+A(.8)+B('plain',"'H' ✔",1))},
 {t:'6) المشكلة الوحيدة',c:'DES سريع وبسيط، لكن كيف نعطي صديقنا المفتاح دون أن يراه اللص؟ لهذا اخترعوا RSA وElGamal.',
  h:R(B('key','🔑 ➜ ❓')+B('net','🕵️ قد يراه',.4))+R(B('pub','الحل: RSA وElGamal',.9))}
];
const VS_RSA=[
 {t:'1) صندوق البريد',c:'تخيّل صندوق بريد له فتحة: يستطيع أي شخص أن يضع فيه رسالة، لكن صاحب الصندوق وحده بمفتاحه يفتحه ويقرأ الرسائل.',
  h:R(B('net','👥 الجميع')+A(.3)+B('pub','📬 فتحة عامة',.6)+A(.9)+B('priv','🔑 صاحبه فقط',1.2))},
 {t:'2) القفل المفتوح',c:'في RSA نوزّع قفلاً مفتوحاً على الجميع، وهو المفتاح العام. من يريد مراسلتي يغلق رسالته به، ولا يفتحها إلا مفتاحي الخاص السري.',
  h:R(B('pub','🔓 المفتاح العام<small>للجميع</small>')+B('priv','🔑 المفتاح الخاص<small>لي وحدي</small>',.4))},
 {t:'3) كيف نصنع القفل؟',c:'نضرب عددين صغيرين: 61 × 53 = 3233. معرفة الناتج سهلة، لكن معرفة أصله من 3233 صعبة إذا كانت الأعداد كبيرة جداً. هذا سر الأمان.',
  h:R(B('key','61 × 53')+A(.3)+B('plain','3233',.5))+R(B('net','3233 = ؟ × ؟',.9)+B('cipher','❌ صعب مع الأعداد الكبيرة',1.2))},
 {t:'4) نقفل الرسالة',c:'الحرف H رقمه 72. نرفعه للأس 17 (المفتاح العام) ثم نأخذ الباقي بعد القسمة على 3233، مثل باقي التفاح تماماً. فيصبح 3000.',
  h:R(B('plain',"'H' = 72")+A(.3)+B('pub','🔓 72^17 mod 3233',.5)+A(.8)+B('cipher','3000',1))},
 {t:'5) نفتح الصندوق',c:'صاحب المفتاح الخاص 2753 يرفع 3000 للأس 2753 ثم يأخذ الباقي على 3233، فيعود الرقم 72 أي الحرف H.',
  h:R(B('cipher','3000')+A(.3)+B('priv','🔑 3000^2753 mod 3233',.5)+A(.8)+B('plain',"72 = 'H' ✔",1))},
 {t:'6) الخلاصة',c:'الجميع يقفل بالمفتاح العام، وأنا وحدي أفتح بالمفتاح الخاص. ولا حاجة لإرسال أي سر عبر الشبكة.',
  h:R(B('pub','🔓 قفل للجميع')+B('priv','🔑 فتح لي وحدي',.4))+R(B('plain','✔ آمن وسهل',.9))}
];
const VS_ELG=[
 {t:'1) خلط الألوان 🎨',c:'إذا خلطت لونين من الدهان تحصل على لون جديد بسهولة، لكن يكاد يستحيل فصل اللونين الأصليين من الخليط. هذه فكرة ElGamal.',
  h:R(B('paint','🎨 أحمر')+B('paint','+ 🎨 أزرق',.3)+A(.6)+B('paint','🟣 بنفسجي',.9))+R(B('cipher','❌ فصلهما شبه مستحيل',1.4))},
 {t:'2) لوني السري',c:'أخلط لوني العام (العدد 2) مع لوني السري الذي لا يعرفه أحد (153)، فيخرج خليط أعلنه للجميع: هو المفتاح العام 224.',
  h:R(B('paint','🎨 لون عام = 2')+B('priv','🤫 لوني السري = 153',.3))+R(A(.6)+B('pub','المفتاح العام = 224',.8))},
 {t:'3) المرسل يخلط أيضاً',c:'المرسل يختار لوناً مؤقتاً (197) ويخلطه باللون العام فيحصل على 87 ويرسله. ثم يخلطه مع مفتاحي العام 224 فيحصل على سر مشترك هو 367.',
  h:R(B('paint','k = 197')+A(.3)+B('cipher','87 يُرسَل',.5))+R(B('key','السر المشترك = 367',1))},
 {t:'4) تغليف الحرف',c:'يأخذ الحرف H (الرقم 72) ويغلّفه بالسر: 72 × 367 ثم الباقي على 467 يساوي 272. فيرسل لي الرقمين (87 , 272).',
  h:R(B('plain',"'H' = 72")+A(.3)+B('key','× 367',.5)+A(.8)+B('cipher','272',1))+F('(87 , 272)',1.3)},
 {t:'5) أفتح الغلاف',c:'أخلط لوني السري 153 مع الرقم 87 فأحصل على السر نفسه 367. ثم أزيل الغلاف بقسمة 272 على السر، فيعود الرقم 72 أي الحرف H.',
  h:R(B('priv','🤫 153 + 87')+A(.3)+B('key','السر = 367 ✔',.5))+R(B('cipher','272')+A(1)+B('plain',"72 = 'H' ✔",1.2))},
 {t:'6) لماذا هو آمن؟',c:'اللص يرى الأرقام 224 و87 و272 فقط. ولكي يعرف السر يجب أن يفصل الألوان ليعرف 153 أو 197، وهذا شبه مستحيل مع الأرقام الكبيرة.',
  h:R(B('net','🕵️ يرى: 224 , 87 , 272')+A(.4)+B('cipher','❌ لا يعرف السر',.8))}
];
const VSIMPLE={general:VS_GEN,des:VS_DES,rsa:VS_RSA,elgamal:VS_ELG};
const VSETS={general:VGENERAL,des:VDES,rsa:VRSA,elgamal:VELG};
let vLevel='simple',vKey='general';
let VSCENES=VSIMPLE.general;
let vi=0,vt=0,vTimer=null,vPlaying=false,vDone=false,vInit=false;
function vTab(k){
  vKey=k;
  vPause();VSCENES=(vLevel==='simple'?VSIMPLE:VSETS)[k];vi=0;vt=0;vDone=false;
  document.querySelectorAll('.vtab').forEach(b=>b.classList.toggle('on',b.dataset.k===k));
  vRender();vFillBar();vSetBtn();vPlay();
}
function vLevelSet(l){
  vLevel=l;
  document.querySelectorAll('.vlvl').forEach(b=>b.classList.toggle('on',b.dataset.l===l));
  vTab(vKey);
}
function vSetBtn(){
  const b=document.getElementById('vPlay');
  b.innerHTML=vPlaying?'<i class="fa-solid fa-pause"></i> إيقاف مؤقت':(vDone?'<i class="fa-solid fa-rotate-right"></i> إعادة المشاهدة':'<i class="fa-solid fa-play"></i> تشغيل');
}
function vRender(){
  const s=VSCENES[vi];
  document.getElementById('vStage').innerHTML=`<div class="vtitle">${s.t}</div>`+s.h;
  document.getElementById('vCaption').textContent=s.c;
  document.getElementById('vCount').textContent=(vi+1)+' / '+VSCENES.length;
}
// ---- Arabic (Modern Standard) narration via the browser's built-in speech: no files, no downloads ----
let vVoiceOn=false;
function vDur(i){return Math.max(VDUR,VSCENES[i].c.length*(vVoiceOn?90:55));}
function vSpeakText(t){
  const map=[
    [/\^/g,' أُسّ '],[/\bmod\b/gi,' باقي القسمة على '],[/×/g,' ضرب '],[/÷/g,' قسمة على '],[/\+/g,' زائد '],[/−/g,' ناقص '],[/=/g,' يساوي '],
    [/→/g,' ثم '],[/XOR/g,' إكس أور '],[/RSA/g,' آر إس إيه '],[/DES/g,' دي إي إس '],[/ElGamal/g,' إل جمال '],
    [/ASCII/g,' أسكي '],[/Feistel/g,' فايستل '],[/Hello/g,' هيلو '],[/Symmetric|Asymmetric/g,' '],
    [/φ/g,' فاي '],[/⁻¹/g,' المقلوب '],[/\bk\b/g,' كيه '],[/\bc1\b/gi,' سي واحد '],[/\bc2\b/gi,' سي اثنان '],
    [/\bP\b/g,' بي '],[/\bQ\b/g,' كيو '],[/\bN\b/g,' إن '],[/\bG\b/g,' جي '],[/\bX\b/g,' إكس '],[/\bH\b/g,' إتش '],
    [/\bs\b/g,' إس '],[/\bd\b/g,' دي '],[/\be\b/g,' إي '],[/\bm\b/g,' إم '],[/\bn\b/g,' إن '],
    [/[\u{1F300}-\u{1FAFF}☀-➿✔⚠⚡➜]/gu,' '],[/[()\[\]{}|]/g,' '],[/\s+/g,' ']
  ];
  for(const [r,s] of map)t=t.replace(r,s);
  return t.trim();
}
// ---- Sound effects: synthesized live with Web Audio (no files, works offline, nothing runs until Play) ----
let vSfxOn=true,vCtx=null,vSfxGain=null;
function vStopSfx(){
  if(vSfxGain){try{vSfxGain.gain.cancelScheduledValues(0);vSfxGain.gain.value=0;vSfxGain.disconnect();}catch(e){}vSfxGain=null;}
}
function vNote(t0,f,d,type,vol,f2){
  const o=vCtx.createOscillator(),g=vCtx.createGain();
  o.type=type;o.frequency.setValueAtTime(f,t0);
  if(f2)o.frequency.exponentialRampToValueAtTime(f2,t0+d);
  g.gain.setValueAtTime(0.0001,t0);
  g.gain.exponentialRampToValueAtTime(Math.max(.0001,vol*vGain()),t0+.01);
  g.gain.exponentialRampToValueAtTime(0.0001,t0+d);
  o.connect(g);g.connect(vSfxGain);
  o.start(t0);o.stop(t0+d+.02);
}
function vSfx(){
  if(!vSfxOn)return;
  try{
    const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
    vCtx=vCtx||new AC();
    if(vCtx.state==='suspended')vCtx.resume();
    vStopSfx();
    vSfxGain=vCtx.createGain();
    vSfxGain.gain.value=vVoiceOn?.10:.2;
    vSfxGain.connect(vCtx.destination);
    const t=vCtx.currentTime+.03,h=VSCENES[vi].h;
    vNote(t,300,.18,'sine',.8,900); // scene whoosh
    let last=0,m;
    const re=/class="(vbox|varrow|vform|vcard)([^"]*)"(?: style="animation-delay:([\d.]+)s")?/g;
    while((m=re.exec(h))){
      const d=.2+parseFloat(m[3]||0),k=m[1],c=m[2],T=t+d;
      last=Math.max(last,d);
      if(k==='varrow')vNote(T,1300,.04,'square',.12);
      else if(k==='vform')vNote(T,480,.1,'triangle',.5);
      else if(k==='vcard')vNote(T,620,.1,'sine',.6);
      else if(/apple/.test(c))vNote(T,420,.12,'sine',.7,900);
      else if(/paint/.test(c))vNote(T,500,.18,'triangle',.5,330);
      else if(/cipher/.test(c))vNote(T,260,.14,'triangle',.7,170);
      else if(/key/.test(c)){vNote(T,880,.08,'sine',.6);vNote(T+.07,1175,.12,'sine',.6);}
      else if(/priv/.test(c))vNote(T,330,.12,'square',.25);
      else if(/pub/.test(c))vNote(T,740,.1,'sine',.6);
      else if(/net/.test(c))vNote(T,520,.1,'sine',.5);
      else vNote(T,660,.09,'sine',.6);
    }
    if(h.includes('✔'))[523,659,784,1047].forEach((f,i)=>vNote(t+last+.15+i*.09,f,.2,'sine',.7));
    if(h.includes('❌')||h.includes('🕵'))vNote(t+last+.1,150,.35,'sawtooth',.25,90);
  }catch(e){}
}
function vToggleSfx(){
  vSfxOn=!vSfxOn;
  document.getElementById('vSfx').innerHTML=vSfxOn?'<i class="fa-solid fa-music"></i> المؤثرات: تعمل':'<i class="fa-solid fa-bell-slash"></i> المؤثرات: متوقفة';
  if(!vSfxOn)vStopSfx();else if(vPlaying)vSfx();
}

// Online fallback: used only when the device has no Arabic voice (needs internet)
let vAudio=null,vToken=0,vOnlineWarned=false;
function vStopAudio(){vToken++;if(vAudio){try{vAudio.pause();}catch(e){}vAudio=null;}}
function vHasArabicVoice(){
  if(!('speechSynthesis' in window))return false;
  const vs=speechSynthesis.getVoices()||[];
  if(!vs.length)return true; // voices not loaded yet: let the browser decide
  return vs.some(x=>x.lang&&x.lang.toLowerCase().replace('_','-').startsWith('ar'));
}
function vChunk(t){
  const out=[];let cur='';
  for(const w of t.split(' ')){
    if((cur+' '+w).length>160){out.push(cur);cur=w;}else cur=cur?cur+' '+w:w;
  }
  if(cur)out.push(cur);return out;
}
function vSpeakOnline(text){
  vStopAudio();
  const tok=vToken,parts=vChunk(text);let i=0;
  const fail=()=>{if(tok!==vToken||vOnlineWarned)return;vOnlineWarned=true;showToast('تعذّر تشغيل الصوت عبر الإنترنت. تأكد من الاتصال أو ثبّت صوتاً عربياً على جهازك','fa-triangle-exclamation text-amber-400');};
  const next=()=>{
    if(tok!==vToken||i>=parts.length)return;
    const a=new Audio('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=ar&q='+encodeURIComponent(parts[i]));
    vAudio=a;
    a.onended=()=>{i++;next();};
    a.onerror=fail;
    const p=a.play();if(p&&p.catch)p.catch(fail);
  };
  next();
}
function vSpeak(){
  if(!vVoiceOn)return;
  const text=vSpeakText(VSCENES[vi].t.replace(/^\d+\)\s*/,'')+'. '+VSCENES[vi].c);
  try{
    if(vHasArabicVoice()){
      vStopAudio();
      speechSynthesis.cancel();
      const u=new SpeechSynthesisUtterance(text);
      u.lang='ar-SA';u.rate=.92;
      const v=(speechSynthesis.getVoices()||[]).find(x=>x.lang&&x.lang.toLowerCase().startsWith('ar'));
      if(v)u.voice=v;
      speechSynthesis.speak(u);
    }else{
      speechSynthesis.cancel();
      vSpeakOnline(text);
    }
  }catch(e){vSpeakOnline(text);}
}
function vToggleVoice(){
  vVoiceOn=!vVoiceOn;
  document.getElementById('vVoice').innerHTML=vVoiceOn?'<i class="fa-solid fa-volume-high"></i> الشرح الصوتي: يعمل':'<i class="fa-solid fa-volume-xmark"></i> الشرح الصوتي: متوقف';
  if(vVoiceOn){
    if(!vHasArabicVoice())showToast('سيتم تشغيل الصوت العربي عبر الإنترنت','fa-wifi text-sky-400');
    if(vPlaying)vSpeak();
    else showToast('اضغط تشغيل ليبدأ الشرح الصوتي','fa-circle-info text-sky-400');
  }else{
    vStopAudio();
    try{if('speechSynthesis' in window)speechSynthesis.cancel();}catch(e){}
  }
  vFillBar();
}
function vFillBar(){
  let tot=0,before=0;
  for(let i=0;i<VSCENES.length;i++){const d=vDur(i);tot+=d;if(i<vi)before+=d;}
  document.getElementById('vFill').style.width=Math.min(100,(before+vt)/tot*100)+'%';
}
function vTick(){
  vt+=100;
  if(vt>=vDur(vi)){
    vt=0;vi++;
    if(vi>=VSCENES.length){vi=VSCENES.length-1;vt=vDur(vi);vFillBar();vPause();vDone=true;vSetBtn();return;}
    vRender();vSpeak();vSfx();
  }
  vFillBar();
}
function vPlay(){if(vPlaying)return;vPlaying=true;vTimer=setInterval(vTick,100);vSetBtn();vSpeak();vSfx();}
function vPause(){vPlaying=false;clearInterval(vTimer);vTimer=null;vSetBtn();vStopAudio();vStopSfx();try{if('speechSynthesis' in window)speechSynthesis.cancel();}catch(e){}}
function vToggle(){if(vPlaying){vPause();}else if(vDone){vRestart();}else{vPlay();}}
function vRestart(){vPause();vi=0;vt=0;vDone=false;vRender();vFillBar();vPlay();}
function toggleVideo(){
  const body=document.getElementById('vidBody');
  body.classList.toggle('hidden');
  document.getElementById('vidChevron').classList.toggle('rotate-180');
  if(body.classList.contains('hidden')){vPause();}
  else if(!vInit){vInit=true;vRender();vSetBtn();}
}
document.addEventListener('visibilitychange',()=>{if(document.hidden&&vPlaying)vPause();});

function hTab(k){
  document.querySelectorAll('.htab').forEach(b=>b.classList.toggle('on',b.dataset.h===k));
  document.querySelectorAll('.hpanel').forEach(p=>p.classList.toggle('on',p.id==='h-'+k));
}

function bTab(k){
  document.querySelectorAll('.btab').forEach(b=>b.classList.toggle('on',b.dataset.b===k));
  document.querySelectorAll('.bpanel').forEach(p=>p.classList.toggle('on',p.id==='b-'+k));
}
function sgH(t){let h=7;for(const c of t)h=(h*31+c.codePointAt(0))%3233;return h||1}
function sgPow(b,e,m){let r=1;b%=m;while(e>0){if(e&1)r=r*b%m;b=b*b%m;e>>=1}return r}
let sgSig=null;
function sgSign(){
  const h=sgH(document.getElementById('sgMsg').value);
  sgSig=sgPow(h,2753,3233);
  document.getElementById('sgOut').textContent='1) البصمة: hash = '+h+'\n2) التوقيع بالمفتاح الخاص: s = '+h+'^2753 mod 3233 = '+sgSig+'\n✔ تم التوقيع. غيّر الرسالة الآن ثم اضغط «تحقق».';
}
function sgVerify(){
  const o=document.getElementById('sgOut');
  if(sgSig===null){o.textContent='وقّع الرسالة أولاً.';return}
  const h=sgH(document.getElementById('sgMsg').value),back=sgPow(sgSig,17,3233),ok=h===back;
  o.textContent='1) بصمة الرسالة الحالية = '+h+'\n2) فك التوقيع بالمفتاح العام: '+sgSig+'^17 mod 3233 = '+back+'\n'+(ok?'✔ البصمتان متطابقتان: التوقيع صحيح والرسالة لم تتغير.':'❌ البصمتان مختلفتان: الرسالة تغيّرت أو التوقيع مزوّر.');
  o.style.color=ok?'#34f5b8':'#fca5a5';
}

(function(){
  if(!('IntersectionObserver' in window))return;
  const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('paused',!e.isIntersecting)));
  document.querySelectorAll('.anim').forEach(a=>io.observe(a));
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  const rv=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rv.unobserve(e.target);}}),{threshold:.05});
  document.querySelectorAll('section .card').forEach(c=>{c.classList.add('rv');rv.observe(c);});
})();

// ---------- Lightweight effects ----------
// Result "decode" effect: random symbols resolve into the real output (~0.5s, then stops)
function scrambleTo(el,final){
  const box=el;
  box.classList.remove('pop');void box.offsetWidth;box.classList.add('pop');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches||final.length>400||!final.length){box.innerText=final;return;}
  const token=(box._sc=(box._sc||0)+1),chars='01#$%&@*+=?',len=final.length,total=14;
  let f=0;
  (function step(){
    if(box._sc!==token)return;
    f++;
    if(f>=total){box.innerText=final;return;}
    const reveal=Math.floor(len*f/total);let s='';
    for(let i=0;i<len;i++){const c=final[i];s+=(i<reveal||c===' '||c==='\n')?c:chars[(Math.random()*chars.length)|0];}
    box.innerText=s;
    setTimeout(step,40);
  })();
}
// Binary rain: a handful of CSS-animated columns built once, paused when the tab is hidden
(function(){
  const rain=document.getElementById('rain');
  if(!rain||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  const weak=(navigator.hardwareConcurrency||4)<=2;
  const n=weak?5:(innerWidth<640?5:10);
  for(let i=0;i<n;i++){
    const c=document.createElement('div');c.className='rc';
    let t='';for(let j=0;j<24;j++)t+=(Math.random()<.5?'0':'1')+'\n';
    c.textContent=t.trim();
    c.style.left=(4+i*(92/n)+Math.random()*4)+'%';
    c.style.setProperty('--rd',(12+Math.random()*10).toFixed(1)+'s');
    c.style.setProperty('--rl','-'+(Math.random()*14).toFixed(1)+'s');
    rain.appendChild(c);
  }
  document.addEventListener('visibilitychange',()=>rain.classList.toggle('paused',document.hidden));
})();

// RK-TEAM intro: tap the logo -> electronic gateway FX + deep male documentary voice "Made by RK Team"
(function(){
  const el=document.getElementById('rkIntro');if(!el)return;
  let seen=false;try{seen=sessionStorage.getItem('rkSeen')==='1';}catch(e){}
  if(seen){el.remove();return;}

  let cfg={snd:1,vol:50};try{Object.assign(cfg,JSON.parse(localStorage.getItem('rk_set')||'{}'));}catch(e){}
  const vol=Math.max(.3,Math.min(1,.35+(+cfg.vol||50)*.0065));
  const ss=window.speechSynthesis,canSay=!!(ss&&window.SpeechSynthesisUtterance&&cfg.snd);
  const sub=el.querySelector('.rk-sub'),hint=el.querySelector('.rk-hint');
  let started=false,finished=false,closed=false,fx=null;

  /* ---------- sound design (WebAudio, no files needed) ---------- */
  function makeFx(){
    const AC=window.AudioContext||window.webkitAudioContext;if(!AC||!cfg.snd)return null;
    const c=new AC();if(c.state==='suspended')c.resume();
    const out=c.createGain();out.gain.value=vol*.95;
    const comp=c.createDynamicsCompressor();comp.threshold.value=-16;comp.ratio.value=4;
    out.connect(comp);comp.connect(c.destination);
    // cinematic reverb (generated impulse)
    const len=Math.floor(c.sampleRate*2.6),ir=c.createBuffer(2,len,c.sampleRate);
    for(let ch=0;ch<2;ch++){const d=ir.getChannelData(ch);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2.4);}
    const rev=c.createConvolver();rev.buffer=ir;const revG=c.createGain();revG.gain.value=.5;rev.connect(revG);revG.connect(out);
    const bus=c.createGain();bus.connect(out);bus.connect(rev);
    const nb=c.createBuffer(1,c.sampleRate*3,c.sampleRate);{const d=nb.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;}
    const now=()=>c.currentTime;
    const env=(g,t,a,peak,d)=>{g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(peak,t+a);g.gain.exponentialRampToValueAtTime(.0001,t+a+d);};
    function osc(type,f1,f2,t,dur,peak,a,dest){
      const o=c.createOscillator(),g=c.createGain();a=a||.01;o.type=type;
      o.frequency.setValueAtTime(f1,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+dur);
      env(g,t,a,peak,Math.max(.02,dur-a));o.connect(g);g.connect(dest||bus);o.start(t);o.stop(t+dur+.1);return o;}
    function noise(t,dur,type,f1,f2,peak,a,q){
      const s=c.createBufferSource();s.buffer=nb;const f=c.createBiquadFilter();f.type=type;f.Q.value=q||1.5;
      f.frequency.setValueAtTime(f1,t);f.frequency.exponentialRampToValueAtTime(f2,t+dur);
      const g=c.createGain();a=a||.01;env(g,t,a,peak,Math.max(.02,dur-a));
      s.connect(f);f.connect(g);g.connect(bus);s.start(t);s.stop(t+dur+.1);}
    function boom(t,k){osc('sine',95,30,t,1.8,.95*k,.005);osc('sine',48,24,t,2.2,.6*k,.01);noise(t,.8,'lowpass',1200,80,.5*k,.003);}
    let hum=null;
    function startHum(t){
      const g=c.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.2,t+1.6);
      const lp=c.createBiquadFilter();lp.type='lowpass';lp.Q.value=4;lp.frequency.setValueAtTime(220,t);lp.frequency.exponentialRampToValueAtTime(1100,t+3.2);
      lp.connect(g);g.connect(bus);
      const os=[[55,'sawtooth'],[55.45,'sawtooth'],[82.4,'sawtooth'],[110.3,'triangle']].map(p=>{const o=c.createOscillator();o.type=p[1];o.frequency.value=p[0];const og=c.createGain();og.gain.value=p[1]==='triangle'?.5:.7;o.connect(og);og.connect(lp);o.start(t);return o;});
      // airy shimmer with slow tremolo
      const sg=c.createGain();sg.gain.value=.0001;sg.gain.exponentialRampToValueAtTime(.05,t+2);sg.connect(bus);
      const lfo=c.createOscillator(),lg=c.createGain();lfo.frequency.value=5.5;lg.gain.value=.02;lfo.connect(lg);lg.connect(sg.gain);lfo.start(t);
      const sh=[523.25,784,1046.5].map(f=>{const o=c.createOscillator();o.type='sine';o.frequency.value=f;o.connect(sg);o.start(t);return o;});
      hum={g,sg,all:os.concat(sh,[lfo])};
    }
    return{
      start(){
        const t=now()+.05;
        boom(t,1);
        // power-up riser
        noise(t,1.5,'bandpass',200,7000,.4,1.3,3);
        osc('sawtooth',60,1000,t,1.5,.12,1.35);
        // digital "access" arpeggio
        [262,392,523,784,1046,1568].forEach((f,i)=>osc('square',f,0,t+.6+i*.085,.16,.055,.005));
        // gate unlock clunk + metallic latch
        osc('square',130,55,t+1.3,.3,.22,.003);
        noise(t+1.3,.12,'highpass',3000,9000,.25,.002);
        osc('sine',1760,1740,t+1.32,1.2,.05,.004);
        startHum(t+.9);
      },
      accent(){ // impact on the brand name
        const t=now()+.02;
        boom(t,.7);
        noise(t,.5,'bandpass',900,6000,.22,.02,2);
        [[1318,.07],[1976,.05],[2637,.04]].forEach(p=>osc('sine',p[0],0,t+.02,1.4,p[1],.004));
      },
      outro(){
        const t=now()+.02;
        boom(t,.6);
        noise(t,1.1,'bandpass',5000,250,.3,.02,2);
        [[880,.14],[2428,.07],[4752,.04],[1320,.08]].forEach(p=>osc('sine',p[0],0,t+.03,3,p[1],.004));
        if(hum){const e=now();hum.g.gain.cancelScheduledValues(e);hum.g.gain.setValueAtTime(Math.max(hum.g.gain.value,.0001),e);hum.g.gain.exponentialRampToValueAtTime(.0001,e+1.8);
          hum.sg.gain.cancelScheduledValues(e);hum.sg.gain.setValueAtTime(Math.max(hum.sg.gain.value,.0001),e);hum.sg.gain.exponentialRampToValueAtTime(.0001,e+1.2);
          hum.all.forEach(o=>{try{o.stop(e+2)}catch(x){}});}
      },
      stop(){try{out.gain.cancelScheduledValues(now());out.gain.setTargetAtTime(0,now(),.15);setTimeout(()=>{try{c.close()}catch(e){}},900);}catch(e){}}
    };
  }

  /* ---------- lively professional voice ---------- */
  function pickVoice(){
    const v=(ss.getVoices()||[]).filter(x=>/^en/i.test(x.lang));
    const fem=/female|zira|samantha|aria|jenny|susan|hazel|karen|moira|tessa|fiona|victoria|allison|ava\b|serena|kate|catherine|libby|sonia|emma|michelle|natasha|clara|heera|linda|siri|nicky|joanna|salli|kendra|ana\b|sara/i;
    const male=/guy|ryan|christopher|eric|davis|andrew|brian|roger|steffan|thomas|william|mark|david|daniel|alex\b|aaron|arthur|oliver|gordon|rishi|fred|james|george|richard|matthew|male/i;
    const good=/natural|neural|premium|enhanced|online/i;
    // 1) neural / natural male voices (Edge, Windows 11, Chrome, iOS enhanced)
    let f=v.find(x=>good.test(x.name)&&male.test(x.name)&&!fem.test(x.name));if(f)return f;
    // 2) known good male voices
    const pref=[/google uk english male/i,/microsoft (guy|ryan|christopher|eric|davis|andrew|brian)/i,/daniel/i,/aaron/i,/alex\b/i,/arthur/i,/oliver/i,/gordon/i,/rishi/i,/\bmale\b/i,/david|mark\b/i];
    for(const re of pref){f=v.find(x=>re.test(x.name)&&!fem.test(x.name));if(f)return f;}
    return v.find(x=>male.test(x.name)&&!fem.test(x.name))||v.find(x=>!fem.test(x.name))||v[0]||null;
  }
  let vfile=null;
  function preloadFile(){ // optional pro recording: put rk-voice.mp3 next to this html and it is used automatically
    try{const a=new Audio('rk-voice.mp3');a.preload='auto';a.oncanplaythrough=()=>{a._ok=1};a.onerror=()=>{a._bad=1};vfile=a;}catch(e){}
  }
  function speak(){
    if(vfile&&vfile._ok){
      try{vfile.volume=Math.min(1,.6+(+cfg.vol||50)*.004);vfile.onended=finish;
        const pr=vfile.play();if(fx)fx.accent();
        if(pr&&pr.catch)pr.catch(()=>speakTTS());
        setTimeout(finish,9000);return;}catch(e){}
    }
    speakTTS();
  }
  function speakTTS(){
    if(!canSay){return finish();}
    try{
      ss.cancel();
      const v=pickVoice(),vl=Math.min(1,.6+(+cfg.vol||50)*.004);
      const mk=(t,rate,pitch)=>{const u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=rate;u.pitch=pitch;u.volume=vl;if(v){u.voice=v;u.lang=v.lang;}return u;};
      const u1=mk('Made by',1.0,.85);              // calm lead-in
      const u2=mk('R. K. Team!',.92,1.0);          // punchy brand name
      u2.onstart=()=>{if(fx)fx.accent();};
      u2.onend=finish;u1.onerror=u2.onerror=finish;
      ss.speak(u1);ss.speak(u2);
    }catch(e){finish();}
    setTimeout(finish,7500); // safety: some devices never fire onend
  }

  /* ---------- flow ---------- */
  function close(){
    if(closed)return;closed=true;
    el.classList.add('out');
    try{sessionStorage.setItem('rkSeen','1');}catch(e){}
    try{ss&&ss.cancel();}catch(e){}
    if(fx)setTimeout(()=>fx.stop(),1200);
    setTimeout(()=>el.remove(),800);
  }
  function finish(){
    if(finished)return;finished=true;
    if(fx)fx.outro();
    setTimeout(close,fx?1500:600);
  }
  function begin(){
    if(started){ if(!closed){close();} return; } // second tap = skip
    started=true;
    el.classList.add('rk-go');
    if(sub)sub.textContent='ACCESS GRANTED';
    if(hint)hint.textContent='MADE BY RK TEAM';
    try{fx=makeFx();if(fx)fx.start();}catch(e){fx=null;}
    preloadFile();
    if(canSay){
      // iOS/Safari: unlock speech inside the tap gesture
      try{const u0=new SpeechSynthesisUtterance(' ');u0.volume=0;ss.speak(u0);}catch(e){}
      setTimeout(speak,1650);
    }else setTimeout(finish,fx?3400:1200);
  }
  el.addEventListener('click',begin);
  document.addEventListener('keydown',e=>{if(!started)begin();},{once:true});
  if(canSay&&ss.getVoices().length===0&&ss.addEventListener)ss.addEventListener('voiceschanged',()=>{},{once:true});
  setTimeout(()=>{if(!started)begin();},60000); // idle: nothing happens until tap (sound needs a tap)
})();


// ===== Network status (speed / latency / state) =====
(function(){
  const $=id=>document.getElementById(id);
  const bar=$('netBar');if(!bar)return;
  const st=$('nbSt'),stT=$('nbStT'),sp=$('nbSp'),spT=$('nbSpT'),pg=$('nbPg'),pgT=$('nbPgT'),ty=$('nbTy'),tyT=$('nbTyT');
  const SMALL='https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css';
  const BIG='https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
  const setC=(el,c)=>{el.classList.remove('ok','mid','bad','busy');if(c)el.classList.add(c);};
  let busy=false,lastSpeed=null,lastPing=null;
  const tmo=(ms)=>{const c=new AbortController();setTimeout(()=>c.abort(),ms);return c.signal;};

  async function ping(){
    let best=1e9;
    for(let i=0;i<3;i++){
      const t=performance.now();
      try{await fetch(SMALL+'?_='+Date.now()+i,{cache:'no-store',signal:tmo(5000)});best=Math.min(best,performance.now()-t);}catch(e){}
    }
    return best<1e9?best:null;
  }
  async function speed(){
    const t=performance.now();
    const r=await fetch(BIG+'?_='+Date.now(),{cache:'no-store',signal:tmo(15000)});
    const b=await r.blob();const s=(performance.now()-t)/1000;
    return b.size*8/Math.max(s,.05)/1e6;
  }
  function showPing(p){
    lastPing=p;
    if(p==null){pgT.textContent='—';setC(pg,'');return;}
    pgT.textContent=Math.round(p)+' ms';
    setC(pg,p<100?'ok':p<250?'mid':'bad');
  }
  function showSpeed(v){
    lastSpeed=v;
    if(v==null){spT.textContent='—';setC(sp,'');return;}
    spT.textContent=(v>=10?v.toFixed(0):v.toFixed(1))+' Mbps';
    setC(sp,v>=5?'ok':v>=1.5?'mid':'bad');
  }
  function verdict(){
    if(!navigator.onLine||(lastPing==null&&lastSpeed==null)){stT.textContent='غير متصل بالإنترنت';setC(st,'bad');return;}
    const v=lastSpeed,p=lastPing;
    if(v!=null&&v>=20&&(p==null||p<120)){stT.textContent='متصل · ممتاز';setC(st,'ok');}
    else if(v!=null&&v>=5&&(p==null||p<250)){stT.textContent='متصل · جيد';setC(st,'ok');}
    else if(v==null||v>=1.5){stT.textContent='متصل · متوسط';setC(st,'mid');}
    else{stT.textContent='متصل · ضعيف';setC(st,'bad');}
  }
  function netType(){
    const c=navigator.connection||navigator.mozConnection||navigator.webkitConnection;
    if(!c){ty.style.display='none';return;}
    let t='';
    if(c.type==='wifi')t='Wi-Fi';else if(c.type==='cellular')t='خلوي';else if(c.type==='ethernet')t='سلكي';
    if(c.effectiveType)t=(t?t+' · ':'')+c.effectiveType.toUpperCase().replace('SLOW-2G','2G');
    if(c.saveData)t+=' · توفير';
    if(!t){ty.style.display='none';return;}
    tyT.textContent=t;ty.style.display='';
    setC(ty,/4G/.test(t)?'ok':/3G/.test(t)?'mid':/2G/.test(t)?'bad':'');
  }
  async function run(full){
    if(busy)return;busy=true;
    netType();
    if(!navigator.onLine){showPing(null);showSpeed(null);verdict();busy=false;return;}
    if(full){setC(st,'busy');stT.textContent='جارٍ القياس…';}
    try{
      showPing(await ping());
      if(full){try{showSpeed(await speed());}catch(e){showSpeed(null);}}
    }catch(e){}
    verdict();busy=false;
  }
  bar.addEventListener('click',()=>run(true));
  window.addEventListener('online',()=>run(true));
  window.addEventListener('offline',()=>{showPing(null);showSpeed(null);verdict();});
  const c=navigator.connection;if(c&&c.addEventListener)c.addEventListener('change',()=>{netType();run(true);});
  setInterval(()=>{if(!document.hidden)run(false);},20000);   // light: latency only
  setInterval(()=>{if(!document.hidden)run(true);},120000);   // full speed re-test
  run(true);
})();

window.onload=toggleKeyInputs;
</script>
<script>
(function(){
const gcd=(a,b)=>{while(b){[a,b]=[b,a%b]}return a};
const mod=(n,m)=>((n%m)+m)%m;
const up=t=>t.toUpperCase().replace(/[^A-Z]/g,'');
const N=c=>c.charCodeAt(0)-65, Ch=n=>String.fromCharCode(65+mod(n,26));
const inv26=d=>{d=mod(d,26);for(let i=1;i<26;i++)if(d*i%26===1)return i;return 0};
const nums=s=>(s.match(/\d+/g)||[]).map(Number);
const CIPH={
caesar:(t,k,d)=>{const s=(parseInt(k)||0)*(d?-1:1);return[...up(t)].map(c=>Ch(N(c)+s)).join('')},
rand:(t,k,d)=>{k=up(k);if(k.length!==26||new Set(k).size!==26)throw'المفتاح يجب أن يكون 26 حرفاً مختلفاً';
 return[...up(t)].map(c=>d?Ch(k.indexOf(c)):k[N(c)]).join('')},
trans:(t,k,d)=>{const key=nums(k),n=key.length;if(n<2||[...key].sort((a,b)=>a-b).some((v,i)=>v!==i+1))throw'اكتب ترتيب الأعمدة مثل 2,4,1,3';
 let s=up(t);while(s.length%n)s+='X';const r=s.length/n;
 if(!d){let o='';for(const c of key)for(let i=0;i<r;i++)o+=s[i*n+c-1];return o}
 const g=Array(s.length);let p=0;for(const c of key)for(let i=0;i<r;i++)g[i*n+c-1]=s[p++];return g.join('')},
poly:(t,k,d)=>{const a=nums(k);if(!a.length)throw'اكتب الإزاحات مثل 1,2,3';return[...up(t)].map((c,i)=>Ch(N(c)+a[i%a.length]*(d?-1:1))).join('')},
vig:(t,k,d)=>{k=up(k);if(!k)throw'اكتب كلمة المفتاح';return[...up(t)].map((c,i)=>Ch(N(c)+N(k[i%k.length])*(d?-1:1))).join('')},
mat:(t,k,d)=>{let [a,b,c,e]=nums(k);if([a,b,c,e].some(v=>v===undefined))throw'اكتب 4 أعداد: a,b,c,d';
 let det=mod(a*e-b*c,26),iv=inv26(det);if(!iv||gcd(det,26)!==1)throw'المصفوفة غير قابلة للانعكاس mod 26 (المحدد='+det+')';
 let K=[[a,b],[c,e]];if(d)K=[[e*iv,-b*iv],[-c*iv,a*iv]];
 let s=up(t);if(s.length%2)s+='X';let o='';for(let i=0;i<s.length;i+=2){const x=N(s[i]),y=N(s[i+1]);o+=Ch(K[0][0]*x+K[0][1]*y)+Ch(K[1][0]*x+K[1][1]*y)}return o},
otp:(t,k,d)=>{const key=k.replace(/\D/g,'');
 if(!d){const dg=[...up(t)].map(c=>String(N(c)+1).padStart(2,'0')).join('');if(key.length<dg.length)throw'المفتاح أقصر من النص (يحتاج '+dg.length+' رقماً)';
  return[...dg].map((x,i)=>(+x+ +key[i])%10).join('')}
 const dg=t.replace(/\D/g,'');if(key.length<dg.length)throw'المفتاح أقصر من النص المشفر';
 const p=[...dg].map((x,i)=>mod(+x- +key[i],10)).join('');let o='';for(let i=0;i<p.length;i+=2)o+=Ch(+p.slice(i,i+2)-1);return o}
};
const euclid=(a,b)=>{const st=[];let x=a,y=b;while(y){st.push(`${x} = ${Math.floor(x/y)}×${y} + ${x%y}`);[x,y]=[y,x%y]}return{g:x,st}};
const phi=n=>{let r=n,m=n;for(let p=2;p*p<=m;p++)if(m%p===0){while(m%p===0)m/=p;r-=r/p}if(m>1)r-=r/m;return r};
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const R=document.documentElement;let S={t:'',fs:100,ff:'Tajawal',snd:1,mot:1,vol:50};
try{Object.assign(S,JSON.parse(localStorage.getItem('rk_set')||'{}'))}catch(e){}
if(matchMedia('(prefers-reduced-motion:reduce)').matches&&!localStorage.getItem('rk_set'))S.mot=0;
const save=()=>{try{localStorage.setItem('rk_set',JSON.stringify(S))}catch(e){}};
let ac;const snd=(f=560,d=.07,ty='sine')=>{if(!S.snd)return;try{ac=ac||new(window.AudioContext||window.webkitAudioContext)();const o=ac.createOscillator(),g=ac.createGain();o.type=ty;o.frequency.value=f;g.gain.value=.05*(S.vol/50);o.connect(g);g.connect(ac.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+d);o.stop(ac.currentTime+d)}catch(e){}};
const ok=()=>{snd(660,.09);setTimeout(()=>snd(880,.12),90)};
const fonts={};const loadF=n=>{if(n==='Tajawal'||fonts[n])return;fonts[n]=1;const l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family='+n.replace(/ /g,'+')+':wght@400;700;800&display=swap';document.head.appendChild(l)};
function apply(){
 if(S.t)R.dataset.t=S.t;else delete R.dataset.t;
 R.style.setProperty('--fs',S.fs/100);loadF(S.ff);R.style.setProperty('--ff',"'"+S.ff+"'");
 R.classList.toggle('noanim',!S.mot);
 $$('#stCol button').forEach(b=>b.classList.toggle('on',b.dataset.t===S.t));
 $('#fsr').value=S.fs;$('#vlr').value=S.vol;$('#ffs').value=S.ff;$('#tsnd').classList.toggle('on',!!S.snd);$('#tmot').classList.toggle('on',!!S.mot);
 const m=document.querySelector('meta[name=theme-color]');if(m)m.content={green:'#02120a',red:'#140404',blue:'#020b1a',black:'#000',white:'#fff'}[S.t]||'#050816';
 save()}
$('#stBtn').onclick=()=>{const p=$('#stPan');p.classList.toggle('on');$('#stBtn').setAttribute('aria-expanded',p.classList.contains('on'))};
document.addEventListener('click',e=>{if(!e.target.closest('#stPan,#stBtn'))$('#stPan').classList.remove('on')});
$('#stCol').onclick=e=>{const b=e.target.closest('button');if(b){S.t=b.dataset.t;apply()}};
$('#fsr').oninput=e=>{S.fs=+e.target.value;apply()};
$('#fsm').onclick=()=>{S.fs=Math.max(80,S.fs-5);apply()};$('#fsp').onclick=()=>{S.fs=Math.min(150,S.fs+5);apply()};
$('#ffs').onchange=e=>{S.ff=e.target.value;apply()};
$('#vlr').oninput=e=>{S.vol=+e.target.value;apply();snd(700,.08)};$('#vlm').onclick=()=>{S.vol=Math.max(0,S.vol-10);apply();snd(700,.08)};$('#vlp').onclick=()=>{S.vol=Math.min(100,S.vol+10);apply();snd(700,.08)};
$('#tsnd').onclick=()=>{S.snd=+!S.snd;apply();snd()};$('#tmot').onclick=()=>{S.mot=+!S.mot;apply()};
$('#trst').onclick=()=>{S={t:'',fs:100,ff:'Tajawal',snd:1,mot:1,vol:50};apply()};
document.addEventListener('click',e=>{if(e.target.closest('.btn,summary,.tg,.sw button'))snd(520,.05)},true);
/* mini animated icons (light inline SVG, CSS-only) */
const T=(c,x,y,t,cl='')=>`<text x="${x}" y="${y}" font-size="13" font-weight="800" fill="${c}" text-anchor="middle" class="${cl}">${t}</text>`;
const ICO={
bits:'<g>'+[0,1,2,3].map(i=>`<rect x="${4+i*10}" y="16" width="8" height="16" rx="2" fill="#22d3ee" class="b d${i}"/>`).join('')+'</g>',
prime:[[14,16],[34,14],[24,34],[10,36],[38,36]].map((p,i)=>`<circle cx="${p[0]}" cy="${p[1]}" r="6" fill="#7c5cff" class="z d${i%4}"/>`).join(''),
div:T('#fde68a',24,22,'÷','s')+T('#22d3ee',24,40,'gcd'),
phi:T('#f9a8d4',24,32,'φ','z').replace('font-size="13"','font-size="30"'),
mat:[0,1,2,3].map(i=>`<rect x="${8+(i%2)*18}" y="${8+(i>>1)*18}" width="14" height="14" rx="3" fill="#10b981" class="b d${i}"/>`).join(''),
wave:'<path d="M2 24 Q12 4 24 24 T46 24" fill="none" stroke="#22d3ee" stroke-width="3" class="d"/>',
poly:T('#a78bfa',24,30,'xⁿ','z'),
dice:'<g class="r"><rect x="10" y="10" width="28" height="28" rx="6" fill="#fde68a"/><circle cx="18" cy="18" r="3"/><circle cx="30" cy="30" r="3"/><circle cx="24" cy="24" r="3"/></g>',
gate:'<path d="M8 10h14a14 14 0 0 1 0 28H8z" fill="none" stroke="#34f5b8" stroke-width="3"/><path d="M2 18h6M2 30h6M36 24h10" stroke="#22d3ee" stroke-width="3" class="d"/>',
caesar:T('#fde68a',24,20,'A→D','s')+T('#22d3ee',24,40,'+3'),
cols:'<rect x="6" y="8" width="10" height="32" rx="3" fill="#7c5cff" class="s"/><rect x="19" y="8" width="10" height="32" rx="3" fill="#22d3ee"/><rect x="32" y="8" width="10" height="32" rx="3" fill="#f9a8d4" class="s d2"/>',
poly3:[['#7c5cff',10],['#22d3ee',22],['#f9a8d4',34]].map((c,i)=>`<rect x="6" y="${c[1]}" width="30" height="8" rx="4" fill="${c[0]}" class="s d${i}"/>`).join(''),
otp:'<g font-size="13" font-weight="800" fill="#34f5b8" text-anchor="middle"><text x="12" y="22" class="b">7</text><text x="24" y="22" class="b d1">3</text><text x="36" y="22" class="b d2">9</text><text x="12" y="40" class="b d3">1</text><text x="24" y="40" class="b">5</text><text x="36" y="40" class="b d1">0</text></g>'};
$$('.mi').forEach(el=>{const s=document.createElementNS('http://www.w3.org/2000/svg','svg');s.setAttribute('viewBox','0 0 48 48');s.setAttribute('class','mi');s.setAttribute('aria-hidden','true');s.innerHTML=ICO[el.dataset.i]||'';el.replaceWith(s)});
/* tabs */
$$('.kxt').forEach(b=>b.onclick=()=>{$$('.kxt').forEach(x=>x.classList.toggle('on',x===b));$$('.kxp').forEach(p=>p.classList.toggle('on',p.id==='k-'+b.dataset.k))});
/* ch2 task */
$('#xgo').onclick=()=>{const a=Math.abs(+$('#xa').value),b=Math.abs(+$('#xb').value);if(!a||!b||a>1e9||b>1e9){$('#xout').textContent='أدخل عددين صحيحين موجبين.';return}
 const [x,y]=a>=b?[a,b]:[b,a],e=euclid(x,y);$('#xout').textContent=e.st.join('\n')+`\ngcd = ${e.g}\nlcm = ${x*y/e.g}\nφ(${a}) = ${phi(a)}\n${a} mod ${b} = ${a%b}`;ok()};
/* ch3 lab */
const EX={caesar:['HELP','2'],rand:['CAT','QWERTYUIOPASDFGHJKLZXCVBNM'],trans:['MEETATDAWN','2,4,1,3'],poly:['CRYPTOSYSTEM','1,2,3'],vig:['HELLO','KEY'],mat:['HELP','3,3,2,5'],otp:['HELPME','']};
const HT={caesar:'المفتاح: مقدار الإزاحة (رقم).',rand:'المفتاح: 26 حرفاً مختلفاً (الأبجدية العشوائية).',trans:'المفتاح: ترتيب الأعمدة، مثل 2,4,1,3',poly:'المفتاح: الإزاحات بالتناوب، مثل 1,2,3',vig:'المفتاح: كلمة، مثل KEY',mat:'المفتاح: a,b,c,d لمصفوفة [[a,b],[c,d]] مثل 3,3,2,5',otp:'المفتاح: أرقام عشوائية (اتركه فارغاً ليُولَّد تلقائياً عند التشفير).'};
const rd=n=>Array.from(crypto.getRandomValues(new Uint8Array(n)),v=>v%10).join('');
const upd=()=>{$('#ch').textContent=HT[$('#cm').value]};$('#cm').onchange=()=>{$('#ct').value='';$('#ck').value='';$('#cout').textContent='النتيجة تظهر هنا.';upd()};upd();
function run(d){const m=$('#cm').value;try{let k=$('#ck').value;if(m==='otp'&&!d&&!k.trim()){k=rd(up($('#ct').value).length*2);$('#ck').value=k}
 const r=CIPH[m]($('#ct').value,k,d);$('#cout').textContent=r||'—';ok()}catch(e){$('#cout').textContent='⚠️ '+(typeof e==='string'?e:'تحقق من المدخلات');snd(200,.15,'square')}}
$('#cenc').onclick=()=>run(0);$('#cdec').onclick=()=>run(1);
$('#cex').onclick=()=>{const m=$('#cm').value,e=EX[m];$('#ct').value=e[0];$('#ck').value=e[1]||'';run(0)};
apply();
})();
</script>
<script>
/* ===== additions: sound, figures, tools, history wheel ===== */
const FIGS={"f11": "data:image/jpeg;base64,", "f24": "data:image/jpeg;base64,", "f25": "data:image/jpeg;base64,", "f33": "data:image/jpeg;base64,", "f34": "data:image/jpeg;base64,", "f35": "data:image/jpeg;base64,", "f36": "data:image/jpeg;base64,"};
function rkS(){try{return JSON.parse(localStorage.getItem('rk_set')||'{}')}catch(e){return{}}}
function vGain(){const s=rkS();return s.snd===0?0:(s.vol??50)/50}
let _ac;function tone(f,d=.1,ty='sine',g=.06,t0=0,f2){const s=rkS();if(s.snd===0)return;try{_ac=_ac||new(window.AudioContext||window.webkitAudioContext)();const o=_ac.createOscillator(),k=_ac.createGain(),t=_ac.currentTime+t0,v=Math.max(.0001,g*(s.vol??50)/50);
 o.type=ty;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);k.gain.setValueAtTime(.0001,t);k.gain.exponentialRampToValueAtTime(v,t+.015);k.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(k);k.connect(_ac.destination);o.start(t);o.stop(t+d+.02)}catch(e){}}
const fxOk=()=>{tone(660,.1);tone(880,.14,'sine',.06,.09);tone(1175,.16,'triangle',.04,.2)};
const fxErr=()=>tone(180,.2,'square',.04,0,120);
const fxSwipe=()=>tone(220,.5,'sawtooth',.025,0,1100);
const noAnim=()=>document.documentElement.classList.contains('noanim');
function pop(el){if(!el)return;el.classList.remove('pop');void el.offsetWidth;el.classList.add('pop')}
function burst(el,em='✨'){if(noAnim()||!el||!el.getBoundingClientRect)return;const r=el.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;
 for(let i=0;i<9;i++){const s=document.createElement('span');s.className='bst';s.textContent=em;s.style.left=cx+'px';s.style.top=cy+'px';document.body.appendChild(s);
 const a=Math.PI*2*i/9,d=40+Math.random()*40;s.animate([{transform:'translate(0,0) scale(.4)',opacity:1},{transform:`translate(${Math.cos(a)*d}px,${Math.sin(a)*d}px) scale(1.2)`,opacity:0}],{duration:700,easing:'ease-out'}).onfinish=()=>s.remove()}}
const btnOf=()=>{try{return window.event.target.closest('button')}catch(e){return null}};
/* figures */
function addFig(txt,id,cap){const s=[...document.querySelectorAll('#k-c2 summary,#k-c3 summary')].find(x=>x.textContent.includes(txt));if(s)s.nextElementSibling.insertAdjacentHTML('beforeend',`<figure class="fig"><img data-fig="${id}" alt=""><figcaption>${cap}</figcaption></figure>`)}
addFig('المنطق الرياضي','f24','الشكل (2-1): البوابات المنطقية');addFig('المنطق الرياضي','f25','الجدول (2-1): جداول الحقيقة');
addFig('النظام التعويضي','f33','الجدول (3-2): الفروقات بين النظم التعويضية');addFig('النظام الانتقالي','f34','الجدول (3-3): الانتقالي البسيط');
addFig('نظام متعدد الأبجديات','f35','الجدول (3-5): جدول الترميز القياسي');addFig('نظام متعدد الأبجديات','f36','الجدول (3-6): تشفير فيجينر');
document.querySelectorAll('img[data-fig]').forEach(i=>{i.src=FIGS[i.dataset.fig];i.loading='lazy'});
/* algorithm input tools */
const IT=()=>document.getElementById('inputText');
function copyInput(){const v=IT().value,b=btnOf();if(!v){showToast('لا يوجد نص لنسخه!','fa-triangle-exclamation text-amber-400');fxErr();pop(IT());return}copyText(v,'تم نسخ النص بنجاح');fxOk();burst(b,'📋')}
async function pasteInput(){const b=btnOf();try{const t=await navigator.clipboard.readText();if(!t)throw 0;IT().value=t;ensureRange(t);pop(IT());showToast('تم لصق النص');fxOk();burst(b,'📥')}
 catch(e){IT().focus();showToast('المتصفح منع اللصق التلقائي، اضغط Ctrl+V داخل المربع','fa-triangle-exclamation text-amber-400');fxErr()}}
function clearInput(){const t=IT(),b=btnOf();if(!t.value){showToast('المربع فارغ أصلاً','fa-circle-info text-sky-400');return}t.value='';t.focus();t.classList.remove('shk');void t.offsetWidth;t.classList.add('shk');
 document.getElementById('finalResult').textContent='النتيجة ستظهر هنا...';showToast('تم حذف النص','fa-trash-can text-rose-400');tone(300,.18,'triangle',.05,0,120);burst(b,'🗑️')}
const pick=a=>a[Math.random()*a.length|0];
const EXEN=['Hello World','Cryptography Is Fun','Top Secret 2026','Meet me at 9 PM','Cyber Security Lab','Secure Iraq 1977'],EXAR=['مرحبا بالعالم','التشفير علم جميل','رسالة سرية جداً','اللقاء الساعة التاسعة','مختبر الأمن السيبراني','بغداد مدينة السلام'];
let lastEx='',typeTok=0;
function ensureRange(t){const a=document.getElementById('algorithm').value,mx=Math.max(0,...[...t].map(c=>c.charCodeAt(0)));
 if(a==='elgamal'){const p=document.getElementById('elgamalP');if(mx>=+p.value){p.value=2003;showToast('رُفعت قيمة P إلى 2003 لدعم الحروف العربية','fa-circle-info text-sky-400')}}
 if(a==='rsa'&&mx>=(+document.getElementById('rsaP').value)*(+document.getElementById('rsaQ').value))showToast('بعض الرموز أكبر من N، ارفع P وQ','fa-triangle-exclamation text-amber-400')}
window.fillExample=function(){let t;do{const r=Math.random();t=r<.4?pick(EXEN):r<.8?pick(EXAR):pick(EXAR)+' '+pick(EXEN)}while(t===lastEx);lastEx=t;
 const el=IT(),tok=++typeTok;el.value='';let i=0;const b=btnOf();burst(b,'🎲');
 (function step(){if(tok!==typeTok)return;i+=2;el.value=t.slice(0,i);if(i<t.length){tone(500+Math.random()*500,.03,'square',.015);setTimeout(step,28)}else{el.value=t;ensureRange(t);pop(el);fxOk()}})();
 showToast('تم إدخال نص تجريبي عشوائي')};
['handleEncrypt','handleDecrypt'].forEach(n=>{const f=window[n];window[n]=function(){ensureRange(IT().value);f();fxOk();burst(btnOf(),n==='handleEncrypt'?'🔒':'🔓')}});
/* tasks: random multi-word examples + effects */
const WORDS=['HELLO WORLD','CRYPTOGRAPHY IS FUN','ATTACK AT DAWN','MEET ME AT NOON','CYBER SECURITY LAB','KEEP THIS SECRET','BAGHDAD IRAQ','LEARN AND PROTECT'];
const perm=n=>{const a=[...Array(n).keys()];for(let i=n-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
function sample(m){const t=pick(WORDS);switch(m){case'caesar':return[t,''+(1+Math.random()*25|0)];case'rand':return[t,perm(26).map(i=>String.fromCharCode(65+i)).join('')];
 case'trans':return[t,perm(3+Math.random()*3|0).map(i=>i+1).join(',')];case'poly':return[t,Array.from({length:3+Math.random()*2|0},()=>1+Math.random()*9|0).join(',')];
 case'vig':return[t,pick(['KEY','LEMON','CIPHER','SECRET','IRAQ'])];case'mat':return[t,pick(['3,3,2,5','5,8,17,3','1,2,3,5','2,3,1,4','7,8,11,11'])];default:return[t,'']}}
const cex=document.getElementById('cex');if(cex)cex.onclick=()=>{const m=document.getElementById('cm').value,e=sample(m);document.getElementById('ct').value=e[0];document.getElementById('ck').value=e[1];
 document.getElementById('cenc').click();const o=document.getElementById('cout');scrambleTo(o,o.textContent);burst(cex,'🎲')};
['cenc','cdec','xgo'].forEach(id=>{const b=document.getElementById(id);if(b)b.addEventListener('click',()=>setTimeout(()=>{pop(document.getElementById(id==='xgo'?'xout':'cout'));burst(b,'✨')},0))});
/* matrices task */
(function(){const g=id=>+document.getElementById(id).value,M=p=>[[g(p+0),g(p+1)],[g(p+2),g(p+3)]],md=(n,m)=>((n%m)+m)%m;
 const F=m=>`[ ${m[0][0]}  ${m[0][1]} ]\n[ ${m[1][0]}  ${m[1][1]} ]`,det=m=>m[0][0]*m[1][1]-m[0][1]*m[1][0],gcd=(a,b)=>b?gcd(b,a%b):Math.abs(a);
 const out=document.getElementById('mout');
 document.querySelectorAll('#matTask [data-m]').forEach(b=>b.onclick=()=>{const A=M('ma'),B=M('mb'),d=det(A);let s='';
  switch(b.dataset.m){
  case'add':s=`A + B (نجمع الخانات المتقابلة)\n${F([[A[0][0]+B[0][0],A[0][1]+B[0][1]],[A[1][0]+B[1][0],A[1][1]+B[1][1]]])}`;break;
  case'mul':{const r=(i,j)=>A[i][0]*B[0][j]+A[i][1]*B[1][j];s=`A × B (صف × عمود)\n(1,1)= ${A[0][0]}·${B[0][0]} + ${A[0][1]}·${B[1][0]} = ${r(0,0)}\n(1,2)= ${A[0][0]}·${B[0][1]} + ${A[0][1]}·${B[1][1]} = ${r(0,1)}\n(2,1)= ${A[1][0]}·${B[0][0]} + ${A[1][1]}·${B[1][0]} = ${r(1,0)}\n(2,2)= ${A[1][0]}·${B[0][1]} + ${A[1][1]}·${B[1][1]} = ${r(1,1)}\n${F([[r(0,0),r(0,1)],[r(1,0),r(1,1)]])}`;break}
  case'det':s=`|A| = ad − bc = ${A[0][0]}×${A[1][1]} − ${A[0][1]}×${A[1][0]} = ${d}\n${d?'|A| ≠ 0 ⇒ للمصفوفة معكوس':'|A| = 0 ⇒ لا يوجد معكوس'}`;break;
  case'inv':s=d?`|A| = ${d}\nA⁻¹ = (1/${d}) × [[${A[1][1]}, ${-A[0][1]}], [${-A[1][0]}, ${A[0][0]}]]`:'|A| = 0 ⇒ لا يوجد معكوس';break;
  case'mod':{const dm=md(d,26);let iv=0;for(let i=1;i<26;i++)if(dm*i%26===1)iv=i;s=`|A| = ${d} ⇒ ${dm} (mod 26)\ngcd(${dm},26) = ${gcd(dm,26)}\n`;
   if(!iv)s+='لا يوجد معكوس mod 26، غيّر المصفوفة.';else s+=`معكوس ${dm} هو ${iv} (لأن ${dm}×${iv} ≡ 1)\nA⁻¹ mod 26 =\n${F([[md(A[1][1]*iv,26),md(-A[0][1]*iv,26)],[md(-A[1][0]*iv,26),md(A[0][0]*iv,26)]])}`;break}
  case'rnd':{let a;do{a=[0,1,2,3].map(()=>Math.random()*10|0)}while(gcd(md(a[0]*a[3]-a[1]*a[2],26),26)!==1);a.forEach((v,i)=>document.getElementById('ma'+i).value=v);[0,1,2,3].forEach(i=>document.getElementById('mb'+i).value=Math.random()*10|0);
   s='تم توليد مصفوفتين جديدتين، جرّب العمليات الآن 🎲';break}}
  out.textContent=s;pop(out);burst(b,'🧮');fxOk()})})();
/* history wheel */
(function(){const IC=[[/كسر|Crack/,'💥'],[/Lucifer|IBM/,'🧪'],[/نشر|تعليق/,'📄'],[/اعتماد|FIPS|NBS|طلب المعيار/,'🏛️'],[/AES|Rijndael/,'🛡️'],[/سحب/,'🗑️'],[/Diffie|Hellman|مفتاح عام/,'🔑'],[/MIT|Stanford|جامعة/,'🎓'],[/تحليل/,'🔬'],[/PGP|GnuPG|TLS|HTTPS/,'🌐']],DF=['🕰️','💡','📜','🧮','🔐','⚙️','🛡️','🌐'],NT=[523,587,659,784,880,988,1047,1175];
 document.querySelectorAll('.hpanel').forEach(p=>{const ul=p.querySelector('ul.tl');if(!ul)return;
  const it=[...ul.children].map((li,i)=>({y:li.querySelector('.yr').textContent,t:li.querySelector('.tt').textContent,d:li.querySelector('p').textContent,ic:(IC.find(r=>r[0].test(li.textContent))||[0,DF[i%DF.length]])[1]})),N=it.length,st=360/N;
  const dots=it.map((_,i)=>`<g transform="rotate(${-i*st} 150 150)"><circle class="wh-dot" data-i="${i}" cx="150" cy="32" r="10"/><text class="wh-n" data-i="${i}" x="150" y="32">${i+1}</text></g>`).join('');
  const w=document.createElement('div');w.className='wh-wrap';
  w.innerHTML=`<div class="wh-stage"><svg class="wh-svg" viewBox="0 0 300 300" role="img" aria-label="عجلة التواريخ"><circle class="wh-ring" cx="150" cy="150" r="118"/><g class="wh-in"><circle cx="150" cy="150" r="96" fill="none" stroke="rgba(34,211,238,.35)" stroke-dasharray="4 8"/></g><g class="wh-rot" style="transform-origin:150px 150px">${dots}</g><path class="wh-ptr" d="M150 18 l-8 -14 h16 z"/><circle cx="150" cy="150" r="78" fill="rgba(5,8,22,.85)" stroke="rgba(124,92,255,.5)"/><text class="wh-year" x="150" y="158"></text></svg></div>
  <div class="wh-card"><div class="wh-scene"></div><div class="wh-yr"></div><div class="wh-tt"></div><p class="wh-p"></p></div>
  <div class="wh-ctl"><button class="btn btn-ghost wl"><i class="fa-solid fa-pause"></i> إيقاف</button><button class="btn btn-ghost wn"><i class="fa-solid fa-rotate-right"></i> التاريخ التالي</button><span class="text-xs mono wc" style="color:var(--muted)"></span></div>`;
  ul.replaceWith(w);const rot=w.querySelector('.wh-rot'),Q=s=>w.querySelector(s);let n=0,play=true,vis=true;
  function go(k,snd){n=k;rot.style.transform=`rotate(${n*st}deg)`;const i=((n%N)+N)%N,o=it[i];
   w.querySelectorAll('.wh-dot').forEach(d=>d.classList.toggle('on',+d.dataset.i===i));w.querySelectorAll('.wh-n').forEach(t=>{const j=+t.dataset.i;t.style.transform=`rotate(${(j-n)*st}deg)`;t.classList.toggle('on',j===i)});Q('.wh-year').textContent=o.y;
   Q('.wh-scene').innerHTML=`<div class="sc"><i></i><i class="r2"></i><span class="sc-ic">${o.ic}</span><b class="s1">✦</b><b class="s2">✦</b><b class="s3">•</b></div>`;
   Q('.wh-yr').textContent=o.y;Q('.wh-tt').textContent=o.t;Q('.wh-p').textContent=o.d;Q('.wc').textContent=(i+1)+' / '+N;const c=Q('.wh-card');c.style.animation='none';void c.offsetWidth;c.style.animation='';
   if(snd){fxSwipe();tone(NT[i%NT.length],.5,'sine',.07,.45);tone(NT[i%NT.length]*1.5,.4,'triangle',.03,.5)}}
  const next=()=>go(n+1,1);Q('.wn').onclick=()=>go(n+1,1);
  Q('.wl').onclick=()=>{play=!play;Q('.wl').innerHTML=play?'<i class="fa-solid fa-pause"></i> إيقاف':'<i class="fa-solid fa-play"></i> تشغيل تلقائي'};
  w.querySelectorAll('.wh-dot').forEach(d=>d.onclick=()=>{const t=+d.dataset.i,cur=((n%N)+N)%N;go(n+((t-cur)+N)%N,1)});
  new IntersectionObserver(e=>vis=e[0].isIntersecting,{threshold:.3}).observe(w);
  setInterval(()=>{if(play&&vis&&w.offsetParent)next()},6500);go(0,0)})})();

</script>
<!-- ===== RK animated explainers v2: pure SVG + CSS, no video files, ~9KB ===== -->
<style>
.vx{width:100%;max-width:470px;height:auto;direction:ltr;overflow:visible}
.vx text{fill:#e5e9ff;unicode-bidi:plaintext}
.vx .lb{font-size:11px;fill:#93a0c9}
.pk{opacity:0;animation:vxi .55s var(--d,0s) both cubic-bezier(.2,1.5,.4,1)}
@keyframes vxi{from{opacity:0;transform:translate(var(--x),calc(var(--y) + 16px)) scale(.4)}to{opacity:1;transform:translate(var(--x),var(--y)) scale(1)}}
.mv{opacity:0;animation:vxm 1.7s var(--d,0s) both ease-in-out}
@keyframes vxm{0%{opacity:0;transform:translate(var(--x),var(--y))}12%,88%{opacity:1}100%{opacity:1;transform:translate(var(--x2),var(--y2))}}
.ln{stroke:rgba(148,163,255,.45);stroke-width:2;stroke-dasharray:6 5;animation:vxd 1s linear infinite}
@keyframes vxd{to{stroke-dashoffset:-22}}
.pl{fill:rgba(255,255,255,.06);stroke-width:1.4}
.pt{font-weight:800;font-size:13px}
.pl.g{stroke:#34f5b8}.pt.g{fill:#34f5b8}.pl.r{stroke:#f87171}.pt.r{fill:#fca5a5}
.pl.y{stroke:#f59e0b}.pt.y{fill:#fde68a}.pl.b{stroke:#7c5cff}.pt.b{fill:#c4b5fd}
.pl.c{stroke:#22d3ee}.pt.c{fill:#67e8f9}.pl.p{stroke:#f472b6}.pt.p{fill:#f9a8d4}
.mo{font:700 16px 'Courier New',monospace;letter-spacing:2px}
.mo.g{fill:#34f5b8}.mo.y{fill:#fde68a}
.gl{filter:drop-shadow(0 0 10px #fde047)}.dm{opacity:.3}
@media(prefers-reduced-motion:reduce){.pk,.mv,.ln{animation-duration:.01s;animation-delay:0s}}
#vSteps{display:flex;gap:.45rem;justify-content:center;flex-wrap:wrap;margin-top:.8rem}
#vSteps button{width:30px;height:30px;border-radius:50%;border:1.5px solid #94a0ff;background:#1a1f4a;color:#cfd6ff;font:800 .8rem Tajawal,sans-serif;cursor:pointer;transition:.25s}
#vSteps button.ok{background:#0f766e;border-color:#34f5b8;color:#fff}
#vSteps button.on{background:#22d3ee;border-color:#fff;color:#021018;transform:scale(1.2);box-shadow:0 0 14px rgba(34,211,238,.7)}
.vid-stage{background:radial-gradient(420px 200px at 50% 0%,rgba(124,92,255,.22),transparent 70%),#02040f}
</style>
<script>
(function(){
const m=x=>400-x; // mirrored: story flows right→left like Arabic reading
const X=c=>`<svg class="vx" viewBox="0 0 400 170"><defs><marker id="ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8z" fill="#8ea0ff"/></marker></defs>${c}</svg>`;
const G=(x,y,d,i)=>`<g class="pk" style="--x:${m(x)}px;--y:${y}px;--d:${d}s">${i}</g>`;
const E=(x,y,e,l='',d=0,s=34,c='')=>G(x,y,d,`<text class="${c}" font-size="${s}" text-anchor="middle">${e}</text>${l?`<text class="lb" y="${s*.75+8}" text-anchor="middle">${l}</text>`:''}`);
const P=(x,y,t,c='g',d=0,s=0)=>{const w=t.length*8+22;return G(x,y,d,`<rect class="pl ${c}" x="${-w/2}" y="-15" width="${w}" height="30" rx="15"/><text class="pt ${c}" y="5" text-anchor="middle"${s?` data-f="${t}" data-d="${d+.3}"`:''}>${t}</text>`)};
const V=(x1,y,x2,e,d=0,s=26)=>`<g class="mv" style="--x:${m(x1)}px;--y:${y}px;--x2:${m(x2)}px;--y2:${y}px;--d:${d}s"><text font-size="${s}" text-anchor="middle">${e}</text></g>`;
const L=(x1,y1,x2,y2)=>`<line class="ln" x1="${m(x1)}" y1="${y1}" x2="${m(x2)}" y2="${y2}" marker-end="url(#ah)"/>`;
const T=(x,y,t,c,d)=>G(x,y,d,`<text class="mo ${c}" text-anchor="middle">${t}</text>`);
const S=(...a)=>()=>X(a.join(''));

window.VX={
general:[
 S(E(60,85,'👦','أنا',0),E(340,85,'🧑','صديقي',.2),L(95,80,305,80),V(95,70,305,'💌',.5,30),E(200,28,'👀','هل يقرؤها غيري؟',1.3,28)),
 S(E(80,85,'💌','الرسالة',0,40),L(125,80,235,80),E(300,85,'📦','',.6,54),E(325,62,'🔒','',1,26),P(300,148,'نص مشفّر','r',1.3)),
 S(E(60,85,'📦','مقفل',0,42),V(115,70,265,'🔑',.4,30),E(330,85,'💌','الرسالة ✔',1.5,42),P(200,148,'فك التشفير','g',1.7)),
 S(E(70,85,'📦','الصندوق',0,40),E(330,85,'🕵️','اللص',.5,42),L(115,80,285,80),P(200,32,'لا يملك المفتاح ❌','r',1.3)),
 S(P(200,24,'17 🍎 ÷ 5 أشخاص','y',0),...[0,1,2,3,4].map(i=>E(60+i*70,75,'👤','3 🍎',.3+i*.18,30)),P(200,142,'الباقي = 2 🍎🍎  ⇒  17 mod 5 = 2','g',1.7)),
 S(E(70,65,'🔑','DES',0,38),E(200,65,'📬','RSA',.3,38),E(330,65,'🎨','ElGamal',.6,38),P(70,135,'مفتاح واحد','y',.8),P(200,135,'قفل + مفتاح','c',1.1),P(330,135,'خلط ألوان','p',1.4))
],
des:[
 S(E(60,70,'👦','أنا',0,38),E(340,70,'👧','صديقي',.2,38),E(120,30,'🔑','',.5,28),E(280,30,'🔑','',.7,28),E(200,95,'📒','دفتر سرّي',1,44),P(200,150,'نفس المفتاح عند الطرفين','y',1.4)),
 S(E(80,75,'💡','مطفأ',0,46,'dm'),E(200,45,'👆','ضغطة',.6,36),E(320,75,'💡','مضاء',1.1,46,'gl'),P(200,145,'ضغطة ثانية ⇒ يعود مطفأ','b',1.9)),
 S(T(200,50,'H   : 0 1 0 0 1 0 0 0','g',0),T(200,85,'KEY : 0 1 0 1 1 0 1 0','y',.6),T(200,125,'OUT : 0 0 0 1 0 0 1 0','g',1.3)),
 S(P(55,80,'H = 72','g',0),L(100,80,150,80),P(200,80,'🔑 قلب','y',.5),L(250,80,300,80),P(350,80,'12','r',1.1,1),E(200,138,'🕵️','لا يفهم شيئاً',1.5,24)),
 S(P(55,80,'12','r',0),P(200,80,'🔑 قلب ثانية','y',.5),P(345,80,'H ✔','g',1.1),L(100,80,150,80),L(250,80,300,80)),
 S(E(60,70,'🔑','',0,36),V(95,70,305,'🔑',.4,30),E(200,28,'🕵️','قد يراه',.9,32),E(340,70,'👧','',.2,36),P(200,148,'الحل: RSA و ElGamal','c',1.6))
],
rsa:[
 S(E(50,70,'👥','الجميع',0,34),V(85,62,200,'💌',.5),E(235,70,'📬','فتحة عامة',.3,46),E(345,70,'🔑','صاحبه فقط',1.3,34)),
 S(E(110,70,'🔓','مفتاح عام',0,52),E(290,70,'🔑','مفتاح خاص',.5,52),P(110,140,'للجميع','c',.9),P(290,140,'لي وحدي','p',1.2)),
 S(P(110,50,'61 × 53','y',0),L(165,50,235,50),P(290,50,'3233','g',.6,1),P(110,120,'3233 = ؟ × ؟','b',1.2),L(165,120,235,120),P(290,120,'❌ صعب','r',1.6)),
 S(P(55,80,'H = 72','g',0),L(100,80,140,80),P(205,80,'72^17 mod 3233','c',.5),L(272,80,305,80),P(352,80,'3000','r',1.1,1)),
 S(P(55,80,'3000','r',0),L(100,80,115,80),P(200,80,'3000^2753 mod 3233','p',.5),L(285,80,300,80),P(350,80,'72 = H ✔','g',1.2)),
 S(E(110,70,'🔓','قفل للجميع',0,48),E(290,70,'🔑','فتح لي وحدي',.5,48),P(200,145,'✔ آمن وسهل','g',1.2))
],
elgamal:[
 S(E(60,75,'🔴','',0,44),P(112,75,'+','b',.2),E(160,75,'🔵','',.3,44),L(195,75,235,75),E(290,75,'🟣','بنفسجي',.9,50),P(200,145,'فصلهما شبه مستحيل ❌','r',1.5)),
 S(P(100,40,'لون عام = 2','b',0),P(300,40,'سري = 153','p',.4),L(100,58,185,98),L(300,58,215,98),P(200,115,'المفتاح العام = 224','c',1.1,1)),
 S(P(70,45,'k = 197','y',0),L(120,45,150,45),P(205,45,'c1 = 87 يُرسَل','r',.6),P(200,115,'السر المشترك = 367','g',1.3,1)),
 S(P(55,75,'H = 72','g',0),P(200,75,'× 367 mod 467','y',.5),P(345,75,'272','r',1.1,1),L(100,75,140,75),L(262,75,305,75),P(200,135,'(87 , 272) يُرسَل','r',1.6)),
 S(P(100,40,'153 + 87','p',0),P(300,40,'السر = 367 ✔','y',.5),P(100,115,'272','r',1.1),P(300,115,'72 = H ✔','g',1.5),L(100,58,100,98),L(300,58,300,98)),
 S(E(70,65,'🕵️','اللص',0,40),P(250,40,'يرى: 224 , 87 , 272','b',.4),P(250,100,'لا يعرف السر ❌','r',1.2))
]};

function scr(el){const f=el.dataset.f,t0=performance.now()+(+el.dataset.d||0)*1000,ch='0123456789ABCDEF#@$%';
 (function s(n){const k=(n-t0)/900;if(!el.isConnected)return;if(k<0){el.textContent=ch[Math.random()*20|0].repeat(f.length);return requestAnimationFrame(s)}
  if(k>=1){el.textContent=f;return}el.textContent=[...f].map((c,i)=>i<k*f.length?c:ch[Math.random()*20|0]).join('');requestAnimationFrame(s)})(performance.now())}

// override renderer: new motion scenes for the beginner level, original scenes for the detailed level
window.vRender=function(){
 const s=VSCENES[vi],x=vLevel==='simple'&&VX[vKey]&&VX[vKey][vi],st=document.getElementById('vStage');
 st.innerHTML=`<div class="vtitle">${s.t}</div>`+(x?x():s.h);
 st.querySelectorAll('[data-f]').forEach(scr);
 document.getElementById('vCaption').textContent=s.c;
 document.getElementById('vCount').textContent=(vi+1)+' / '+VSCENES.length;
 let sb=document.getElementById('vSteps');
 if(!sb){sb=document.createElement('div');sb.id='vSteps';document.querySelector('.vbar').after(sb)}
 if(sb.children.length!==VSCENES.length){sb.innerHTML=VSCENES.map((_,k)=>`<button type="button" aria-label="مشهد ${k+1}">${k+1}</button>`).join('');
  [...sb.children].forEach((b,k)=>b.onclick=()=>{vPause();vi=k;vt=0;vDone=false;vRender();vFillBar();vPlay()})}
 [...sb.children].forEach((b,k)=>{b.className=k===vi?'on':k<vi?'ok':''});
};
})();
</script>


<script>
/* ===== مركز تسليم الملفات → بوت تلجرام (IndexedDB + ضغط الصور + إرسال متوازٍ تلقائي) ===== */
(function(){
var TG={
  TOKEN:RK_TOK,
  CHAT_ID:'',   // رقم محادثتك (اختياري): إذا تُرك فارغاً يُكتشف تلقائياً بعد أن ترسل /start للبوت
  PROXY:'',     // اختياري: رابط Cloudflare Worker لإخفاء التوكن
  MAX_MB:45,    // حد تلجرام 50MB
  CONC:2,       // عدد الملفات المرسلة بالتوازي
  IMG_MAX:2200, // أكبر بُعد للصورة بعد الضغط (بكسل)
  IMG_Q:.85     // جودة JPEG
};
var DB='rk_submit',ST='files',db,busy=false,again=false,els={},urls={},prog={},gone={},pendN=0,lastFocus=null;
function $(i){return document.getElementById(i)}
function open(){return new Promise(function(res,rej){var r=indexedDB.open(DB,1);
 r.onupgradeneeded=function(){r.result.createObjectStore(ST,{keyPath:'id'})};
 r.onsuccess=function(){db=r.result;res()};r.onerror=function(){rej(r.error)}})}
function tx(m){return db.transaction(ST,m).objectStore(ST)}
function all(){return new Promise(function(res){var q=tx('readonly').getAll();q.onsuccess=function(){res(q.result.sort(function(a,b){return a.t-b.t}))};q.onerror=function(){res([])}})}
function put(o){return new Promise(function(res,rej){var q=tx('readwrite').put(o);q.onsuccess=res;q.onerror=function(){rej(q.error)}})}
function del(id){return new Promise(function(res){var q=tx('readwrite').delete(id);q.onsuccess=res;q.onerror=res})}
function sz(n){return n>1048576?(n/1048576).toFixed(1)+' MB':Math.max(1,Math.round(n/1024))+' KB'}
function esc(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function note(t){var n=$('sbNote');if(n)n.textContent=t||''}
function name(){return($('sbName').value||'').trim()}
function dev(){var u=navigator.userAgent;return/iPhone|iPad/.test(u)?'iPhone/iPad':/Android/.test(u)?'Android':/Windows/.test(u)?'Windows':/Mac/.test(u)?'Mac':'—'}
function saveF(){try{localStorage.setItem('rk_sbname',name())}catch(e){}}
function noAnim(){return document.documentElement.classList.contains('noanim')}
function buzz(p){try{navigator.vibrate&&navigator.vibrate(p)}catch(e){}}
function snd(f,d,t0){try{if(typeof tone==='function')tone(f,d||.1,'sine',.06,t0||0)}catch(e){}}

/* ---------- واجهة ---------- */
var FAB='<button id="sbFab" type="button" aria-label="مركز تسليم الملفات"><i class="fa-solid fa-paper-plane"></i><span class="sb-badge" id="sbBadge" data-n="0">0</span></button>';
var SHEET='<div class="sb-ov" id="sbOv"></div>'+
'<div id="sbSheet" role="dialog" aria-modal="true" aria-labelledby="sbTtl">'+
'<div class="sb-grab"><i></i></div>'+
'<div class="sb-hd"><div class="sb-ttl"><b id="sbTtl">📤 مركز تسليم الملفات</b><small>RK-TEAM · إرسال تلقائي إلى المشرف</small></div><span class="sb-chip" id="sbNet"><span class="d"></span><b>…</b></span><button type="button" class="sb-cl" id="sbClose" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button></div>'+
'<div class="sb-body"><div class="sb-grid">'+
'<div><label class="label" for="sbName"><i class="fa-solid fa-user"></i> الاسم الثلاثي <span style="color:#f87171">*</span></label><input id="sbName" class="field" placeholder="مثال: علي حسين محمد" maxlength="60" autocomplete="name"></div>'+
'<div><label class="label" for="sbMsg"><i class="fa-solid fa-note-sticky"></i> ملاحظة (اختياري)</label><input id="sbMsg" class="field" placeholder="مثال: واجب الفصل الثالث" maxlength="200"></div></div>'+
'<div class="sb-tiles"><button type="button" class="sb-tile t1" id="sbCam"><span><i class="fa-solid fa-camera"></i></span>تصوير</button>'+
'<button type="button" class="sb-tile t2" id="sbGal"><span><i class="fa-solid fa-images"></i></span>الصور</button>'+
'<button type="button" class="sb-tile t3" id="sbUp"><span><i class="fa-solid fa-file-arrow-up"></i></span>ملفات</button></div>'+
'<label class="sb-opt"><input type="checkbox" id="sbComp" checked><span>ضغط الصور تلقائياً لإرسال أسرع بجودة ممتازة</span></label>'+
'<div class="sb-stats"><span>بالانتظار: <b id="sbPend">0</b></span><span>أُرسل: <b id="sbDone">0</b></span></div>'+
'<div id="sbList"></div><p id="sbNote"></p></div>'+
'<div class="sb-ft"><button type="button" class="btn btn-dec" id="sbNow"><i class="fa-solid fa-rotate"></i> إرسال الآن</button><button type="button" class="btn btn-ghost" id="sbClr" style="display:none"><i class="fa-solid fa-broom"></i> مسح المرسَل</button></div>'+
'<input type="file" id="sbCamIn" accept="image/*" capture="environment" hidden><input type="file" id="sbGalIn" accept="image/*" multiple hidden><input type="file" id="sbFileIn" multiple hidden></div>';

function netUI(){var on=navigator.onLine,c=$('sbNet');c.className='sb-chip'+(on?' on':'');c.querySelector('b').textContent=on?'متصل':'غير متصل — الحفظ محلي'}
function fab(){var f=$('sbFab');if(!f)return;f.classList.toggle('pend',pendN>0&&!busy);f.classList.toggle('busy',busy&&pendN>0)}
function ripple(e){var b=e.currentTarget,r=b.getBoundingClientRect(),s=Math.max(r.width,r.height),d=document.createElement('i');d.className='rp';
 d.style.cssText='width:'+s+'px;height:'+s+'px;left:'+(e.clientX-r.left-s/2)+'px;top:'+(e.clientY-r.top-s/2)+'px';b.appendChild(d);setTimeout(function(){d.remove()},650)}
function confetti(){
  if(noAnim())return;
  var c=document.createElement('canvas');c.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:95';
  var W=c.width=innerWidth,Hh=c.height=innerHeight;document.body.appendChild(c);var x=c.getContext('2d'),cols=['#7c5cff','#22d3ee','#34f5b8','#fcd34d','#f472b6'],P=[],i;
  for(i=0;i<70;i++)P.push({x:W/2,y:Hh*.72,vx:(Math.random()-.5)*14,vy:-Math.random()*16-6,s:5+Math.random()*5,c:cols[i%5],r:Math.random()*6,vr:(Math.random()-.5)*.4});
  var t0=performance.now();
  (function f(t){var k=t-t0;x.clearRect(0,0,W,Hh);
    P.forEach(function(p){p.vy+=.5;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;x.save();x.translate(p.x,p.y);x.rotate(p.r);x.fillStyle=p.c;x.globalAlpha=Math.max(0,1-k/1700);x.fillRect(-p.s/2,-p.s/2,p.s,p.s*.6);x.restore()});
    if(k<1700)requestAnimationFrame(f);else c.remove()})(t0);
}
function celebrate(){
  confetti();buzz([20,40,20]);snd(784,.12,0);snd(1047,.22,.12);
  var f=$('sbFab');if(f){f.classList.add('ok');f.firstChild.className='fa-solid fa-check';setTimeout(function(){f.classList.remove('ok');f.firstChild.className='fa-solid fa-paper-plane'},2200)}
}
function openS(){lastFocus=document.activeElement;$('sbOv').classList.add('on');$('sbSheet').classList.add('on');document.body.classList.add('sb-open');buzz(10);
  setTimeout(function(){try{(name()?$('sbCam'):$('sbName')).focus({preventScroll:true})}catch(e){}},380)}
function closeS(){$('sbOv').classList.remove('on');$('sbSheet').classList.remove('on');document.body.classList.remove('sb-open');
  try{lastFocus&&lastFocus.focus&&lastFocus.focus({preventScroll:true})}catch(e){}}
function needName(){if(name())return false;var n=$('sbName');n.classList.remove('sb-shake');void n.offsetWidth;n.classList.add('sb-shake');n.focus();buzz([30,40,30]);showToast('اكتب اسمك أولاً','fa-triangle-exclamation text-amber-400');return true}

/* ---------- القائمة (تحديث تدريجي بدون إعادة بناء) ---------- */
function mk(it){
  var d=document.createElement('div');d.className='sb-it sb-in';
  d.innerHTML='<div class="sb-th"></div><div class="sb-nm"><span class="n"></span><span class="sb-sz"></span></div><span class="sb-st"></span><button type="button" class="sb-x" aria-label="حذف"><i class="fa-solid fa-trash"></i></button><div class="sb-pg"><i></i></div>';
  d.addEventListener('animationend',function(){d.classList.remove('sb-in')},{once:true});
  d.querySelector('.sb-x').onclick=async function(){gone[it.id]=1;delete prog[it.id];await del(it.id);render()};
  return d}
function upd(it,d){
  var img=/^image\//.test(it.type||''),th=d.querySelector('.sb-th');
  if(!d._th){if(it.blob&&img){var u=URL.createObjectURL(it.blob);urls[it.id]=u;th.innerHTML='<img alt="" src="'+u+'">'}else th.innerHTML='<i class="fa-solid fa-file"></i>';d._th=1}
  if(it.sent&&!urls[it.id])th.innerHTML='<i class="fa-solid fa-circle-check" style="color:#6ee7b7"></i>';
  d.querySelector('.n').textContent=it.fname;d.querySelector('.sb-sz').textContent=sz(it.size||0);
  var p=Math.round((prog[it.id]||0)*100),cls,txt;
  if(it.sent){cls='ok';txt='تم الإرسال ✔'}else if(it.busy){cls='s';txt='جارٍ الإرسال '+p+'%'}else if(it.prep){cls='s';txt='جارٍ التحضير…'}else{cls='w';txt=navigator.onLine?'بالانتظار':'بانتظار الإنترنت'}
  var st=d.querySelector('.sb-st');st.className='sb-st '+cls;st.textContent=txt;
  d.querySelector('.sb-pg').style.display=it.busy?'block':'none';d.querySelector('.sb-pg i').style.width=p+'%';
  d.querySelector('.sb-x').style.display=it.busy?'none':'';
}
function paint(items){
  var box=$('sbList'),ids={};
  items.forEach(function(x){ids[x.id]=1});
  Object.keys(els).forEach(function(id){if(!ids[id]){els[id].remove();delete els[id];if(urls[id]){URL.revokeObjectURL(urls[id]);delete urls[id]}}});
  pendN=items.filter(function(x){return !x.sent}).length;
  var done=items.length-pendN;
  $('sbPend').textContent=pendN;$('sbDone').textContent=done;$('sbClr').style.display=done?'':'none';
  [$('sbBadge'),$('sbBadge0')].forEach(function(b){if(b){b.textContent=pendN;b.dataset.n=pendN}});
  var em=box.querySelector('.sb-empty');
  if(!items.length){if(!em)box.innerHTML='<div class="sb-empty">📂 لا توجد ملفات بعد — اضغط «تصوير» أو «ملفات» للبدء</div>'}
  else{if(em)em.remove();items.slice().reverse().forEach(function(it){var d=els[it.id];if(!d)d=els[it.id]=mk(it);upd(it,d);box.appendChild(d)})}
  fab();
}
function render(){return all().then(paint)}

/* ---------- ضغط الصور (أكبر عامل للسرعة) ---------- */
async function shrink(f){
  if(!$('sbComp').checked||!/^image\/(jpeg|png|webp)$/.test(f.type)||f.size<500*1024||!window.createImageBitmap)return f;
  try{
    var bm=await createImageBitmap(f),k=Math.min(1,TG.IMG_MAX/Math.max(bm.width,bm.height)),w=Math.round(bm.width*k),h=Math.round(bm.height*k),c,x,out;
    if(window.OffscreenCanvas)c=new OffscreenCanvas(w,h);else{c=document.createElement('canvas');c.width=w;c.height=h}
    x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,w,h);x.drawImage(bm,0,0,w,h);
    out=c.convertToBlob?await c.convertToBlob({type:'image/jpeg',quality:TG.IMG_Q}):await new Promise(function(r){c.toBlob(r,'image/jpeg',TG.IMG_Q)});
    if(bm.close)bm.close();
    return(out&&out.size<f.size)?out:f;
  }catch(e){return f}
}

async function add(files,isCam){
  if(!files||!files.length)return;
  var list=[],i,f;
  for(i=0;i<files.length;i++){
    f=files[i];
    if(f.size>TG.MAX_MB*1048576){showToast('«'+f.name+'» أكبر من '+TG.MAX_MB+' MB','fa-triangle-exclamation text-amber-400');continue}
    var fn=f.name;
    if(isCam||!fn){var ext=((f.type||'image/jpeg').split('/')[1]||'jpg').replace('jpeg','jpg');fn='photo_'+new Date().toISOString().replace(/[:.]/g,'-').slice(0,19)+'.'+ext}
    var rec={id:Date.now()+'_'+Math.random().toString(36).slice(2,7),t:Date.now()+i,fname:fn,blob:f,size:f.size,type:f.type||'',who:name(),msg:($('sbMsg').value||'').trim(),sent:false,busy:false,prep:true};
    await put(rec);list.push(rec);
  }
  if(!list.length)return;
  saveF();render();buzz(12);snd(660,.08,0);
  await Promise.all(list.map(async function(rec){
    var o=await shrink(rec.blob);
    if(gone[rec.id])return;
    if(o!==rec.blob){rec.blob=o;rec.size=o.size;rec.type=o.type;rec.fname=rec.fname.replace(/\.[^.]+$/,'')+'.jpg'}
    rec.prep=false;await put(rec)}));
  await render();showToast('تم حفظ '+list.length+' ملف على جهازك');flush();
}

/* ---------- الإرسال ---------- */
async function chatId(){
  if(TG.CHAT_ID)return String(TG.CHAT_ID);
  try{var c=localStorage.getItem('rk_cid');if(c)return c}catch(e){}
  try{
    var r=await fetch(RK_TG+'/bot'+TG.TOKEN+'/getUpdates?limit=100'),j=await r.json();
    var m=(j.result||[]).map(function(x){return x.message||x.edited_message}).filter(function(m){return m&&m.chat&&m.chat.type==='private'})[0];
    if(m){var id=String(m.chat.id);try{localStorage.setItem('rk_cid',id)}catch(e){}return id}
  }catch(e){}
  return '';
}
function xhr(url,fd,onp){return new Promise(function(res){
  var x=new XMLHttpRequest();x.open('POST',url);x.timeout=180000;
  x.upload.onprogress=function(e){if(e.lengthComputable)onp(e.loaded/e.total)};
  x.onload=function(){var j=null;try{j=JSON.parse(x.responseText)}catch(e){}
    res({ok:!!(j&&j.ok),net:!j,retry:j&&j.parameters&&j.parameters.retry_after,desc:j&&j.description,code:x.status})};
  x.onerror=x.ontimeout=function(){res({ok:false,net:true})};
  x.send(fd)})}
async function sendOne(it){
  var chat=TG.PROXY?'x':await chatId();
  if(!chat)return{ok:false,nochat:true};
  var cap='📥 <b>تسليم جديد — مختبر التشفير</b>\n👤 <b>'+esc(it.who||'بدون اسم')+'</b>\n';
  if(it.msg)cap+='📝 '+esc(it.msg)+'\n';
  cap+='📄 '+esc(it.fname)+' ('+sz(it.size)+')\n🕒 '+new Date(it.t).toLocaleString('ar-IQ')+'\n📱 '+dev();
  var fd=new FormData();
  if(!TG.PROXY)fd.append('chat_id',chat);
  fd.append('parse_mode','HTML');fd.append('caption',cap);fd.append('document',it.blob,it.fname);
  var rr=await xhr(TG.PROXY||(RK_TG+'/bot'+TG.TOKEN+'/sendDocument'),fd,function(p){
    prog[it.id]=p;var d=els[it.id];
    if(d){d.querySelector('.sb-pg i').style.width=Math.round(p*100)+'%';d.querySelector('.sb-st').textContent='جارٍ الإرسال '+Math.round(p*100)+'%'}});
  if(rr.ok||!(rr.net||rr.nochat)||!window.RK_FB||it.size>3500000)return rr;
  /* احتياطي: تلغرام محظور → نرسل التسليم إلى Firebase */
  try{var data=await new Promise(function(ok,no){var fr=new FileReader();fr.onload=function(){ok(fr.result)};fr.onerror=no;fr.readAsDataURL(it.blob)});
   await rkFbPut('submissions/'+String(it.id).replace(/[^A-Za-z0-9_-]/g,'_'),{who:it.who||'',msg:it.msg||'',fname:it.fname,size:it.size,t:it.t,dev:dev(),data:data});
   return{ok:true,fb:true}}catch(e){return rr}
}
function failNote(r){
  if(r.nochat)note('تعذر تحديد حساب المشرف: افتح البوت في تلجرام واضغط Start ثم اضغط «إرسال الآن».');
  else if(r.retry)note('ضغط على تلجرام — سيُعاد الإرسال بعد '+r.retry+' ثانية.');
  else if(r.net)note('تعذر الاتصال — ستُعاد المحاولة تلقائياً.');
  else note('رفض تلجرام الطلب ('+(r.desc||r.code)+').');
}
async function flush(){
  if(busy){again=true;return}
  if(!navigator.onLine){note('لا يوجد إنترنت — الملفات محفوظة وستُرسل تلقائياً عند عودة الاتصال.');return}
  busy=true;fab();var sent=0,fail=false;
  try{
    do{
      again=false;
      var q=(await all()).filter(function(x){return !x.sent&&x.blob&&!x.prep&&!x.busy});
      if(!q.length)break;
      var stop=false,worker=async function(){
        while(!stop&&q.length){
          var it=q.shift();if(gone[it.id])continue;
          it.busy=true;prog[it.id]=0;await put(it);render();note('جارٍ الإرسال…');
          var r=await sendOne(it);
          it.busy=false;if(gone[it.id])continue;
          if(r.ok){it.sent=true;it.blob=null;it.sentAt=Date.now();await put(it);sent++;render();snd(880,.06,0)}
          else{await put(it);render();stop=true;fail=true;failNote(r)}
        }};
      var ws=[],n;for(n=0;n<TG.CONC;n++)ws.push(worker());
      await Promise.all(ws);
      if(fail)break;
    }while(again);
  }catch(e){note('حدث خطأ — ستُعاد المحاولة تلقائياً.')}
  finally{
    busy=false;await render();
    if(sent&&!fail&&pendN===0){note('✔ وصلت كل الملفات ('+sent+') إلى المشرف.');celebrate()}
  }
}

/* ---------- تشغيل ---------- */
async function init(){
  document.body.insertAdjacentHTML('beforeend',FAB+SHEET);
  var pc=document.createElement('link');pc.rel='preconnect';pc.href=RK_TG;document.head.appendChild(pc);
  try{$('sbName').value=localStorage.getItem('rk_sbname')||'';if(localStorage.getItem('rk_sbcomp')==='0')$('sbComp').checked=false}catch(e){}
  var a0=await all(),i;for(i=0;i<a0.length;i++){if(a0[i].busy||a0[i].prep){a0[i].busy=false;a0[i].prep=false;await put(a0[i])}}
  $('sbName').addEventListener('change',saveF);
  $('sbComp').onchange=function(){try{localStorage.setItem('rk_sbcomp',this.checked?'1':'0')}catch(e){}};
  $('sbFab').onclick=openS;$('sbOpen').onclick=openS;$('sbClose').onclick=closeS;$('sbOv').onclick=closeS;
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&$('sbSheet').classList.contains('on'))closeS()});
  [].forEach.call(document.querySelectorAll('.sb-tile,#sbNow'),function(b){b.addEventListener('pointerdown',ripple)});
  $('sbCam').onclick=function(){if(!needName())$('sbCamIn').click()};
  $('sbGal').onclick=function(){if(!needName())$('sbGalIn').click()};
  $('sbUp').onclick=function(){if(!needName())$('sbFileIn').click()};
  $('sbNow').onclick=function(){flush()};
  $('sbClr').onclick=async function(){var a=await all(),j;for(j=0;j<a.length;j++)if(a[j].sent)await del(a[j].id);render()};
  $('sbCamIn').onchange=function(){add([].slice.call(this.files),true);this.value=''};
  $('sbGalIn').onchange=function(){add([].slice.call(this.files),false);this.value=''};
  $('sbFileIn').onchange=function(){add([].slice.call(this.files),false);this.value=''};
  var sh=$('sbSheet');
  ['dragenter','dragover'].forEach(function(e){sh.addEventListener(e,function(ev){ev.preventDefault();sh.classList.add('drag')})});
  ['dragleave','drop'].forEach(function(e){sh.addEventListener(e,function(ev){ev.preventDefault();sh.classList.remove('drag')})});
  sh.addEventListener('drop',function(ev){if(!needName())add([].slice.call(ev.dataTransfer.files),false)});
  document.addEventListener('paste',function(ev){if(!sh.classList.contains('on'))return;var fs=[].slice.call((ev.clipboardData&&ev.clipboardData.files)||[]);if(fs.length&&!needName())add(fs,false)});
  var sy=null,dy=0;
  sh.addEventListener('pointerdown',function(e){if(!matchMedia('(max-width:759px)').matches||!e.target.closest('.sb-grab,.sb-hd')||e.target.closest('button'))return;sy=e.clientY;sh.style.transition='none'});
  sh.addEventListener('pointermove',function(e){if(sy==null)return;dy=Math.max(0,e.clientY-sy);sh.style.transform='translateY('+dy+'px)'});
  var end=function(){if(sy==null)return;var c=dy>110;sy=null;sh.style.transition='';sh.style.transform='';dy=0;if(c)closeS()};
  sh.addEventListener('pointerup',end);sh.addEventListener('pointercancel',end);
  window.addEventListener('online',function(){netUI();render();note('عاد الإنترنت — جارٍ الإرسال…');flush()});
  window.addEventListener('offline',function(){netUI();render();note('لا يوجد إنترنت — الملفات محفوظة على جهازك.')});
  document.addEventListener('visibilitychange',function(){if(!document.hidden)flush()});
  setInterval(flush,15000);
  netUI();await render();flush();
}
function fail(m){var b=$('sbOpen');if(b){b.disabled=true;b.textContent=m}}
if(!window.indexedDB){fail('المتصفح لا يدعم التخزين المحلي');return}
open().then(init).catch(function(){fail('تعذر فتح التخزين المحلي (جرّب خارج وضع التصفح الخفي)')});
})();
</script>
<div id="anLb" role="dialog" aria-label="عرض الصورة"><img alt=""><button type="button" aria-label="إغلاق">×</button></div>
<div id="trOv" role="dialog" aria-modal="true" aria-label="جولة تعريفية"><div id="trBox"><div class="tr-s on"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><polygon points="150,18 190,40 190,92 150,118 110,92 110,40" fill="#7c5cff33" stroke="#22d3ee" stroke-width="3"/><path d="M132 68l14 14 24-28" fill="none" stroke="#34f5b8" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><g fill="#a5b4fc" font-family="Courier New" font-size="13" opacity=".75"><text x="28" y="42">A→D</text><text x="226" y="62">0110</text><text x="38" y="112">RSA</text><text x="232" y="116">DES</text></g></svg></div><h3>أهلاً بك في المختبر</h3><p>موقع تعليمي يشرح التشفير ويتيح لك التجربة بنفسك. هذه جولة سريعة تعرّفك على كل شيء في نصف دقيقة.</p></div><div class="tr-s"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><rect x="18" y="92" width="264" height="44" rx="22" fill="#0b1030" stroke="#7c5cff" stroke-opacity=".5"/><g fill="#93a0c9"><circle cx="50" cy="114" r="8"/><circle cx="90" cy="114" r="8"/><circle cx="210" cy="114" r="8"/><circle cx="250" cy="114" r="8"/></g><rect class="tr-p" x="118" y="98" width="64" height="32" rx="16" fill="#7c5cff"/><circle cx="136" cy="114" r="7" fill="#fff"/><rect x="148" y="111" width="24" height="6" rx="3" fill="#fff" opacity=".8"/><path d="M150 38v34m0 0l-9-10m9 10l9-10" fill="none" stroke="#fde68a" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></div><h3>القائمة السفلية</h3><p>من الشريط في أسفل الشاشة تنتقل إلى أي قسم: الأساسيات، الكتاب، المختبر، المهام وغيرها. اسحبه يميناً ويساراً لترى كل الأقسام.</p></div><div class="tr-s"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><path d="M120 92c0-26 8-46 30-46s30 20 30 46l10 12H110z" fill="#fde68a"/><circle cx="150" cy="114" r="8" fill="#fbbf24"/><circle cx="182" cy="48" r="14" fill="#ef4444"/><text x="182" y="53" text-anchor="middle" font-size="15" font-weight="800" fill="#fff" font-family="Tajawal,sans-serif">3</text><rect x="30" y="40" width="64" height="22" rx="7" fill="#fb7185" fill-opacity=".25" stroke="#fb7185"/><rect x="38" y="48" width="40" height="5" rx="2.5" fill="#fb7185"/><rect x="206" y="88" width="64" height="22" rx="7" fill="#22d3ee" fill-opacity=".2" stroke="#22d3ee"/><rect x="214" y="96" width="36" height="5" rx="2.5" fill="#22d3ee"/></svg></div><h3>التبليغات</h3><p>أي رسالة يرسلها المشرف من بوت تلجرام تظهر هنا كتبليغ، مثل موعد امتحان. الدائرة الحمراء في القائمة تخبرك بعدد التبليغات الجديدة.</p></div><div class="tr-s"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><g font-family="Courier New" font-weight="800" font-size="14" text-anchor="middle"><rect x="20" y="48" width="70" height="40" rx="10" fill="#34f5b822" stroke="#34f5b8"/><text x="55" y="73" fill="#34f5b8">Hello</text><rect x="115" y="48" width="70" height="40" rx="10" fill="#fde68a22" stroke="#fde68a"/><text x="150" y="73" fill="#fde68a">🔑 DES</text><rect x="210" y="48" width="70" height="40" rx="10" fill="#fca5a522" stroke="#fca5a5"/><text x="245" y="73" fill="#fca5a5">X9#k2</text></g><path d="M94 68h16M189 68h16" stroke="#22d3ee" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 5"/><text x="150" y="124" text-anchor="middle" font-size="13" fill="#93a0c9" font-family="Tajawal,sans-serif">نص ← مفتاح ← نص مشفّر</text></svg></div><h3>المختبر والمهام</h3><p>اكتب نصاً واختر الخوارزمية ثم اضغط «تشفير» أو «فك التشفير». وفي المهام تحصل على حل التمارين خطوة بخطوة.</p></div><div class="tr-s"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><rect x="48" y="24" width="70" height="94" rx="8" fill="#fff" fill-opacity=".92"/><path d="M62 48h42M62 64h42M62 80h26" stroke="#7c5cff" stroke-width="4" stroke-linecap="round"/><path d="M130 76h44" stroke="#22d3ee" stroke-width="4" stroke-linecap="round" stroke-dasharray="3 7"/><path d="M264 40L192 76l24 7 7 24z" fill="#22d3ee"/><path d="M264 40L216 83" stroke="#0b1030" stroke-width="2"/></svg></div><h3>تسليم الملفات</h3><p>صوّر ورقتك أو ارفع ملفك من زر التسليم. يُحفظ على جهازك ويصل إلى المشرف تلقائياً حتى لو انقطع الإنترنت.</p></div><div class="tr-s"><div class="tr-img"><svg viewBox="0 0 300 150" aria-hidden="true"><circle cx="150" cy="56" r="30" fill="none" stroke="#7c5cff" stroke-width="12" stroke-dasharray="10.5 7.9"/><circle cx="150" cy="56" r="23" fill="#0b1030" stroke="#22d3ee" stroke-width="3"/><circle cx="150" cy="56" r="9" fill="#22d3ee"/><circle cx="96" cy="122" r="11" fill="#7c5cff"/><circle cx="128" cy="122" r="11" fill="#16a34a"/><circle cx="160" cy="122" r="11" fill="#dc2626"/><circle cx="192" cy="122" r="11" fill="#2563eb"/><text x="224" y="128" fill="#93a0c9" font-size="16" font-weight="800" font-family="Tajawal,sans-serif">Aa</text></svg></div><h3>الإعدادات والمساعدة</h3><p>زر الترس يغيّر لون الموقع وحجم الخط والصوت. وإذا نسيت شيئاً فاضغط «الدليل» في القائمة لتعيد هذه الجولة.</p></div><div class="tr-dots"><i class="on"></i><i></i><i></i><i></i><i></i><i></i></div><div class="tr-nav"><button class="btn btn-ghost" id="trPrev" type="button">السابق</button><button class="btn btn-enc" id="trNext" type="button">التالي</button></div><button class="tr-skip" id="trSkip" type="button">تخطّي الجولة</button></div></div>
<script>
/* ===== التبليغات (من بوت تلجرام) + جولة الشرح ===== */
(function(){
var ANN={
 TOKEN:RK_TOK,
 ADMIN:atob('RzBfOWs='), // حساب المشرف: اسم المستخدم أو الرقم التعريفي. فقط رسائله تظهر كتبليغات
 ENDPOINT:'',  // اختياري: رابط Worker يحفظ التبليغات لوقت أطول (انظر الشرح)
 MAX:60
};
var $=function(i){return document.getElementById(i)},K='rk_ann',SK='rk_ann_seen',list=[],seen=+ls(SK)||0,del={},clr=+ls('rk_ann_clr')||0,busy=false,lastOk=0,first=true;
function ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){}return null}
try{list=JSON.parse(ls(K)||'[]')}catch(e){list=[]}
try{del=JSON.parse(ls('rk_ann_del')||'{}')||{}}catch(e){del={}}
var pins={},pcmd=+ls('rk_ann_pcmd')||0;try{pins=JSON.parse(ls('rk_ann_pin')||'{}')||{}}catch(e){pins={}}
var showAll=false,furl={},fres={};
function mid(m){return m.chat.id+':'+(m.media_group_id?'g'+m.media_group_id:m.message_id)}
function fid(m){if(m.photo&&m.photo.length){var q=m.photo.filter(function(p){return p.width>=640})[0]||m.photo[m.photo.length-1];return q.file_id}return m.document&&/^image\//.test(m.document.mime_type||'')?m.document.file_id:''}
function gurl(f,force){if(/^(https?:|data:)/.test(f)){fres[f]=f;return Promise.resolve(f)}if(furl[f]&&!force)return furl[f];return furl[f]=fetch(RK_TG+'/bot'+ANN.TOKEN+'/getFile?file_id='+encodeURIComponent(f)).then(function(r){return r.json()}).then(function(j){if(!j.ok)throw 0;return fres[f]=RK_TG+'/file/bot'+ANN.TOKEN+'/'+j.result.file_path}).catch(function(e){delete furl[f];throw e})}
function bad(im){var d=document.createElement('div');d.className='an-em';d.style.padding='.8rem';d.textContent='تعذر تحميل الصورة';im.replaceWith(d)}
function hyd(){[].forEach.call($('anList').querySelectorAll('img[data-f]'),function(im){var f=im.dataset.f;
 im.onerror=function(){im.onerror=null;gurl(f,true).then(function(u){im.onerror=function(){bad(im)};im.src=u}).catch(function(){bad(im)})};
 if(!im.getAttribute('src'))gurl(f).then(function(u){im.src=u}).catch(function(){bad(im)})})}
function imgs(a){var k=a.imgs||[];if(!k.length)return'';return'<div class="an-imgs'+(k.length>1?' m':'')+'">'+k.map(function(f){return'<img class="an-img" data-f="'+esc(f)+'"'+(fres[f]?' src="'+fres[f]+'"':'')+' alt="صورة التبليغ" loading="lazy">'}).join('')+'</div>'}
function lb(u){$('anLb').firstElementChild.src=u;$('anLb').classList.add('on')}
function keep(a){return !del[a.id]&&(a.t>clr||pins[a.id])}
function sv(){ls('rk_ann_del',JSON.stringify(del));ls('rk_ann_clr',String(clr));ls('rk_ann_pin',JSON.stringify(pins));ls(K,JSON.stringify(list))}
list=list.filter(keep);
function esc(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
var TY=[[/امتحان|اختبار|كويز|quiz|exam/i,'#fb7185','fa-file-pen'],[/واجب|تسليم|مهمة|مهام|تقرير|مشروع/,'#fbbf24','fa-list-check'],[/محاضرة|دوام|تأجيل|إلغاء|الغاء|موعد|قاعة|عطلة/,'#22d3ee','fa-calendar-day'],[/عاجل|مهم|تنبيه/,'#f87171','fa-triangle-exclamation']];
function ty(t){for(var i=0;i<TY.length;i++)if(TY[i][0].test(t))return TY[i];return[0,'#a5b4fc','fa-bullhorn']}
function ago(t){var s=(Date.now()-t)/1000;if(s<60)return'الآن';if(s<3600)return'قبل '+(s/60|0)+' دقيقة';if(s<86400)return'قبل '+(s/3600|0)+' ساعة';return new Date(t).toLocaleDateString('ar-IQ',{day:'numeric',month:'long'})}
function badge(){var n=list.filter(function(a){return a.t>seen}).length;[].forEach.call(document.querySelectorAll('.dk-n'),function(b){b.dataset.n=n;b.textContent=n>9?'9+':n})}
function render(){
 var h=list.length?'':'<div class="an-em"><i class="fa-regular fa-bell"></i>لا توجد تبليغات حالياً.<br>عندما يرسل المشرف رسالة ستظهر هنا تلقائياً.</div>';
 list.sort(function(a,b){return(pins[b.id]?1:0)-(pins[a.id]?1:0)||b.t-a.t});
 list.forEach(function(a,i){if(!showAll&&i>=5)return;var p=a.text.split('\n'),T=ty(a.text),n=a.t>seen,b=p.slice(1).join('\n').trim();
  h+='<article class="an-it'+(n?' new':'')+(pins[a.id]?' pin':'')+'" style="--c:'+T[1]+'"><div class="an-ic"><i class="fa-solid '+T[2]+'"></i></div><div class="an-b"><div class="an-t">'+esc(p[0]||'صورة')+'</div>'+(b?'<div class="an-x">'+esc(b)+'</div>':'')+imgs(a)+'<div class="an-m">'+(pins[a.id]?'<span class="an-pn">📌 مثبت</span>':'')+(n?'<span class="an-nw">جديد</span>':'')+'<span>'+ago(a.t)+'</span><button type="button" class="an-pb" data-p="'+i+'" aria-label="'+(pins[a.id]?'إلغاء التثبيت':'تثبيت')+'"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="an-del" data-i="'+i+'" aria-label="حذف التبليغ"><i class="fa-regular fa-trash-can"></i></button></div></div></article>'});
 if(list.length>5)h+='<button type="button" class="btn btn-ghost" id="anMore" style="width:100%">'+(showAll?'عرض أقل':'عرض الكل ('+list.length+')')+'</button>';
 $('anList').innerHTML=h;hyd();$('anClr').style.display=list.length?'':'none';badge();
 $('anSt').textContent=lastOk?'آخر تحديث: '+ago(lastOk):(navigator.onLine?'':'لا يوجد إنترنت — تظهر التبليغات المحفوظة على جهازك.')}
async function pull(){
 if(busy)return;if(!navigator.onLine){render();return}
 busy=true;$('anRef').classList.add('spin');var ok=false;
 try{
  var add=[],pmax=0,fbOk=false,fbIds={};
  /* --- Firebase (الأساسي حالياً) --- */
  if(window.RK_FB){try{var fa=rkList(await rkFbGet('ann'));
   fa.forEach(function(x){if(!x||x.hide)return;var id='fb:'+x.id,im=[].concat(x.imgs?(Array.isArray(x.imgs)?x.imgs:Object.keys(x.imgs).map(function(k){return x.imgs[k]})):[],x.img?[x.img]:[]).map(rkFixUrl).filter(Boolean);
    var tx=String(x.text||'').trim();if(!tx&&!im.length)return;
    if(x.pin&&!list.some(function(a){return a.id===id}))pins[id]=1;
    fbIds[id]=1;add.push({id:id,t:rkFbTime(x.id,x),text:tx,imgs:im})});fbOk=true}catch(e){}}
  if(fbOk)list=list.filter(function(a){return String(a.id).indexOf('fb:')!==0||fbIds[a.id]});
  /* --- البوت (احتياطي: يشتغل إذا انفتح الحظر) --- */
  if(ANN.ENDPOINT){var r0=await fetch(ANN.ENDPOINT,{cache:'no-store'});add=(await r0.json()).map(function(x){return{id:String(x.id),t:+x.t,text:String(x.text||'')}})}
  else{
   try{
   var r=await fetch(RK_TG+'/bot'+ANN.TOKEN+'/getUpdates?limit=100&allowed_updates='+encodeURIComponent('["message","edited_message"]'),{signal:rkTmo(9000)}),j=await r.json();
   if(!j.ok)throw 0;
   var ms=j.result.map(function(u){return u.message||u.edited_message}).filter(function(m){return m&&m.chat&&m.chat.type==='private'});
   var adm=String(ANN.ADMIN||ls('rk_cid')||(ms[0]&&ms[0].chat.id)||'').replace(/^@/,'').toLowerCase();
   ms.forEach(function(m){var x=(m.text||m.caption||'').trim(),f=fid(m);if(!adm||(String(m.chat.id)!==adm&&String((m.from&&m.from.username)||'').toLowerCase()!==adm)||(!x&&!f))return;
    if(x&&x[0]==='/'){var c=x.split(/[\s@]/)[0].toLowerCase();if(c==='/clear')clr=Math.max(clr,m.date*1000);else if(c==='/del'&&m.reply_to_message)del[mid(m.reply_to_message)]=1;else if((c==='/pin'||c==='/unpin')&&m.reply_to_message&&m.date*1000>pcmd){if(c==='/pin')pins[mid(m.reply_to_message)]=1;else delete pins[mid(m.reply_to_message)];pmax=Math.max(pmax,m.date*1000)}return}
    var id=mid(m),o=add.filter(function(a){return a.id===id})[0];if(o){if(f&&o.imgs.indexOf(f)<0)o.imgs.push(f);if(x&&!o.text)o.text=x;return}add.push({id:id,t:m.date*1000,text:x,imgs:f?[f]:[]})})
   }catch(e){if(!fbOk)throw e}
  }
  var old={};list.forEach(function(a){old[a.id]=1});
  var map={};(ANN.ENDPOINT?add:list.concat(add)).forEach(function(a){var o=map[a.id];if(o&&o.imgs&&a.imgs)a.imgs=o.imgs.concat(a.imgs.filter(function(q){return o.imgs.indexOf(q)<0}));map[a.id]=a});
  list=Object.keys(map).map(function(k){return map[k]}).filter(keep).sort(function(a,b){return b.t-a.t}).slice(0,ANN.MAX);
  if(pmax>pcmd){pcmd=pmax;ls('rk_ann_pcmd',String(pmax))}
  sv();lastOk=Date.now();ok=true;
  var nw=list.filter(function(a){return !old[a.id]&&a.t>seen});
  if(!first&&nw.length&&window.showToast)showToast('تبليغ جديد: '+(nw[0].text||'صورة').split('\n')[0].slice(0,60),'fa-bell text-amber-300')
 }catch(e){}
 busy=false;first=false;$('anRef').classList.remove('spin');render();
 if(!ok&&navigator.onLine)$('anSt').textContent='تعذر التحديث الآن — تظهر آخر التبليغات المحفوظة على جهازك.'
}
function introUp(){var e=$('rkIntro');if(!e||!e.isConnected)return false;var c=getComputedStyle(e);return c.display!=='none'&&c.visibility!=='hidden'&&!e.classList.contains('out')}
var mt=0;function markRead(){if(introUp())return;var m=list.reduce(function(a,b){return Math.max(a,b.t)},0);if(m>seen){seen=m;ls(SK,String(m));badge()}}
if('IntersectionObserver'in window)new IntersectionObserver(function(e){clearTimeout(mt);if(e[0].isIntersecting)mt=setTimeout(markRead,1500)},{rootMargin:'0px 0px -30% 0px'}).observe($('annSec'));
$('anRef').onclick=pull;
$('anList').onclick=function(e){var im=e.target.closest('.an-img');if(im&&im.getAttribute('src')){lb(im.src);return}if(e.target.closest('#anMore')){showAll=!showAll;render();return}var pb=e.target.closest('.an-pb');if(pb){var q=list[+pb.dataset.p];if(q){if(pins[q.id]){delete pins[q.id]}else{pins[q.id]=1}sv();render();window.showToast&&showToast(pins[q.id]?'تم تثبيت التبليغ':'أُلغي التثبيت','fa-thumbtack text-amber-300')}return}var b=e.target.closest('.an-del');if(!b)return;var a=list[+b.dataset.i];if(!a)return;del[a.id]=1;list=list.filter(keep);sv();render();window.showToast&&showToast('تم حذف التبليغ من جهازك','fa-trash-can text-rose-300')};
$('anLb').onclick=function(){this.classList.remove('on');this.firstElementChild.removeAttribute('src')};
document.addEventListener('keydown',function(e){if(e.key==='Escape')$('anLb').click()});
$('anClr').onclick=function(){if(!list.length||!confirm('حذف كل التبليغات من جهازك؟'))return;clr=Math.max(clr,list.reduce(function(a,b){return Math.max(a,b.t)},0));list=list.filter(function(a){return pins[a.id]});sv();render()};
document.addEventListener('visibilitychange',function(){if(!document.hidden)pull()});
window.addEventListener('online',pull);window.addEventListener('offline',render);
setInterval(function(){if(!document.hidden)pull()},60000);
render();pull();

/* ----- جولة الشرح ----- */
var tr=$('trOv'),n=0,sl=[].slice.call(tr.querySelectorAll('.tr-s')),dt=[].slice.call(tr.querySelectorAll('.tr-dots i')),N=sl.length;
function go(i){n=Math.max(0,Math.min(N-1,i));sl.forEach(function(s,k){s.classList.toggle('on',k===n)});dt.forEach(function(d,k){d.classList.toggle('on',k===n)});
 $('trPrev').style.visibility=n?'visible':'hidden';
 $('trNext').innerHTML=n===N-1?'ابدأ الاستخدام <i class="fa-solid fa-check"></i>':'التالي <i class="fa-solid fa-chevron-left"></i>'}
function openT(){go(0);tr.classList.add('on');$('trNext').focus()}
function closeT(){tr.classList.remove('on');ls('rk_tour','1')}
$('trNext').onclick=function(){n===N-1?closeT():go(n+1)};$('trPrev').onclick=function(){go(n-1)};$('trSkip').onclick=closeT;$('dkHelp').onclick=openT;$('hdHelp').onclick=openT;
document.addEventListener('keydown',function(e){if(!tr.classList.contains('on'))return;if(e.key==='Escape')closeT();if(e.key==='ArrowLeft')go(n+1);if(e.key==='ArrowRight')go(n-1)});
var x0=0;tr.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
tr.addEventListener('touchend',function(e){var d=e.changedTouches[0].clientX-x0;if(Math.abs(d)>50)go(n+(d>0?1:-1))});
if(!ls('rk_tour')){var w=setInterval(function(){if(!introUp()){clearInterval(w);setTimeout(openT,600)}},400)}
})();
</script>


<style>/* ===== RK addon: files, drawer, admin ===== */
#rkMenu{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));right:12px;z-index:58;width:46px;height:46px;border-radius:14px;border:1px solid var(--border);background:rgba(11,16,48,.9);color:#fff;font-size:1.1rem;cursor:pointer;backdrop-filter:blur(10px);display:grid;place-items:center;transition:transform .25s,background .25s}
#rkMenu:hover{background:var(--accent);transform:scale(1.06)}
#rkOv{position:fixed;inset:0;z-index:90;background:rgba(2,4,15,.6);opacity:0;visibility:hidden;transition:opacity .3s,visibility 0s .3s}
#rkDrawer{position:fixed;top:0;bottom:0;right:0;z-index:91;width:min(310px,86vw);background:#0b1030;border-left:1px solid var(--border);padding:max(16px,env(safe-area-inset-top)) 14px 16px;display:flex;flex-direction:column;gap:6px;transform:translateX(105%);transition:transform .34s cubic-bezier(.22,.8,.3,1);will-change:transform;overflow-y:auto;box-shadow:-20px 0 50px rgba(0,0,0,.5)}
body.rk-dr #rkDrawer{transform:none}
body.rk-dr #rkOv{opacity:1;visibility:visible;transition:opacity .3s}
#rkDrawer .dh{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;font-weight:900;color:#fff}
#rkDrawer .dh button{background:0;border:0;color:var(--muted);font-size:1.2rem;cursor:pointer}
#rkDrawer a,#rkDrawer .di{display:flex;align-items:center;gap:.7rem;padding:.75rem .9rem;border-radius:12px;color:#cdd5ff;font-weight:700;font-size:.92rem;text-decoration:none;cursor:pointer;border:0;background:0;font-family:inherit;text-align:right;opacity:0;transform:translateX(18px);transition:background .2s,opacity .35s,transform .35s}
body.rk-dr #rkDrawer a,body.rk-dr #rkDrawer .di{opacity:1;transform:none}
body.rk-dr #rkDrawer>*:nth-child(2){transition-delay:.05s}body.rk-dr #rkDrawer>*:nth-child(3){transition-delay:.09s}body.rk-dr #rkDrawer>*:nth-child(4){transition-delay:.13s}body.rk-dr #rkDrawer>*:nth-child(5){transition-delay:.17s}body.rk-dr #rkDrawer>*:nth-child(6){transition-delay:.21s}body.rk-dr #rkDrawer>*:nth-child(7){transition-delay:.25s}body.rk-dr #rkDrawer>*:nth-child(8){transition-delay:.29s}
#rkDrawer a:hover,#rkDrawer .di:hover{background:rgba(124,92,255,.2);color:#fff}
#rkDrawer i{color:var(--accent2);width:20px;text-align:center}
#rkDrawer hr{border:0;border-top:1px solid var(--border);margin:6px 0}
.fl-bar{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.8rem 0}
.fl-bar .field{flex:1;min-width:150px;padding:.55rem .9rem;font-size:.85rem}
.fl-chip{padding:.4rem .9rem;border-radius:999px;border:1px solid var(--border);background:rgba(124,92,255,.1);color:#cdd5ff;font:700 .78rem inherit;font-family:inherit;cursor:pointer;transition:.2s}
.fl-chip.on{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-color:transparent}
.fl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.8rem}
.fl-it{display:flex;gap:.8rem;padding:.9rem;border-radius:16px;border:1px solid var(--border);background:rgba(124,92,255,.07);transition:transform .2s,border-color .2s;animation:fade .4s both}
.fl-it:hover{transform:translateY(-3px);border-color:var(--accent)}
.fl-ic{flex:0 0 46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:1.3rem;color:#fff;background:var(--c,#7c5cff)}
.fl-nm{font-weight:800;font-size:.88rem;color:#fff;word-break:break-word;direction:ltr;text-align:right}
.fl-mt{font-size:.72rem;color:var(--muted);margin:.2rem 0 .5rem}
.fl-it a{font-size:.75rem;font-weight:800;color:var(--accent2);text-decoration:none;cursor:pointer}
#flRef.spin i{animation:flsp .8s linear infinite}@keyframes flsp{to{transform:rotate(360deg)}}
#rkAdmin{position:fixed;inset:0;z-index:99;display:none;align-items:center;justify-content:center;background:rgba(2,4,15,.8);padding:12px}
#rkAdmin.on{display:flex;animation:fade .25s both}
#rkAdmin .bx{width:min(520px,100%);max-height:90dvh;overflow:auto;background:#0e1430;border:1px solid var(--border);border-radius:22px;padding:1.1rem}
#rkAdmin h4{font-weight:900;color:#fff;margin:.9rem 0 .4rem;font-size:.9rem}
#rkAdmin .row{display:flex;flex-wrap:wrap;gap:.5rem}
#rkAdmin label.sw{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:#cdd5ff;padding:.3rem 0}
body.rk-edit [data-rk-e]{outline:1px dashed var(--accent2);outline-offset:2px;cursor:text}
@media(prefers-reduced-motion:reduce){#rkDrawer,#rkOv,#rkDrawer a,#rkDrawer .di{transition:none}}
.fl-act{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center}
.fl-act button{background:0;border:0;font:800 .75rem inherit;font-family:inherit;cursor:pointer;padding:0;color:var(--accent2)}
.fl-act .x{color:#fb7185}.fl-act .s{color:#fbbf24}
.al-feat{position:relative;border-radius:22px;overflow:hidden;aspect-ratio:16/9;max-height:460px;width:100%;margin-bottom:1rem;background:#060a1c;border:1px solid var(--border);cursor:zoom-in}
.al-feat img{width:100%;height:100%;object-fit:cover;transition:transform .8s}.al-feat:hover img{transform:scale(1.04)}
.al-feat .cp{position:absolute;inset:auto 0 0 0;padding:2.4rem 1.2rem 1rem;background:linear-gradient(transparent,rgba(2,4,15,.92));color:#fff}
.al-feat .st{position:absolute;top:12px;right:12px;background:linear-gradient(135deg,#f59e0b,#fb7185);color:#fff;font:800 .72rem inherit;padding:.3rem .8rem;border-radius:999px}
.al-grid{columns:2;column-gap:.7rem}@media(min-width:700px){.al-grid{columns:3}}@media(min-width:1000px){.al-grid{columns:4}}
.al-ph{position:relative;break-inside:avoid;margin-bottom:.7rem;border-radius:16px;overflow:hidden;background:linear-gradient(110deg,#0b1030 30%,#1a2150 50%,#0b1030 70%);background-size:200% 100%;animation:alsh 1.4s infinite;min-height:120px;cursor:zoom-in;border:1px solid var(--border)}
.al-ph.ok{animation:fade .5s both;background:#060a1c}
@keyframes alsh{to{background-position:-200% 0}}
.al-ph img{display:block;width:100%;transition:transform .5s}.al-ph:hover img{transform:scale(1.05)}
.al-ph .cp{position:absolute;inset:auto 0 0 0;padding:1.6rem .7rem .5rem;font-size:.75rem;font-weight:700;color:#fff;background:linear-gradient(transparent,rgba(2,4,15,.9));opacity:0;transform:translateY(8px);transition:.3s}
.al-ph:hover .cp,.al-ph:focus-within .cp{opacity:1;transform:none}
.al-ph .ad{position:absolute;top:6px;left:6px;display:flex;gap:4px}
.al-ph .ad button{width:30px;height:30px;border-radius:9px;border:0;background:rgba(2,4,15,.8);color:#fbbf24;cursor:pointer}
.al-ph .ad .x{color:#fb7185}
#rkLb{position:fixed;inset:0;z-index:98;background:rgba(2,4,15,.95);display:none;flex-direction:column;align-items:center;justify-content:center;gap:.8rem;padding:14px}
#rkLb.on{display:flex;animation:fade .25s both}#rkLb img{max-width:100%;max-height:78dvh;border-radius:14px;object-fit:contain}
#rkLb .nv{position:absolute;top:50%;width:44px;height:44px;border-radius:50%;border:1px solid var(--border);background:rgba(11,16,48,.85);color:#fff;cursor:pointer;transform:translateY(-50%)}
#rkLb .pv{right:10px}#rkLb .nx{left:10px}#rkLb .cx{position:absolute;top:12px;left:12px;background:0;border:0;color:#fff;font-size:1.6rem;cursor:pointer}
#rkLb .lc{color:#e5e9ff;text-align:center;font-size:.9rem;font-weight:700;max-width:640px}

/* ===== تعديلات: ألبوم خفيف + تثبيت التبليغات ===== */
.al-grid{display:grid!important;columns:auto!important;grid-template-columns:repeat(3,1fr);gap:.5rem}
@media(min-width:700px){.al-grid{grid-template-columns:repeat(4,1fr);gap:.7rem}}
@media(min-width:1000px){.al-grid{grid-template-columns:repeat(6,1fr)}}
.al-ph{aspect-ratio:1/1;min-height:0!important;margin-bottom:0!important;contain:layout paint}
.al-ph img{height:100%;object-fit:cover}
#alMoreW{text-align:center;margin-top:.9rem}
body.lbopen #rkOut{display:none!important}
#rkLb .cx{top:calc(env(safe-area-inset-top,0px) + 12px)!important;width:44px;height:44px;border-radius:50%;background:rgba(11,16,48,.85)!important;border:1px solid var(--border)!important;display:flex;align-items:center;justify-content:center;z-index:3;font-size:1.3rem!important}
.an-it.pin{background:rgba(251,191,36,.09);border-color:rgba(251,191,36,.5)}
.an-pn{font-size:.72rem;font-weight:800;color:#fbbf24}
.an-pb{flex:none;margin-inline-start:auto;width:42px;height:34px;border-radius:10px;border:1px solid var(--border);background:rgba(255,255,255,.05);color:var(--muted);cursor:pointer}
.an-pb+.an-del{margin-inline-start:.4rem}
.an-it.pin .an-pb,.an-pb:hover{color:#fbbf24;border-color:#fbbf24}
#alMd{position:fixed;inset:0;z-index:99;display:none;align-items:center;justify-content:center;background:rgba(2,4,15,.8);padding:12px}
#alMd.on{display:flex;animation:fade .25s both}#alMd .bx{width:min(440px,100%);background:#0e1430;border:1px solid var(--border);border-radius:22px;padding:1.1rem;display:flex;flex-direction:column;gap:.6rem}
#alPrev{max-height:200px;border-radius:12px;object-fit:cover;display:none;width:100%}
#rkDrawer .di[hidden]{display:none}
</style>
<button id="rkMenu" aria-label="القائمة" aria-expanded="false"><i class="fa-solid fa-bars"></i></button>
<div id="rkOv"></div>
<aside id="rkDrawer" aria-label="القائمة الجانبية" aria-hidden="true">
<div class="dh"><span><i class="fa-solid fa-shield-halved" style="color:var(--accent2)"></i> RK-TEAM</span><button id="rkDx" aria-label="إغلاق">✕</button></div>
<a href="#top"><i class="fa-solid fa-house"></i>الرئيسية</a>
<a href="#annSec"><i class="fa-solid fa-bell"></i>التبليغات</a>
<a href="#filesSec"><i class="fa-solid fa-folder-open"></i>ملفات البوت</a>
<a href="#sendSec"><i class="fa-solid fa-paper-plane"></i>تسليم الملفات</a>
<a href="#albumSec"><i class="fa-solid fa-images"></i>ألبوم الذكريات</a>
<a href="#lab"><i class="fa-solid fa-microchip"></i>المختبر</a>
<hr><button class="di" id="rkAdOpen" type="button" hidden><i class="fa-solid fa-sliders"></i>لوحة التحكم</button>
</aside>
<div id="rkAdmin" role="dialog" aria-label="لوحة التحكم"><div class="bx">
<div style="display:flex;justify-content:space-between;align-items:center"><b style="color:#fff;font-size:1.05rem"><i class="fa-solid fa-sliders" style="color:var(--accent2)"></i> لوحة التحكم</b><button class="btn btn-ghost" id="adX" type="button">إغلاق</button></div>
<h4>✏️ تعديل النصوص من الصفحة</h4>
<p class="text-xs" style="color:var(--muted)">فعّل الوضع ثم اضغط على أي عنوان أو فقرة واكتب. التعديلات تُحفظ تلقائياً على هذا الجهاز.</p>
<div class="row"><button class="btn btn-ghost" id="adEdit" type="button">تفعيل وضع التعديل</button><button class="btn btn-ghost" id="adReset" type="button">استرجاع الأصل</button></div>
<h4>👁️ إظهار / إخفاء الأقسام</h4><div id="adSecs"></div>
<h4>💾 نسخة احتياطية</h4>
<div class="row"><button class="btn btn-ghost" id="adExp" type="button">تصدير</button><button class="btn btn-ghost" id="adImp" type="button">استيراد</button><button class="btn btn-ghost" id="adLock" type="button">🔒 قفل</button></div>
</div></div>
<div id="rkLb" role="dialog" aria-label="عرض الصورة"><button class="cx" aria-label="إغلاق">✕</button><button class="nv pv" aria-label="السابق"><i class="fa-solid fa-chevron-right"></i></button><img alt=""><button class="nv nx" aria-label="التالي"><i class="fa-solid fa-chevron-left"></i></button><div class="lc"></div></div>
<div id="alMd" role="dialog" aria-label="إضافة ذكرى"><div class="bx"><b style="color:#fff"><i class="fa-solid fa-camera" style="color:var(--accent2)"></i> أضف ذكرى للألبوم</b>
<input type="file" id="alFile" accept="image/*" class="field"><img id="alPrev" alt="">
<input class="field" id="alCap" maxlength="120" placeholder="وصف قصير (اختياري) مثل: رحلة المختبر #رحلة">
<input class="field" id="alBy" maxlength="40" placeholder="اسمك (اختياري)">
<div class="row" style="display:flex;gap:.5rem"><button class="btn btn-enc" id="alGo" type="button" style="flex:1"><i class="fa-solid fa-cloud-arrow-up"></i> رفع</button><button class="btn btn-ghost" id="alNo" type="button">إلغاء</button></div><p class="an-st" id="alMs"></p></div></div>

<script>
(function(){
var $=function(i){return document.getElementById(i)},B=document.body,TGU=RK_TG+'/';
function ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){}return null}
function ss(k,v){try{if(v===undefined)return sessionStorage.getItem(k);sessionStorage.setItem(k,v)}catch(e){}return null}
function esc(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function toast(m,i){window.showToast&&showToast(m,i||'fa-circle-check text-emerald-400')}
function h53(s){var a=0xdeadbeef,b=0x41c6ce57;for(var i=0,c;i<s.length;i++){c=s.charCodeAt(i);a=Math.imul(a^c,2654435761);b=Math.imul(b^c,1597334677)}a=Math.imul(a^(a>>>16),2246822507)^Math.imul(b^(b>>>13),3266489909);b=Math.imul(b^(b>>>16),2246822507)^Math.imul(a^(a>>>13),3266489909);return 4294967296*(2097151&b)+(a>>>0)}
var PINH=6952587312884570,CFG=Object.assign({TOKEN:RK_TOK,CID:atob('RzBfOWs='),CHAT:RK_CHAT||''},JSON.parse(ls('rk_cfg')||'{}'));
function adm(){return ss('rk_adm')==='1'}
function chat(){return CFG.CHAT||ls('rk_chat')||ls('rk_cid')||''}
/* ---- Drawer ---- */
function dr(o){B.classList.toggle('rk-dr',o);$('rkMenu').setAttribute('aria-expanded',o);$('rkDrawer').setAttribute('aria-hidden',!o)}
$('rkMenu').onclick=function(){dr(!B.classList.contains('rk-dr'))};$('rkOv').onclick=$('rkDx').onclick=function(){dr(false)};
[].forEach.call($('rkDrawer').querySelectorAll('a'),function(a){a.onclick=function(e){e.preventDefault();dr(false);var id=a.getAttribute('href').slice(1),el=$(id);setTimeout(function(){el&&id!=='top'?el.scrollIntoView({behavior:'smooth'}):scrollTo({top:0,behavior:'smooth'})},200)}});
/* ---- Telegram API ---- */
function ph(){var p=ss('rk_pin');return p?{'X-RK-PIN':p}:{}}
async function api(m,p,fd){try{var r=await fetch(TGU+'bot'+CFG.TOKEN+'/'+m,fd?{method:'POST',body:fd,headers:ph()}:{method:'POST',headers:Object.assign({'Content-Type':'application/json'},ph()),body:JSON.stringify(p||{}),signal:rkTmo(10000)});return await r.json()}catch(e){throw new Error(m+': '+(e&&e.message||e))}}
var furl={};function gurl(f,force){if(/^(https?:|data:)/.test(String(f)))return Promise.resolve(f);if(String(f).indexOf('fb:')===0){if(furl[f]&&!force)return furl[f];return furl[f]=fbGet('albumImg/'+f.slice(3)).then(function(d){if(!d)throw 0;return d}).catch(function(e){delete furl[f];throw e})}if(furl[f]&&!force)return furl[f];return furl[f]=api('getFile',{file_id:f}).then(function(j){if(!j.ok)throw 0;return TGU+'file/bot'+CFG.TOKEN+'/'+j.result.file_path}).catch(function(e){delete furl[f];throw e})}
/* ---- Shared state (pinned JSON document in the bot chat) ---- */
var ST={files:[],del:{},album:[],feat:''},stMid=0,q=Promise.resolve();
try{ST=Object.assign(ST,JSON.parse(ls('rk_st')||'{}'))}catch(e){}
function mrg(a,b){var o={};(a||[]).concat(b||[]).forEach(function(x){o[x.id]=Object.assign(o[x.id]||{},x)});return Object.keys(o).map(function(k){return o[k]})}
function packState(){var al=ST.album.slice().sort(function(a,b){return b.t-a.t}),dl=Object.keys(ST.del).slice(-40),n=al.length,t;
 function mk(k){return'RKST1\n'+JSON.stringify({a:al.slice(0,k).map(function(x){return[x.id,x.fid,x.t,(x.cap||'').slice(0,40),(x.by||'').slice(0,20)]}),d:dl,f:ST.feat||''})}
 t=mk(n);while(t.length>3900&&n>0){n--;t=mk(n)}return t}
function unpackState(tx){var o=JSON.parse(tx.slice(6)),s={del:{},files:[],album:(o.a||[]).map(function(x){return{id:x[0],fid:x[1],t:x[2],cap:x[3],by:x[4]}}),feat:o.f||''};(o.d||[]).forEach(function(i){s.del[i]=1});return s}
async function loadState(){await fbSync();var c=chat();if(!c)return;
 function note(t){var e=$('alSt');if(e)e.textContent=t}
 try{var j=await api('getChat',{chat_id:c});if(!j.ok)throw 'getChat: '+j.description;
  var pm=j.result&&j.result.pinned_message,s;
  if(!pm){note('⚠️ ما في رسالة مثبتة بمحادثة البوت (ارفع صورة لتتفعل المزامنة)');return}
  if(pm.message_id===stMid)return;
  if(pm.text&&pm.text.indexOf('RKST1\n')===0){s=unpackState(pm.text)}
  else if(pm.document&&pm.document.file_name==='rk-state.json'){
   var f=await api('getFile',{file_id:pm.document.file_id});if(!f.ok)throw 'getFile: '+f.description;
   var r;try{r=await fetch(TGU+'file/bot'+CFG.TOKEN+'/'+f.result.file_path)}catch(e){throw 'تنزيل الملف القديم: '+(e&&e.message||e)}
   if(!r.ok)throw 'تنزيل الملف: '+r.status;s=await r.json()}
  else{note('⚠️ الرسالة المثبتة ليست حالة الألبوم، ألغِ تثبيتها');return}
  ST.del=Object.assign({},ST.del,s.del);ST.files=mrg(ST.files,s.files);ST.album=mrg(ST.album,s.album);ST.feat=s.feat||'';stMid=pm.message_id;clean();ls('rk_st',JSON.stringify(ST));
  note('✓ تمت المزامنة · '+ST.album.length+' صورة بالألبوم')}
 catch(e){note('⚠️ المزامنة: '+(e&&e.message||e))}}
function clean(){ST.files=ST.files.filter(function(f){return!ST.del[f.id]});ST.album=ST.album.filter(function(f){return!ST.del[f.id]});if(ST.del[ST.feat])ST.feat=''}
function save(mut){q=q.then(async function(){await loadState();mut(ST);clean();ST.files=ST.files.sort(function(a,b){return b.t-a.t}).slice(0,300);ls('rk_st',JSON.stringify(ST));renderAll();fbSync();
 var c=chat();if(!c){toast('محفوظ على هذا الجهاز فقط: Chat ID غير معروف','fa-triangle-exclamation text-amber-300');return}
 try{var j=await api('sendMessage',{chat_id:c,text:packState(),disable_notification:true});if(!j.ok)throw (j.description||'sendMessage');var old=stMid;stMid=j.result.message_id;
  var pj=await api('pinChatMessage',{chat_id:c,message_id:stMid,disable_notification:true});if(!pj.ok)throw ('pin: '+pj.description);if(old)api('deleteMessage',{chat_id:c,message_id:old})}
 catch(e){$('alSt').textContent='⚠️ تعذرت المزامنة مع الجميع: '+(e&&e.message||e);toast('تعذر المزامنة مع الجميع الآن','fa-triangle-exclamation text-amber-300')}}).catch(function(){})}
/* ---- Files ---- */
var flt='',qs='',busy=false;
var IC={img:['fa-image','#0ea5e9'],pdf:['fa-file-pdf','#ef4444'],doc:['fa-file-word','#2563eb'],xls:['fa-file-excel','#16a34a'],zip:['fa-file-zipper','#f59e0b'],vid:['fa-film','#a855f7'],aud:['fa-music','#ec4899'],oth:['fa-file','#7c5cff']};
function kind(f){var n=(f.name||'').toLowerCase(),m=f.mime||'';if(f.type==='photo'||/^image\//.test(m))return'img';if(f.type==='video'||/^video\//.test(m))return'vid';if(f.type==='voice'||f.type==='audio'||/^audio\//.test(m))return'aud';if(/\.pdf$/.test(n))return'pdf';if(/\.(docx?|txt|rtf|pptx?)$/.test(n))return'doc';if(/\.(xlsx?|csv)$/.test(n))return'xls';if(/\.(zip|rar|7z)$/.test(n))return'zip';return'oth'}
function grp(k){return k==='img'?'img':(k==='pdf'||k==='doc'||k==='xls')?'doc':'oth'}
function sz(b){if(!b)return'';return b>1048576?(b/1048576).toFixed(1)+' MB':Math.max(1,Math.round(b/1024))+' KB'}
function ago(t){var s=(Date.now()-t)/1000;if(s<60)return'الآن';if(s<3600)return'قبل '+(s/60|0)+' دقيقة';if(s<86400)return'قبل '+(s/3600|0)+' ساعة';return new Date(t).toLocaleDateString('ar-IQ',{day:'numeric',month:'long'})}
function renderFiles(){var l=ST.files.filter(function(f){return(!flt||grp(kind(f))===flt)&&(!qs||(f.name||'').toLowerCase().indexOf(qs)>=0)}),A=adm();
 $('flGrid').innerHTML=l.length?l.map(function(f){var k=kind(f),c=IC[k],inA=ST.album.some(function(a){return a.id===f.id});
  return'<div class="fl-it" style="--c:'+c[1]+'"><div class="fl-ic"><i class="fa-solid '+c[0]+'"></i></div><div style="min-width:0;flex:1"><div class="fl-nm">'+esc(f.name)+'</div><div class="fl-mt">'+[sz(f.size),ago(f.t)].filter(Boolean).join(' · ')+'</div><div class="fl-act"><button data-d="'+esc(f.fid)+'"><i class="fa-solid fa-download"></i> تنزيل</button>'+
  (A?(k==='img'&&!inA?'<button class="s" data-al="'+esc(f.id)+'"><i class="fa-solid fa-images"></i> للألبوم</button>':'')+'<button class="x" data-rm="'+esc(f.id)+'"><i class="fa-solid fa-trash"></i> حذف للكل</button>':'')+'</div></div></div>'}).join(''):'<div class="an-em" style="grid-column:1/-1"><i class="fa-regular fa-folder-open"></i>لا توجد ملفات بعد. أرسل ملفاً للبوت وسيظهر هنا.</div>'}
$('flGrid').onclick=async function(e){var b=e.target.closest('button');if(!b)return;
 if(b.dataset.d){try{var u=await gurl(b.dataset.d);window.open(u,'_blank','noopener')}catch(x){toast('تعذر فتح الملف (الحد 20MB لبوتات تلغرام)','fa-triangle-exclamation text-amber-300')}}
 else if(b.dataset.rm&&adm()){if(!confirm('حذف هذا الملف للجميع؟'))return;var id=b.dataset.rm,c=chat(),mid=id.split(':')[1];save(function(s){s.del[id]=1});if(c&&mid)api('deleteMessage',{chat_id:c,message_id:+mid}).catch(function(){})}
 else if(b.dataset.al&&adm()){var f=ST.files.filter(function(x){return x.id===b.dataset.al})[0];if(f)save(function(s){s.album.push({id:f.id,fid:f.fid,t:f.t,cap:f.cap||''})});toast('أُضيفت للألبوم','fa-images text-amber-300')}};
[].forEach.call(document.querySelectorAll('.fl-chip'),function(c){c.onclick=function(){flt=c.dataset.k;[].forEach.call(document.querySelectorAll('.fl-chip'),function(x){x.classList.toggle('on',x===c)});renderFiles()}});
$('flQ').oninput=function(){qs=this.value.trim().toLowerCase();renderFiles()};
async function pull(){if(busy)return;if(!navigator.onLine){renderAll();return}busy=true;$('flRef').classList.add('spin');
 var fbF=false;
 if(window.RK_FB){try{var ff=rkList(await rkFbGet('files')),ids={},fl=[];
  ff.forEach(function(x){if(!x||x.hide)return;var u=rkFixUrl(x.url||x.link);if(!u)return;var id='fb:'+x.id,nm=String(x.name||x.title||'ملف');ids[id]=1;
   fl.push({id:id,fid:u,t:rkFbTime(x.id,x),type:x.type||'doc',mime:x.mime||'',size:+x.size||0,cap:String(x.cap||x.desc||''),name:nm})});
  ST.files=ST.files.filter(function(f){return String(f.id).indexOf('fb:')!==0||ids[f.id]});
  fl.forEach(function(f){var o=ST.files.filter(function(z){return z.id===f.id})[0];if(o)Object.assign(o,f);else ST.files.push(f)});
  ST.files.sort(function(a,b){return b.t-a.t});ls('rk_st',JSON.stringify(ST));fbF=true;$('flSt').textContent='آخر تحديث: الآن';renderAll()}catch(e){}}
 try{await loadState();var r=await fetch(TGU+'bot'+CFG.TOKEN+'/getUpdates?limit=100&allowed_updates='+encodeURIComponent('["message","channel_post"]'),{signal:rkTmo(9000)}),j=await r.json();if(!j.ok)throw 0;
  var a=String(CFG.CID||'').replace(/^@/,'').toLowerCase(),add=[];
  j.result.forEach(function(u){var m=u.message||u.channel_post;if(!m||!m.chat)return;
   if(a&&String(m.chat.id)!==a&&String((m.from&&m.from.username)||'').toLowerCase()!==a)return;
   if(m.chat.type==='private'&&!chat())ls('rk_chat',String(m.chat.id));
   var d=m.document,p=m.photo&&m.photo[m.photo.length-1],v=m.video,x=m.audio||m.voice,o=d||v||x||p;if(!o)return;
   var type=d?'doc':v?'video':m.audio?'audio':m.voice?'voice':'photo',cap=(m.caption||'').trim();
   add.push({id:m.chat.id+':'+m.message_id,fid:o.file_id,t:m.date*1000,type:type,mime:o.mime_type||'',size:o.file_size||0,cap:cap,name:o.file_name||cap.split('\n')[0].slice(0,60)||({photo:'صورة',video:'فيديو',voice:'رسالة صوتية',audio:'صوت'}[type]||'ملف')})});
  add=add.filter(function(f){return!ST.del[f.id]});
  var known={};ST.files.forEach(function(f){known[f.id]=1});var fresh=add.filter(function(f){return!known[f.id]});
  ST.files=mrg(ST.files,add);clean();ls('rk_st',JSON.stringify(ST));
  /* صور بوسم #ذكرى تدخل الألبوم تلقائياً */
  var tagged=fresh.filter(function(f){return f.type==='photo'&&/#(ذكر|ألبوم|البوم|album)/i.test(f.cap)});
  if(adm()&&(fresh.length||tagged.length))save(function(s){s.files=mrg(s.files,fresh);tagged.forEach(function(f){if(!s.album.some(function(x){return x.id===f.id}))s.album.push({id:f.id,fid:f.fid,t:f.t,cap:f.cap})})});
  else tagged.forEach(function(f){if(!ST.album.some(function(x){return x.id===f.id}))ST.album.push({id:f.id,fid:f.fid,t:f.t,cap:f.cap})});
  $('flSt').textContent='آخر تحديث: الآن'
 }catch(e){if(!fbF)$('flSt').textContent=navigator.onLine?'تعذر التحديث الآن — تظهر الملفات المحفوظة.':'لا يوجد إنترنت — تظهر الملفات المحفوظة.'}
 busy=false;$('flRef').classList.remove('spin');renderAll()}
$('flRef').onclick=pull;
/* ---- Album ---- */
var tag='',lbi=0,lbl=[],alN=24;
function tags(c){return(c||'').match(/#[^\s#]+/g)||[]}
function albumList(){return ST.album.slice().sort(function(a,b){return(b.id===ST.feat)-(a.id===ST.feat)||b.t-a.t})}
function imgEl(f,cls){return'<img data-f="'+esc(f.fid)+'" alt="'+esc(f.cap||'ذكرى')+'" loading="lazy">'}
function renderAlbum0(){var all=albumList(),A=adm(),ts={};all.forEach(function(f){tags(f.cap).forEach(function(t){ts[t]=1})});
 var tl=Object.keys(ts);$('alTags').innerHTML=tl.length?'<button class="fl-chip'+(tag?'':' on')+'" data-t="">الكل</button>'+tl.map(function(t){return'<button class="fl-chip'+(tag===t?' on':'')+'" data-t="'+esc(t)+'">'+esc(t)+'</button>'}).join(''):'';
 var l=all.filter(function(f){return!tag||tags(f.cap).indexOf(tag)>=0});lbl=l;
 var ft=!tag&&l[0]&&l[0].id===ST.feat?l[0]:null,rest=ft?l.slice(1):l;
 $('alFeat').innerHTML=ft?'<div class="al-feat" data-o="0">'+imgEl(ft)+'<span class="st">⭐ صورة مميزة</span><div class="cp"><b>'+esc((ft.cap||'').replace(/#[^\s#]+/g,'').trim()||'ذكرى مميزة')+'</b></div></div>':'';
 $('alGrid').innerHTML=rest.length||ft?rest.slice(0,alN).map(function(f,i){var n=i+(ft?1:0);return'<div class="al-ph" data-o="'+n+'">'+imgEl(f)+'<div class="cp">'+esc((f.cap||'').replace(/#[^\s#]+/g,'').trim()||ago(f.t))+'</div>'+(A?'<div class="ad"><button data-fe="'+esc(f.id)+'" aria-label="مميزة"><i class="fa-solid fa-star"></i></button><button class="x" data-ra="'+esc(f.id)+'" aria-label="إزالة"><i class="fa-solid fa-xmark"></i></button></div>':'')+'</div>'}).join(''):'<div class="an-em"><i class="fa-regular fa-images"></i>الألبوم فارغ. كن أول من يضيف ذكرى!</div>';

 $('alMoreW').innerHTML=rest.length>alN?'<button type="button" class="btn btn-ghost" id="alMore">عرض المزيد ('+(rest.length-alN)+')</button>':'';
 hyd()}
var io='IntersectionObserver'in window?new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;io.unobserve(e.target);load(e.target)})},{rootMargin:'200px'}):null;
var bu={};
function srcFor(fid,force){
 if(bu[fid]&&!force)return Promise.resolve(bu[fid]);
 return qdo('img','readonly',function(s){return s.get(fid)}).catch(function(){return null}).then(function(r){
  if(r&&r.blob&&!force)return bu[fid]=URL.createObjectURL(r.blob);
  return gurl(fid,force).then(function(u){
   fetch(u).then(function(x){if(!x.ok)throw 0;return x.blob()}).then(function(b){if(b&&b.size)qdo('img','readwrite',function(s){return s.put({k:fid,blob:b})}).catch(function(){})}).catch(function(){});
   return u})})}
var tb={},tq=[],tr=0;
function mkThumb(b){return new Promise(function(res,rej){var u=URL.createObjectURL(b),im=new Image();im.onload=function(){var k=Math.min(1,420/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.max(1,Math.round(im.width*k));c.height=Math.max(1,Math.round(im.height*k));c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(function(t){t?res(t):rej()},'image/jpeg',.72)};im.onerror=function(){URL.revokeObjectURL(u);rej()};im.src=u})}
function thMake(fid,force){return qdo('img','readonly',function(x){return x.get('th:'+fid)}).catch(function(){return null}).then(function(r){
 if(r&&r.blob&&!force)return tb[fid]=URL.createObjectURL(r.blob);
 return srcFor(fid,force).then(function(u){return fetch(u).then(function(x){return x.blob()}).then(mkThumb).then(function(b){qdo('img','readwrite',function(x){return x.put({k:'th:'+fid,blob:b})}).catch(function(){});if(String(fid).indexOf('fb:')===0)delete furl[fid];return tb[fid]=URL.createObjectURL(b)}).catch(function(){return u})})})}
function tpump(){while(tr<3&&tq.length){(function(j){tr++;var p=thMake(j.fid,j.force),d=function(){tr--;tpump()};p.then(j.res,j.rej);p.then(d,d)})(tq.shift())}}
function thFor(fid,force){if(tb[fid]&&!force)return Promise.resolve(tb[fid]);return new Promise(function(res,rej){tq.push({fid:fid,force:force,res:res,rej:rej});tpump()})}
function load(im){var f=im.dataset.f,p=im.closest('.al-ph'),th=!!p;function ok(){if(p)p.classList.add('ok')}
 im.onload=ok;im.onerror=function(){im.onerror=null;delete bu[f];(th?thFor(f,true):srcFor(f,true)).then(function(u){im.src=u}).catch(function(){})};
 (th?thFor(f):srcFor(f)).then(function(u){im.src=u}).catch(function(){})}
function hyd(){[].forEach.call($('albumSec').querySelectorAll('img[data-f]'),function(im){io?io.observe(im):load(im)})}
$('alTags').onclick=function(e){var b=e.target.closest('[data-t]');if(b){tag=b.dataset.t;alN=24;renderAlbum()}};
function admBtn(e){var b=e.target.closest('button');if(!b||!adm())return false;
 if(b.dataset.fe){save(function(s){s.feat=s.feat===b.dataset.fe?'':b.dataset.fe})}
 else if(b.dataset.ra){if(confirm('إزالة هذه الصورة من الألبوم للجميع؟'))save(function(s){s.album=s.album.filter(function(x){return x.id!==b.dataset.ra});s.del[b.dataset.ra]=1})}else return false;return true}
$('albumSec').addEventListener('click',function(e){if(e.target.closest('#alMore')){alN+=24;renderAlbum();return}if(admBtn(e))return;var o=e.target.closest('[data-o]');if(o)openLb(+o.dataset.o)});
/* lightbox */
var Lb=$('rkLb'),li=Lb.querySelector('img');
function showLb(){var f=lbl[lbi];if(!f)return;li.removeAttribute('src');Lb.querySelector('.lc').textContent=((f.cap||'').replace(/#[^\s#]+/g,'').trim()+' '+(f.by?'· '+f.by:'')).trim();srcFor(f.fid).then(function(u){li.src=u}).catch(function(){})}
function openLb(i){lbi=i;Lb.classList.add('on');showLb()}function stepLb(d){if(!lbl.length)return;lbi=(lbi+d+lbl.length)%lbl.length;showLb()}
Lb.querySelector('.cx').onclick=function(){Lb.classList.remove('on')};Lb.querySelector('.pv').onclick=function(){stepLb(1)};Lb.querySelector('.nx').onclick=function(){stepLb(-1)};
Lb.onclick=function(e){if(e.target===Lb)Lb.classList.remove('on')};
(function(){function sy(){document.body.classList.toggle('lbopen',Lb.classList.contains('on')||$('anLb').classList.contains('on'))}[Lb,$('anLb')].forEach(function(e){if(e&&window.MutationObserver)new MutationObserver(sy).observe(e,{attributes:true,attributeFilter:['class']})})})();
var x0=0;Lb.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});Lb.addEventListener('touchend',function(e){var d=e.changedTouches[0].clientX-x0;if(Math.abs(d)>50)stepLb(d>0?-1:1)});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){dr(false);$('rkAdmin').classList.remove('on');Lb.classList.remove('on');$('alMd').classList.remove('on')}if(Lb.classList.contains('on')){if(e.key==='ArrowLeft')stepLb(1);if(e.key==='ArrowRight')stepLb(-1)}});
/* student upload */
var pend=null;$('alBy').value=ls('rk_by')||'';
$('alAdd').onclick=function(){$('alMs').textContent='';$('alMd').classList.add('on')};$('alNo').onclick=function(){$('alMd').classList.remove('on')};
function shrink(file){return new Promise(function(res,rej){var im=new Image(),u=URL.createObjectURL(file);im.onload=function(){var s=Math.min(1,1600/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(function(b){b?res(b):rej()},'image/jpeg',.82)};im.onerror=rej;im.src=u})}
$('alFile').onchange=async function(){var f=this.files[0];if(!f)return;try{pend=await shrink(f);var p=$('alPrev');p.src=URL.createObjectURL(pend);p.style.display='block'}catch(e){pend=null;$('alMs').textContent='ملف غير صالح'}};
/* ---- طابور الذكريات (يعمل بدون إنترنت) ---- */
var QDB=null,PQ=[],pu={},flushing=false;
function qopen(){return QDB||(QDB=new Promise(function(res,rej){try{var r=indexedDB.open('rk_mem',1);r.onupgradeneeded=function(){var d=r.result;d.createObjectStore('q',{keyPath:'k'});d.createObjectStore('img',{keyPath:'k'})};r.onsuccess=function(){res(r.result)};r.onerror=function(){rej()}}catch(e){rej()}}))}
function qdo(store,mode,fn){return qopen().then(function(db){return new Promise(function(res,rej){var t=db.transaction(store,mode),rq=fn(t.objectStore(store));t.oncomplete=function(){res(rq&&rq.result)};t.onerror=t.onabort=function(){rej()}})})}
function qall(){return qdo('q','readonly',function(s){return s.getAll()}).then(function(a){return(a||[]).sort(function(x,y){return x.t-y.t})}).catch(function(){return[]})}
function pendHtml(){return PQ.map(function(it){if(!pu[it.k])pu[it.k]=URL.createObjectURL(it.blob);
 return'<div class="al-ph ok" data-p="'+esc(it.k)+'"><img src="'+pu[it.k]+'" alt="ذكرى"><div class="cp" style="opacity:1;transform:none">⏳ بانتظار الإرسال'+(it.cap?' · '+esc(it.cap.replace(/#[^\s#]+/g,'').trim()):'')+'</div></div>'}).join('')}
function renderAlbum(){renderAlbum0();if(!PQ.length)return;var g=$('alGrid'),e=g.querySelector('.an-em');if(e)e.remove();g.insertAdjacentHTML('afterbegin',pendHtml())}
async function findChat(){try{var r=await fetch(TGU+'bot'+CFG.TOKEN+'/getUpdates?limit=100'),j=await r.json(),a=String(CFG.CID||'').replace(/^@/,'').toLowerCase();
 var m=(j.result||[]).map(function(x){return x.message||x.edited_message}).filter(function(m){return m&&m.chat&&m.chat.type==='private'&&(!a||String((m.from&&m.from.username)||'').toLowerCase()===a||String(m.chat.id)===a)})[0];
 if(m){var id=String(m.chat.id);ls('rk_chat',id);return id}}catch(e){}return''}
/* ---- Firebase (REST): مزامنة الألبوم بدون تلغرام ---- */
function fbOn(){return!!window.RK_FB}
function fbReq(path,method,body){var ac=window.AbortController?new AbortController():null,t=ac&&setTimeout(function(){ac.abort()},12000);
 return fetch(RK_FB.replace(/\/$/,'')+'/'+path+'.json',{method:method||'GET',signal:ac?ac.signal:undefined,headers:body!==undefined?{'Content-Type':'application/json'}:undefined,body:body!==undefined?JSON.stringify(body):undefined}).then(function(r){if(t)clearTimeout(t);if(!r.ok)throw new Error('Firebase '+r.status);return r.json()},function(e){if(t)clearTimeout(t);throw e})}
function fbGet(path){return fbReq(path)}
var fbBusy=false;
async function fbSync(){if(!fbOn()||!navigator.onLine||fbBusy)return;fbBusy=true;
 try{var meta=await fbGet('albumMeta')||{},ch=false;
  for(var id in ST.del){if(id.indexOf('fb:')===0){var k=id.slice(3);if(meta[k]){delete meta[k];ch=true;fbReq('albumMeta/'+k,'DELETE').catch(function(){});fbReq('albumImg/'+k,'DELETE').catch(function(){})}}}
  var keep=ST.album.filter(function(x){return String(x.id).indexOf('fb:')!==0}),fb=Object.keys(meta).map(function(k){var m=meta[k]||{};return{id:'fb:'+k,fid:'fb:'+k,t:m.t||0,cap:m.cap||'',by:m.by||''}}).filter(function(x){return!ST.del[x.id]});
  var old=ST.album.filter(function(x){return String(x.id).indexOf('fb:')===0}).map(function(x){return x.id}).sort().join(),nw=fb.map(function(x){return x.id}).sort().join();
  if(old!==nw||ch){ST.album=keep.concat(fb);ls('rk_st',JSON.stringify(ST));renderAll()}
  var e=$('alSt');if(e)e.textContent='✓ الألبوم متصل بـ Firebase · '+fb.length+' صورة'}
 catch(e){}fbBusy=false}
function fbData(blob){return new Promise(function(res,rej){var r=new FileReader();r.onload=function(){res(r.result)};r.onerror=rej;r.readAsDataURL(blob)})}
async function fbPut(it){
 try{var key=String(it.k||Date.now()).replace(/[^A-Za-z0-9_-]/g,'_'),d=await fbData(it.blob);
  await fbReq('albumImg/'+key,'PUT',d);
  await fbReq('albumMeta/'+key,'PUT',{t:it.t||Date.now(),cap:it.cap||'',by:it.by||''});
  var ent={id:'fb:'+key,fid:'fb:'+key,t:it.t||Date.now(),cap:it.cap||'',by:it.by||''};
  await qdo('q','readwrite',function(s){return s.delete(it.k)});if(pu[it.k]){URL.revokeObjectURL(pu[it.k]);delete pu[it.k]}
  save(function(s){if(!s.album.some(function(x){return x.id===ent.id}))s.album.push(ent)});
  toast('وصلت ذكراك وصارت تظهر للجميع 🎉','fa-images text-amber-300');return true}
 catch(e){return false}}
async function flush(){if(flushing||!navigator.onLine)return;flushing=true;
 try{PQ=await qall();
  for(var i=0;i<PQ.length;i++){var it=PQ[i],c;if(window.RK_FB&&await fbPut(it))continue;c=chat()||await findChat();if(!c)break;
   try{var fd=new FormData();fd.append('chat_id',c);fd.append('disable_notification','true');fd.append('photo',it.blob,'memory.jpg');
    fd.append('caption','📸 #ذكرى'+(it.by?' من '+it.by:'')+(it.cap?'\n'+it.cap:''));
    var j=await api('sendPhoto',null,fd);if(!j.ok)throw (j.description||'sendPhoto');
    var m=j.result,p=m.photo[m.photo.length-1],ent={id:m.chat.id+':'+m.message_id,fid:p.file_id,t:m.date*1000,cap:it.cap||'',by:it.by||''};
    await qdo('q','readwrite',function(s){return s.delete(it.k)});if(pu[it.k]){URL.revokeObjectURL(pu[it.k]);delete pu[it.k]}
    save(function(s){if(!s.album.some(function(x){return x.id===ent.id}))s.album.push(ent)});
    toast('وصلت ذكراك وصارت تظهر للجميع 🎉','fa-images text-amber-300')}
   catch(e){$('alSt').textContent='⚠️ تعذر الإرسال: '+(e&&e.message||e);break}}
 }catch(e){}
 try{PQ=await qall()}catch(e){}flushing=false;renderAlbum()}
$('alGo').onclick=async function(){var ms=$('alMs');if(!pend){ms.textContent='اختر صورة أولاً';return}
 var cap=$('alCap').value.trim(),by=$('alBy').value.trim();ls('rk_by',by);
 try{await qdo('q','readwrite',function(s){return s.put({k:Date.now()+'-'+Math.random().toString(36).slice(2,7),blob:pend,cap:cap,by:by,t:Date.now()})})}
 catch(e){ms.textContent='تعذر الحفظ على الجهاز';return}
 $('alMd').classList.remove('on');$('alFile').value='';$('alCap').value='';$('alPrev').style.display='none';pend=null;ms.textContent='';
 toast(navigator.onLine?'جارٍ رفع ذكراك…':'حُفظت على جهازك وستُرفع تلقائياً عند توفر الإنترنت','fa-images text-amber-300');
 PQ=await qall();renderAlbum();flush()};
window.addEventListener('online',function(){flush();pull()});setInterval(flush,30000);
function renderAll(){renderFiles();renderAlbum()}
/* ---- Admin ---- */
var sel='header h1,header p,section .card-title,section>div>p,section h2,section h3,footer',els=[].slice.call(document.querySelectorAll(sel)).filter(function(e){return!e.closest('#anList,#filesSec,#albumSec,#rkDrawer,#rkAdmin,#stPan,#aiPanel,#trOv,#rkIntro,#alMd,#rkLb')&&!e.querySelector('div,section,svg,button,input,textarea')});
els.forEach(function(e,i){e.dataset.rkE=i});
var ed={};try{ed=JSON.parse(ls('rk_edits')||'{}')}catch(x){}
Object.keys(ed).forEach(function(i){var e=document.querySelector('[data-rk-e="'+i+'"]');if(e)e.innerHTML=ed[i]});
var hid={};try{hid=JSON.parse(ls('rk_hid')||'{}')}catch(x){}
var secs=[].slice.call(document.querySelectorAll('section[id],main#lab'));
function applyHid(){secs.forEach(function(s){s.style.display=hid[s.id]?'none':''})}applyHid();
$('adSecs').innerHTML=secs.map(function(s){var t=(s.querySelector('.card-title,h2,h3')||{}).textContent||s.id;return'<label class="sw"><input type="checkbox" data-s="'+s.id+'"'+(hid[s.id]?'':' checked')+'> '+esc(t.trim().slice(0,40))+'</label>'}).join('');
$('adSecs').onchange=function(e){var c=e.target;hid[c.dataset.s]=!c.checked;ls('rk_hid',JSON.stringify(hid));applyHid()};
function setEdit(on){B.classList.toggle('rk-edit',on);els.forEach(function(e){if(on)e.contentEditable='true';else e.removeAttribute('contenteditable')});$('adEdit').textContent=on?'إيقاف وضع التعديل':'تفعيل وضع التعديل'}
$('adEdit').onclick=function(){var on=!B.classList.contains('rk-edit');setEdit(on);if(on){$('rkAdmin').classList.remove('on');toast('وضع التعديل مفعّل','fa-pen')}};
document.addEventListener('input',function(e){var t=e.target.closest&&e.target.closest('[data-rk-e]');if(t&&B.classList.contains('rk-edit')){ed[t.dataset.rkE]=t.innerHTML;ls('rk_edits',JSON.stringify(ed))}});
$('adReset').onclick=function(){if(confirm('استرجاع كل النصوص والأقسام للأصل؟')){ls('rk_edits','{}');ls('rk_hid','{}');location.reload()}};
function unlockUI(){$('rkAdOpen').hidden=!adm();B.classList.toggle('rk-isadm',adm());renderAll()}
function opn(){if(!adm()){var p=prompt('رمز الدخول (PIN):');if(p===null)return;if(h53('rk|'+p.trim())!==PINH){toast('رمز غير صحيح','fa-triangle-exclamation text-rose-300');return}ss('rk_adm','1');ss('rk_pin',p.trim());unlockUI()}
 dr(false);$('rkAdmin').classList.add('on')}
$('rkAdOpen').onclick=opn;$('adX').onclick=function(){$('rkAdmin').classList.remove('on')};$('rkAdmin').onclick=function(e){if(e.target===this)this.classList.remove('on')};
$('adLock').onclick=function(){ss('rk_adm','0');ss('rk_pin','');setEdit(false);$('rkAdmin').classList.remove('on');unlockUI();toast('تم القفل','fa-lock')};
$('adExp').onclick=function(){var b=new Blob([JSON.stringify({edits:ed,hid:hid})],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='rk-settings.json';a.click()};
$('adImp').onclick=function(){var i=document.createElement('input');i.type='file';i.accept='.json';i.onchange=function(){var r=new FileReader();r.onload=function(){try{var d=JSON.parse(r.result);ls('rk_edits',JSON.stringify(d.edits||{}));ls('rk_hid',JSON.stringify(d.hid||{}));location.reload()}catch(x){toast('ملف غير صالح','fa-triangle-exclamation text-amber-300')}};r.readAsText(i.files[0])};i.click()};
var lg=document.querySelector('header .logo');if(lg){var c=0,tm;lg.addEventListener('click',function(){c++;clearTimeout(tm);tm=setTimeout(function(){c=0},700);if(c>=3){c=0;opn()}})}
document.addEventListener('visibilitychange',function(){if(!document.hidden)pull()});setInterval(function(){if(!document.hidden)pull()},60000);
unlockUI();pull();qall().then(function(a){PQ=a;renderAlbum();flush()});
})();
