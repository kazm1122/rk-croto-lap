</section>
<script>
(function(){
var DUR=11.84,FPS=20,NB=24,ENV="";
var SEGS=[[.10,2.53,"التشفير ليس مجرد إخفاء للأسرار،",2.35],[2.53,4.13,"بل هو فن الصمت الذكي",3.95],[4.13,6.66,"الذي يضمن أن تبقى كلمتك لك وحدك،",6.49],[6.66,7.90,"وكل مفتاح تحميه",7.78],[7.90,10.24,"هو حصن يغلق الأبواب أمام الفضول.",10.0],[10.24,DUR,"الأمان يبدأ من الفهم.",11.55]];
var $=function(i){return document.getElementById(i)},au=$('clAudio'),txt=$('clText'),viz=$('clViz'),scs=document.querySelectorAll('#closing .cl-sc'),cph=$('clCph');
var cur=-1,words=[],times=[],raf=0,lastScr=0,started=false,bars=[];
for(var b=0;b<NB;b++){var e=document.createElement('i');viz.appendChild(e);bars.push(e)}
SEGS.forEach(function(s){var ws=s[2].split(' '),ln=ws.map(function(w){return w.replace(/[،.]/g,'').length+1}),tot=ln.reduce(function(a,b){return a+b},0),c=0;s.ws=ws;s.tm=ws.map(function(_,i){var t=s[0]+.05+(s[3]-s[0]-.05)*c/tot;c+=ln[i];return t})});
function fmt(t){t=Math.max(0,Math.min(DUR,t));return('0'+(t/60|0)).slice(-2)+':'+('0'+(t%60|0)).slice(-2)}
function setScene(i){scs.forEach(function(g,k){g.classList.toggle('on',k===i)})}
function setText(i){var s=SEGS[i];txt.classList.toggle('big',i===SEGS.length-1);txt.innerHTML='';words=s.ws.map(function(w){var sp=document.createElement('span');sp.className='cl-w';sp.textContent=w;txt.appendChild(sp);return sp});times=s.tm}
function seg(t){var k=0;for(var i=0;i<SEGS.length;i++)if(t>=SEGS[i][0])k=i;return k}
function tick(){
 var t=au.currentTime||0,i=seg(t);
 if(i!==cur){cur=i;setScene(i);setText(i)}
 if(t<SEGS[0][0]){words.forEach(function(w){w.className='cl-w'})}
 else{var c=-1;times.forEach(function(x,k){if(t>=x-.02)c=k});words.forEach(function(w,k){w.className='cl-w'+(k<=c?' on':'')+(k===c&&t<SEGS[i][3]+.1&&!au.paused?' cur':'')})}
 var fi=Math.min(Math.floor(t*FPS),Math.floor(ENV.length/NB)-1),live=!au.paused&&!au.ended;
 for(var b=0;b<NB;b++){var v=live?parseInt(ENV.charAt(fi*NB+b),36)/35:0;bars[b].style.transform='scaleY('+(.06+v*.94)+')'}
 $('clFill').style.width=(t/DUR*100)+'%';$('clTime').textContent=fmt(t)+' / 00:12';
 if(cur===0&&cph&&live&&performance.now()-lastScr>80){lastScr=performance.now();var ch='0123456789ABCDEF#@$%',s='';for(var k=0;k<6;k++)s+=ch.charAt(Math.random()*ch.length|0);cph.textContent=s}
}
function loop(){tick();if(!au.paused&&!au.ended)raf=requestAnimationFrame(loop)}
function icon(){var p=!au.paused&&!au.ended;$('clPlay').innerHTML='<i class="fa-solid fa-'+(p?'pause':'play')+'"></i>'}
function toggle(){if(au.paused||au.ended){if(au.ended)au.currentTime=0;started=true;$('clBig').classList.add('off');au.play()}else au.pause()}
au.addEventListener('play',function(){icon();cancelAnimationFrame(raf);loop()});
au.addEventListener('pause',function(){icon();tick()});
au.addEventListener('ended',function(){icon();cur=-1;au.currentTime=DUR-.01;tick()});
$('clPlay').onclick=toggle;$('clBig').onclick=toggle;
$('clRe').onclick=function(){au.currentTime=0;cur=-1;started=true;$('clBig').classList.add('off');au.play()};
$('clBar').onclick=function(e){var r=this.getBoundingClientRect(),k=Math.min(1,Math.max(0,(r.right-e.clientX)/r.width));au.preload='auto';au.currentTime=k*DUR;cur=-1;tick()};
setScene(0);
})();
</script>

