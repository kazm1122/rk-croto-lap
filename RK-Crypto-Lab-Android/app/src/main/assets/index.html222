        <button id="vPlay" onclick="vToggle()" class="btn btn-ghost"><i class="fa-solid fa-play"></i> تشغيل</button>
        <button onclick="vRestart()" class="btn btn-ghost"><i class="fa-solid fa-rotate-right"></i> إعادة</button>
        <button id="vVoice" onclick="vToggleVoice()" class="btn btn-ghost"><i class="fa-solid fa-volume-xmark"></i> الشرح الصوتي: متوقف</button>
        <button id="vSfx" onclick="vToggleSfx()" class="btn btn-ghost"><i class="fa-solid fa-music"></i> المؤثرات: تعمل</button>
