<!-- ===== واجهة تسجيل الدخول (RK-LOGIN v2) ===== -->
<style>
#rkLogin{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:18px;overflow-y:auto;background:radial-gradient(circle at 50% 0%,#241a5e 0,#050816 62%);font-family:'Tajawal',sans-serif;color:#e5e9ff}
#rkLogin.on{display:flex}
#rkLogin .bx{width:100%;max-width:380px;margin:auto;padding:24px 20px 20px;border-radius:24px;background:rgba(14,19,48,.88);border:1px solid rgba(124,92,255,.4);box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(124,92,255,.18)}
#rkLogin .lg{display:flex;flex-direction:column;align-items:center;text-align:center}
#rkLogin .lg svg{width:68px;height:68px}
#rkLogin h2{margin:8px 0 2px;font-size:1.25rem;font-weight:900}
#rkLogin .sb{font-size:.78rem;opacity:.65;margin-bottom:16px}
#rkLogin .tabs{display:flex;gap:4px;padding:4px;border-radius:14px;background:rgba(5,8,22,.7);margin-bottom:16px}
#rkLogin .tabs button{flex:1;padding:10px;border:0;border-radius:11px;background:transparent;color:#e5e9ff;font:700 .9rem 'Tajawal',sans-serif;cursor:pointer;opacity:.7}
#rkLogin .tabs button.a{background:linear-gradient(135deg,#7c5cff,#22d3ee);color:#050816;opacity:1}
#rkLogin label{display:block;margin:0 2px 5px;font-size:.8rem;opacity:.8}
#rkLogin .f{position:relative;margin-bottom:12px}
#rkLogin input{width:100%;box-sizing:border-box;padding:13px 14px;border-radius:12px;border:1px solid rgba(196,181,253,.3);background:rgba(5,8,22,.85);color:#fff;font:inherit;font-size:1rem;outline:none;transition:.2s}
#rkLogin input:focus{border-color:#22d3ee;box-shadow:0 0 0 3px rgba(34,211,238,.15)}
#rkLogin .eye{position:absolute;left:8px;bottom:8px;padding:5px 9px;border:0;border-radius:8px;background:rgba(124,92,255,.25);color:#e5e9ff;font:600 .7rem 'Tajawal',sans-serif;cursor:pointer}
#rkLogin .str{height:5px;border-radius:5px;background:rgba(255,255,255,.1);overflow:hidden;margin:-4px 0 4px}
#rkLogin .str i{display:block;height:100%;width:0;transition:.25s}
#rkLogin .sl{font-size:.72rem;opacity:.7;margin-bottom:10px;min-height:14px}
#rkLogin .go{width:100%;padding:13px;border:0;border-radius:12px;font:800 1rem 'Tajawal',sans-serif;color:#050816;background:linear-gradient(135deg,#c4b5fd,#22d3ee);cursor:pointer}
#rkLogin .go:disabled{opacity:.5}
#rkLogin .er{min-height:20px;margin-top:10px;text-align:center;font-size:.85rem;color:#f87171}
#rkLogin .ok{color:#4ade80}
#rkLogin .ft{margin-top:8px;text-align:center;font-size:.68rem;opacity:.45}
#rkOut{position:fixed;top:calc(env(safe-area-inset-top,0px) + 6px);left:8px;z-index:9999;display:none;max-width:46vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:5px 12px;border-radius:999px;border:1px solid rgba(196,181,253,.4);background:rgba(5,8,22,.8);color:#e5e9ff;font:600 .75rem 'Tajawal',sans-serif;cursor:pointer}
#rkOut.on{display:block}
</style>
<script>
(function(){
  var AK='rk_accounts',SK='rk_session',LK='rk_lock',MAX=5,LOCK=60000,mode='in';
  function J(k,d){try{return JSON.parse(localStorage.getItem(k)||'')||d}catch(e){return d}}
  function S(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
  function $(i){return document.getElementById(i)}
  function enc(s){return new TextEncoder().encode(s)}
  function hex(b){return Array.prototype.map.call(new Uint8Array(b),function(x){return('0'+x.toString(16)).slice(-2)}).join('')}
  function salt(){var a=new Uint8Array(16);(window.crypto||{getRandomValues:function(x){for(var i=0;i<x.length;i++)x[i]=Math.random()*256}}).getRandomValues(a);return hex(a)}
  async function hash(p,s){
    try{var k=await crypto.subtle.importKey('raw',enc(p),'PBKDF2',false,['deriveBits']);
      return hex(await crypto.subtle.deriveBits({name:'PBKDF2',salt:enc(s),iterations:60000,hash:'SHA-256'},k,256))}
    catch(e){var h=5381,t=s+p;for(var i=0;i<t.length;i++)h=((h<<5)+h+t.charCodeAt(i))|0;return 'f'+h}
  }
  function key(n){return n.trim().toLowerCase()}
  function msg(t,ok){var e=$('rkLe');e.textContent=t;e.className='er'+(ok?' ok':'')}
  function strength(p){var s=0;if(p.length>=6)s++;if(p.length>=10)s++;if(/[A-Za-z]/.test(p)&&/\d/.test(p))s++;if(/[^A-Za-z0-9]/.test(p))s++;return s}
  function build(){
    if($('rkLogin'))return;
    var d=document.createElement('div');d.id='rkLogin';
    d.innerHTML='<div class="bx"><div class="lg"><svg><use href="#rkLogo"/></svg><h2>المختبر التعليمي للتشفير</h2><div class="sb">RK-TEAM · بوابة الطلاب</div></div>'+
    '<div class="tabs"><button type="button" id="rkTi" class="a">تسجيل الدخول</button><button type="button" id="rkTu">حساب جديد</button></div>'+
    '<div class="f"><label for="rkLn">اسم المستخدم</label><input id="rkLn" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="20"></div>'+
    '<div class="f"><label for="rkLp">كلمة المرور</label><input id="rkLp" type="password" autocomplete="current-password"><button type="button" class="eye" data-t="rkLp">إظهار</button></div>'+
    '<div id="rkReg" style="display:none"><div class="str"><i id="rkSb"></i></div><div class="sl" id="rkSl"></div>'+
    '<div class="f"><label for="rkLc">تأكيد كلمة المرور</label><input id="rkLc" type="password" autocomplete="new-password"><button type="button" class="eye" data-t="rkLc">إظهار</button></div></div>'+
    '<button type="button" class="go" id="rkLb">دخول</button><div class="er" id="rkLe"></div><div class="ft">الحساب محفوظ على هذا الجهاز · RK-TEAM</div></div>';
    document.body.appendChild(d);
    var b=document.createElement('button');b.id='rkOut';b.type='button';
    b.onclick=function(){if(confirm('تسجيل الخروج من الحساب؟'))window.rkLogout()};
    document.body.appendChild(b);
    $('rkTi').onclick=function(){setMode('in')};$('rkTu').onclick=function(){setMode('up')};
    $('rkLb').onclick=submit;
    d.addEventListener('keydown',function(e){if(e.key==='Enter')submit()});
    d.querySelectorAll('.eye').forEach(function(x){x.onclick=function(){var i=$(x.dataset.t);var h=i.type==='password';i.type=h?'text':'password';x.textContent=h?'إخفاء':'إظهار'}});
    $('rkLp').addEventListener('input',function(){if(mode!=='up')return;var s=strength(this.value),c=['#f87171','#f87171','#fbbf24','#4ade80','#22d3ee'][s],l=['ضعيفة جداً','ضعيفة','متوسطة','جيدة','قوية'][s];$('rkSb').style.width=(this.value?(s+1)*20:0)+'%';$('rkSb').style.background=c;$('rkSl').textContent=this.value?'قوة كلمة المرور: '+l:''});
  }
  function setMode(m){
    mode=m;$('rkTi').className=m==='in'?'a':'';$('rkTu').className=m==='up'?'a':'';
    $('rkReg').style.display=m==='up'?'block':'none';$('rkLb').textContent=m==='up'?'إنشاء الحساب':'دخول';
    $('rkLp').autocomplete=m==='up'?'new-password':'current-password';msg('');
  }
  function locked(){var l=J(LK,{c:0,u:0});if(l.u>Date.now())return Math.ceil((l.u-Date.now())/1000);return 0}
  function fail(){var l=J(LK,{c:0,u:0});l.c=(l.c||0)+1;if(l.c>=MAX){l.u=Date.now()+LOCK;l.c=0}S(LK,l)}
  function notify(n){
    try{if(window.RK_WORKER||!window.RK_CHAT||!window.RK_TOK)return;
      fetch(RK_TG+'/bot'+RK_TOK+'/sendMessage',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({chat_id:RK_CHAT,disable_notification:true,text:'👤 حساب جديد في المختبر\nالاسم: '+n+'\nالوقت: '+new Date().toLocaleString('ar')}),signal:rkTmo(9000)}).catch(function(){})}catch(e){}
    try{if(window.RK_FB)rkFbPut('newUsers/'+Date.now()+'_'+Math.random().toString(36).slice(2,6),{name:n,t:Date.now(),at:new Date().toLocaleString('ar')}).catch(function(){})}catch(e){}
  }
  async function submit(){
    var n=$('rkLn').value.trim(),p=$('rkLp').value,btn=$('rkLb'),acc=J(AK,{}),k=key(n);
    var w=locked();if(w){msg('محاولات كثيرة خاطئة. انتظر '+w+' ثانية');return}
    if(!n||!p){msg('اكتب اسم المستخدم وكلمة المرور');return}
    btn.disabled=true;
    try{
      if(mode==='up'){
        if(n.length<3){msg('اسم المستخدم 3 أحرف على الأقل');return}
        if(/[\s<>"'&\\\/]/.test(n)){msg('الاسم لا يحتوي مسافات أو رموز خاصة');return}
        if(acc[k]){msg('هذا الاسم مستخدم، اختر اسماً آخر');return}
        if(p.length<6){msg('كلمة المرور 6 أحرف على الأقل');return}
        if(p!==$('rkLc').value){msg('كلمتا المرور غير متطابقتين');return}
        var s=salt();acc[k]={n:n,s:s,h:await hash(p,s),t:Date.now()};S(AK,acc);notify(n);enter(n);
      }else{
        var a=acc[k];
        if(!a){fail();msg('الحساب غير موجود. أنشئ حساباً جديداً أولاً');return}
        if(await hash(p,a.s)!==a.h){fail();var r=MAX-(J(LK,{c:0}).c||0);msg('كلمة المرور غير صحيحة'+(r>0&&r<MAX?' (متبقي '+r+' محاولات)':''));return}
        S(LK,{c:0,u:0});enter(a.n);
      }
    }finally{btn.disabled=false}
  }
  function enter(n){
    S(SK,key(n));try{localStorage.setItem('rk_sbname',n)}catch(e){}
    $('rkLogin').classList.remove('on');$('rkLp').value='';$('rkLc').value='';
    var o=$('rkOut');o.textContent='👤 '+n+' · خروج';o.classList.add('on');
  }
  window.rkLogout=function(){try{localStorage.removeItem(SK)}catch(e){}location.reload()};
  function init(){
    build();var s=J(SK,null),a=s&&J(AK,{})[s];
    if(a){enter(a.n);return}
    $('rkLogin').classList.add('on');
    if(!Object.keys(J(AK,{})).length)setMode('up');
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<!-- ===== نهاية واجهة الدخول ===== -->

<!-- RK-TEAM emblem (defined once, reused everywhere) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="rkg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c4b5fd"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs>
<symbol id="rkLogo" viewBox="0 0 100 100"><polygon points="50,4 90,27 90,73 50,96 10,73 10,27" fill="rgba(124,92,255,.14)" stroke="url(#rkg)" stroke-width="3"/><polygon points="50,15 80,32 80,68 50,85 20,68 20,32" fill="none" stroke="url(#rkg)" stroke-width="1" opacity=".6"/><path d="M22 50h7M71 50h7M50 17v7M50 76v7" stroke="#22d3ee" stroke-width="2" stroke-linecap="round"/><text x="50" y="62" text-anchor="middle" font-size="34" font-weight="900" fill="url(#rkg)" style="font-family:'Arial Black',Arial,sans-serif;letter-spacing:-1px">RK</text></symbol></svg>

<div class="rk-big" aria-hidden="true"><svg><use href="#rkLogo"/></svg></div>
<div class="rk-wm" aria-hidden="true"><svg><use href="#rkLogo"/></svg>RK-TEAM</div>

<!-- Intro splash: shown once per session, click or wait to enter -->
<div id="rkIntro" role="dialog" aria-label="RK-TEAM">
  <img class="bgimg" src="rk-team.jpg" alt="" onerror="this.remove()">
  <div class="rk-glow"></div>
  <div class="in">
    <div class="rk-hex"><svg><use href="#rkLogo"/></svg><i class="rk-ring"></i><i class="rk-ring r2"></i></div>
    <div class="rk-name">RK-TEAM</div>
    <div class="rk-sub">AUTHORIZED PERSONNEL ONLY</div>
    <div class="rk-bar"><i></i></div>
    <div class="rk-hint">المس الشعار لفتح البوابة 🔊</div>
  </div>
</div>
<div class="floaties" aria-hidden="true"><span class="fl" style="left:8%;top:70%;font-size:34px;--d:19s;animation-delay:-0s">🔒</span><span class="fl" style="left:88%;top:60%;font-size:30px;--d:23s;animation-delay:-4s">🔑</span><span class="fl" style="left:70%;top:20%;font-size:20px;--d:17s;animation-delay:-2s">01101</span><span class="fl" style="left:15%;top:25%;font-size:22px;--d:21s;animation-delay:-6s">mod</span><span class="fl" style="left:45%;top:82%;font-size:34px;--d:25s;animation-delay:-8s">φ</span><span class="fl" style="left:92%;top:15%;font-size:26px;--d:20s;animation-delay:-3s">{ }</span><span class="fl" style="left:28%;top:55%;font-size:30px;--d:22s;animation-delay:-9s">∑</span><span class="fl" style="left:58%;top:40%;font-size:24px;--d:18s;animation-delay:-5s">#</span></div>

<div class="wrap flex flex-col min-h-screen">

<!-- Network status -->
<div id="netBar" role="status" aria-live="polite" title="اضغط لإعادة القياس">
  <span class="nb busy" id="nbSt"><span class="d"></span><b id="nbStT">جارٍ القياس…</b></span>
  <span class="nb" id="nbSp"><i class="fa-solid fa-arrow-down"></i><small>التحميل</small><b id="nbSpT">—</b></span>
  <span class="nb" id="nbPg"><i class="fa-solid fa-gauge-high"></i><small>الاستجابة</small><b id="nbPgT">—</b></span>
  <span class="nb" id="nbTy" style="display:none"><i class="fa-solid fa-tower-cell"></i><small>الشبكة</small><b id="nbTyT">—</b></span>
</div>

<!-- Header -->
<header class="max-w-6xl mx-auto w-full mb-6 fade-in">
  <div class="card p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="logo"><i class="fa-solid fa-user-shield"></i></div>
      <div>
        <div class="stage-chip"><i class="fa-solid fa-shield-halved"></i><span>طلاب الأمن السيبراني · المرحلة الثالثة</span><span class="en">Cybersecurity Students · 3rd Stage</span></div>
        <h1 class="text-xl sm:text-3xl font-black gradient-text">المختبر التعليمي للتشفير</h1>
        <p class="text-xs sm:text-sm font-medium" style="color:var(--muted)">Cryptography Lab — RSA · ElGamal · DES</p>
        <p class="text-xs mt-1 font-bold" style="color:#b6a8ff">✨ صنع من فريق: <span style="color:#fff;direction:ltr;display:inline-block">R K - T E A M</span></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <span class="rk-badge"><svg><use href="#rkLogo"/></svg>RK-TEAM</span>
      <span class="badge"><span class="dot"></span> يعمل بدون خادم / Runs locally</span>
      <button type="button" id="hdHelp" class="btn btn-dec" style="font-size:.85rem;padding:.55rem 1.1rem"><i class="fa-solid fa-circle-question"></i> دليل</button>
      <button type="button" id="dlApk" class="btn btn-dec" style="font-size:.8rem;padding:.55rem 1rem"><i class="fa-brands fa-android"></i> للهاتف: تحميل التطبيق (APK)<small class="dl-tag" hidden>الأنسب لجهازك</small></button><button type="button" id="dlHtml" onclick="downloadLab()" class="btn btn-enc" style="font-size:.8rem;padding:.55rem 1rem"><i class="fa-solid fa-laptop"></i> للابتوب: تحميل ملف HTML<small class="dl-tag" hidden>الأنسب لجهازك</small></button>
    </div>
  </div>
</header>

<style>
#annSec{scroll-margin-top:14px}
.an-hd{display:flex;align-items:flex-start;gap:.6rem;flex-wrap:wrap;justify-content:space-between;margin-bottom:.9rem}
.an-list{display:grid;gap:.6rem}
.an-it{display:flex;gap:.75rem;padding:.8rem .9rem;border-radius:16px;background:rgba(124,92,255,.07);border:1px solid var(--border);border-inline-start:4px solid var(--c,#22d3ee)}
.an-it.new{background:rgba(124,92,255,.17)}
.an-ic{flex:none;width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:var(--c);background:rgba(255,255,255,.06)}
.an-b{min-width:0;flex:1}
.an-t{font-weight:800;color:#fff;font-size:.95rem;line-height:1.7;word-break:break-word}
.an-x{font-size:.86rem;line-height:1.9;color:#cdd5ff;white-space:pre-wrap;word-break:break-word}
.an-m{display:flex;gap:.5rem;align-items:center;margin-top:.3rem;min-height:34px;font-size:.7rem;color:var(--muted)}
.an-nw{background:#ef4444;color:#fff!important;border-radius:99px;padding:.05rem .55rem;font-weight:800}
.an-em{text-align:center;padding:1.4rem .5rem;color:var(--muted);font-size:.85rem;line-height:1.9}
.an-em i{display:block;font-size:1.8rem;color:var(--accent2);margin-bottom:.4rem}
.an-st{font-size:.72rem;color:var(--muted);margin-top:.7rem}
.an-ref.spin i{animation:kxr 1s linear infinite}
.an-del{flex:none;margin-inline-start:auto;width:42px;height:34px;border-radius:10px;border:1px solid var(--border);background:rgba(255,255,255,.05);color:var(--muted);cursor:pointer}
.an-del:hover,.an-del:focus-visible{color:#fb7185;border-color:#fb7185}
.an-bt{display:flex;gap:.5rem}
.an-imgs{display:grid;gap:.4rem;margin-top:.5rem}.an-imgs.m{grid-template-columns:1fr 1fr}
.an-img{width:100%;display:block;border-radius:12px;border:1px solid var(--border);background:rgba(255,255,255,.05);min-height:70px;cursor:zoom-in;touch-action:manipulation}
.an-imgs.m .an-img{height:130px;object-fit:cover}
.an-imgs:not(.m) .an-img{max-height:340px;object-fit:contain;background:rgba(0,0,0,.25)}
#anLb{position:fixed;inset:0;z-index:95;background:rgba(2,4,15,.93);display:none;align-items:center;justify-content:center;padding:max(10px,env(safe-area-inset-top)) 10px max(10px,env(safe-area-inset-bottom))}
#anLb.on{display:flex}#anLb img{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px}
#anLb button{position:absolute;top:max(12px,env(safe-area-inset-top));right:12px;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.55);color:#fff;font-size:1.3rem;cursor:pointer}
#dock a[data-t=annSec]{position:relative}
.dk-n{position:absolute;top:-2px;left:-1px;box-sizing:border-box;min-width:18px;height:18px;padding:0 3px;border-radius:9px;background:#ef4444;color:#fff;font:800 10px/14px Tajawal,sans-serif;text-align:center;font-style:normal;border:2px solid #0b1030}
.dk-n[data-n="0"]{display:none}
#dock .dkb{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-width:40px;padding:8px 9px;border:0;background:none;border-radius:16px;color:var(--muted);font-family:inherit;font-weight:700;font-size:10.5px;line-height:1;cursor:pointer}
#dock .dkb svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#dock .dkb span{display:none}
#dock .dkb:hover{color:var(--text);background:rgba(124,92,255,.16)}
@media(min-width:700px){#dock .dkb{padding:9px 14px;min-width:58px}#dock .dkb span{display:block}#dock .dkb svg{width:20px;height:20px}}
#trOv{position:fixed;inset:0;z-index:90;background:rgba(2,4,15,.74);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:14px}
#trOv.on{display:flex}
#trBox{width:min(100%,400px);max-height:96dvh;overflow:auto;background:var(--cb,#0e1430);color:var(--text);border:1px solid var(--border);border-radius:24px;padding:1.1rem;box-shadow:0 30px 70px rgba(0,0,0,.6);text-align:center}
.tr-img{height:150px;border-radius:16px;background:rgba(5,8,22,.6);border:1px solid var(--border);margin-bottom:.9rem;overflow:hidden}
.tr-img svg{width:100%;height:100%;display:block}
.tr-s{display:none}.tr-s.on{display:block;animation:kxin .35s both}
.tr-s h3{font-weight:900;font-size:1.1rem;color:var(--text);margin-bottom:.3rem}
.tr-s p{font-size:.88rem;line-height:1.9;color:var(--muted);min-height:7.6em}
.tr-p{animation:kxz 1.6s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
.tr-dots{display:flex;gap:6px;justify-content:center;margin:.6rem 0 .8rem}
.tr-dots i{width:8px;height:8px;border-radius:99px;background:rgba(148,163,255,.3);transition:width .25s,background .25s}
.tr-dots i.on{width:22px;background:var(--accent2)}
.tr-nav{display:flex;gap:.5rem}.tr-nav .btn{flex:1;padding:.75rem .6rem;font-size:.92rem}
.tr-skip{margin-top:.5rem;background:none;border:0;color:var(--muted);font-size:.78rem;cursor:pointer;padding:.5rem;font-family:inherit}
#trOv{padding:max(14px,env(safe-area-inset-top)) 14px max(14px,env(safe-area-inset-bottom))}
.tr-nav .btn{min-height:46px}
@media(max-height:520px){.tr-img{height:96px;margin-bottom:.6rem}.tr-s p{min-height:0}}
@media(max-width:699px){#toast{bottom:calc(86px + env(safe-area-inset-bottom,0px));z-index:75}}
</style>
<section id="annSec" class="max-w-6xl mx-auto w-full mb-6 fade-in"><div class="card p-5 sm:p-6">
<div class="an-hd"><div><span class="card-title"><i class="fa-solid fa-bell"></i> التبليغات (Announcements)</span>
<p class="text-xs mt-1" style="color:var(--muted)">رسائل المشرف المهمة، مثل مواعيد الامتحانات والواجبات، تصلك هنا تلقائياً.</p></div>
<div class="an-bt"><button class="btn btn-ghost an-ref" id="anRef" type="button"><i class="fa-solid fa-rotate"></i> تحديث</button><button class="btn btn-ghost" id="anClr" type="button"><i class="fa-regular fa-trash-can"></i> مسح الكل</button></div></div>
<div id="anList" class="an-list" aria-live="polite"></div>
<p class="an-st" id="anSt"></p>
</div></section>
<section id="filesSec" class="max-w-6xl mx-auto w-full mb-6 fade-in"><div class="card p-5 sm:p-6">
<div class="an-hd"><div><span class="card-title"><i class="fa-solid fa-folder-open"></i> ملفات البوت (Bot Files)</span>
<p class="text-xs mt-1" style="color:var(--muted)">كل ملف ترسله إلى بوت تلغرام يظهر هنا تلقائياً ويمكنك تنزيله.</p></div>
<div class="an-bt"><button class="btn btn-ghost" id="flRef" type="button"><i class="fa-solid fa-rotate"></i> تحديث</button></div></div>
<div class="fl-bar"><input class="field" id="flQ" placeholder="ابحث باسم الملف…"><button class="fl-chip on" data-k="">الكل</button><button class="fl-chip" data-k="img">صور</button><button class="fl-chip" data-k="doc">مستندات</button><button class="fl-chip" data-k="oth">أخرى</button></div>
<div class="fl-grid" id="flGrid"></div><p class="an-st" id="flSt"></p>
</div></section>
<section id="sendSec" class="max-w-6xl mx-auto w-full mb-6 fade-in"><div class="card p-5 sm:p-6">
<div class="sb-cta-in">
<div class="sb-ico"><i class="fa-solid fa-paper-plane"></i></div>
<div style="flex:1;min-width:210px"><span class="card-title"><i class="fa-solid fa-cloud-arrow-up"></i> تسليم الملفات (Submit Files)</span>
<p class="text-xs mt-1" style="color:var(--muted)">صوّر ورقتك أو ارفع ملفك. يُحفظ على جهازك فوراً ويصل تلقائياً إلى المشرف عبر تلجرام عند توفر الإنترنت، حتى لو كنت بدون نت الآن.</p></div>
<button type="button" class="btn btn-enc" id="sbOpen" style="position:relative"><i class="fa-solid fa-folder-open"></i> فتح مركز التسليم <span class="sb-badge in" id="sbBadge0" data-n="0">0</span></button>
</div></div></section>
<section id="albumSec" class="max-w-6xl mx-auto w-full mb-6 fade-in"><div class="card p-5 sm:p-6">
<div class="an-hd"><div><span class="card-title"><i class="fa-solid fa-images"></i> ألبوم الذكريات (Memories)</span>
<p class="text-xs mt-1" style="color:var(--muted)">لحظات الطلاب في المختبر والمحاضرات، تبقى هنا للجميع.</p></div>
<div class="an-bt"><button class="btn btn-enc" id="alAdd" type="button" style="font-size:.8rem;padding:.55rem 1rem"><i class="fa-solid fa-camera"></i> أضف ذكرى</button></div></div>
<div class="fl-bar" id="alTags"></div><div id="alFeat"></div><div class="al-grid" id="alGrid"></div><div id="alMoreW"></div><p class="an-st" id="alSt"></p>
</div></section>
<!-- Basics -->
<section id="sec-basics" class="max-w-6xl mx-auto w-full mb-6 fade-in">
  <div class="card p-5 sm:p-6">
    <div class="mb-4"><span class="card-title"><i class="fa-solid fa-graduation-cap"></i> ابدأ من هنا: أساسيات التشفير</span>
    <p class="text-xs mt-1" style="color:var(--muted)">للمبتدئين: ما هو التشفير، وما المصطلحات التي ستقابلها، وكيف يعمل التوقيع الرقمي.</p></div>
    <div class="flex flex-wrap gap-2 mb-4">
      <button class="btn btn-ghost btab on" data-b="what" onclick="bTab('what')">🔒 ما هو التشفير؟</button>
      <button class="btn btn-ghost btab" data-b="terms" onclick="bTab('terms')">📖 المصطلحات</button>
      <button class="btn btn-ghost btab" data-b="sig" onclick="bTab('sig')">✍️ التوقيع الرقمي</button>
    </div>
    <div id="b-what" class="bpanel on">
<div class="card-title mb-2"><i class="fa-solid fa-lock"></i> ما هو التشفير؟</div>
<p class="text-sm leading-relaxed mb-4" style="color:#cdd5ff">التشفير (Encryption) هو تحويل المعلومات المفهومة إلى شكل غير مفهوم باستخدام <b>خوارزمية</b> و<b>مفتاح</b>، بحيث لا يستطيع إعادتها إلى أصلها إلا من يملك المفتاح الصحيح. هكذا تبقى رسائلك وبياناتك محمية حتى لو اعترضها شخص آخر أثناء انتقالها.</p>
<div class="vid-stage mb-4" style="min-height:0"><div class="vrow">
<div class="vbox plain">Hello<small>نص واضح</small></div><div class="varrow">➜</div>
<div class="vbox key">🔑<small>تشفير + مفتاح</small></div><div class="varrow">➜</div>
<div class="vbox cipher">X9#k2<small>نص مشفّر</small></div><div class="varrow">➜</div>
<div class="vbox key">🔑<small>فك + مفتاح</small></div><div class="varrow">➜</div>
<div class="vbox plain">Hello<small>النص الأصلي</small></div></div></div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
<div class="hbox anim"><h4>📨 رحلة الرسالة المشفّرة</h4><svg class="anim-svg" viewBox="0 0 640 195" role="img" aria-label="رحلة رسالة مشفّرة بين مرسل ومستلم">
<g text-anchor="middle" font-size="13" fill="#cdd5ff">
<circle cx="50" cy="70" r="27" fill="#7c5cff33" stroke="#7c5cff"/><text x="50" y="77" font-size="22">📱</text><text x="50" y="118">المرسل</text>
<circle cx="590" cy="70" r="27" fill="#22d3ee26" stroke="#22d3ee"/><text x="590" y="77" font-size="22">💻</text><text x="590" y="118">المستلم</text>
<line class="flow" x1="82" y1="70" x2="558" y2="70" stroke="#94a0ff59" stroke-width="2" stroke-dasharray="5 6"/>
<g transform="translate(200 70)"><g class="lk lk1"><rect x="-12" y="-4" width="24" height="18" rx="4" fill="#fde68a"/><path d="M-7 -4v-6a7 7 0 0 1 14 0v6" fill="none" stroke="#fde68a" stroke-width="3"/></g></g><text x="200" y="112" fill="#fde68a">تشفير</text>
<g transform="translate(440 70)"><g class="lk lk2"><rect x="-12" y="-4" width="24" height="18" rx="4" fill="#fde68a"/><path d="M-7 -4v-6a7 7 0 0 1 14 0v6" fill="none" stroke="#fde68a" stroke-width="3"/></g></g><text x="440" y="112" fill="#fde68a">فك التشفير</text>
<line x1="320" y1="78" x2="320" y2="136" stroke="#fca5a5" stroke-opacity=".5" stroke-dasharray="3 4"/>
<text x="320" y="160" font-size="22">🕵️</text><text x="320" y="184" font-size="12" fill="#fca5a5">المتنصت لا يرى إلا رموزاً</text>
</g>
<g transform="translate(60 70)"><g class="pk"><g class="pp"><rect x="-32" y="-15" width="64" height="30" rx="9" fill="#34f5b81f" stroke="#34f5b8"/><text y="5" font-size="14" font-weight="800" fill="#34f5b8" text-anchor="middle" style="font-family:Courier New,monospace">Hello</text></g><g class="pc"><rect x="-32" y="-15" width="64" height="30" rx="9" fill="#fca5a51f" stroke="#fca5a5"/><text y="5" font-size="14" font-weight="800" fill="#fca5a5" text-anchor="middle" style="font-family:Courier New,monospace">X9#k2</text></g></g></g>
</svg></div>
<div class="hbox anim"><h4>🔑 المفتاحان: العام والخاص</h4><svg class="anim-svg" viewBox="0 0 640 195" role="img" aria-label="المفتاح العام يقفل والمفتاح الخاص يفتح">
<g transform="translate(320 85)"><g class="sh"><path d="M-18 -4v-16a18 18 0 0 1 36 0v16" fill="none" stroke="#cdd5ff" stroke-width="6" stroke-linecap="round"/></g>
<rect x="-34" y="-4" width="68" height="52" rx="10" fill="#1a1450" stroke="#7c5cff" stroke-width="2"/><circle cy="20" r="6" fill="#22d3ee"/></g>
<g transform="translate(120 95)"><g class="k1"><circle cx="-26" r="10" fill="none" stroke="#fde68a" stroke-width="5"/><rect x="-16" y="-2.5" width="42" height="5" rx="2" fill="#fde68a"/><rect x="16" y="2" width="5" height="10" fill="#fde68a"/><rect x="7" y="2" width="5" height="7" fill="#fde68a"/></g></g>
<g transform="translate(520 95) scale(-1 1)"><g class="k2"><circle cx="-26" r="10" fill="none" stroke="#f9a8d4" stroke-width="5"/><rect x="-16" y="-2.5" width="42" height="5" rx="2" fill="#f9a8d4"/><rect x="16" y="2" width="5" height="10" fill="#f9a8d4"/><rect x="7" y="2" width="5" height="7" fill="#f9a8d4"/></g></g>
<g text-anchor="middle" font-size="13"><text x="120" y="135" fill="#fde68a">مفتاح عام</text><text x="520" y="135" fill="#f9a8d4">مفتاح خاص</text>
<text class="c1" x="320" y="172" font-size="14" font-weight="800" fill="#fde68a">المفتاح العام يقفل 🔒</text>
<text class="c2" x="320" y="172" font-size="14" font-weight="800" fill="#f9a8d4">المفتاح الخاص يفتح 🔓</text></g>
</svg></div>
</div>
<h4 class="font-bold text-sm text-white mb-2">لماذا نستخدم التشفير؟ (أهداف الأمان)</h4>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
<div class="hbox goal"><i class="fa-solid fa-eye-slash"></i><h4>السرية</h4><p>لا يقرأ الرسالة إلا المقصود (Confidentiality).</p></div>
<div class="hbox goal"><i class="fa-solid fa-file-circle-check"></i><h4>السلامة</h4><p>التأكد أن الرسالة لم تتغير (Integrity).</p></div>
<div class="hbox goal"><i class="fa-solid fa-fingerprint"></i><h4>التوثيق</h4><p>معرفة هوية المرسل الحقيقي (Authentication).</p></div>
<div class="hbox goal"><i class="fa-solid fa-signature"></i><h4>عدم الإنكار</h4><p>لا يستطيع المرسل إنكار ما أرسله (Non-repudiation).</p></div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
<div class="hbox"><h4>🔑 تشفير متناظر (Symmetric)</h4><p>مفتاح واحد للتشفير وفك التشفير. سريع ويصلح للبيانات الكبيرة. مثال: DES وAES.</p></div>
<div class="hbox"><h4>🔐 تشفير غير متناظر (Asymmetric)</h4><p>مفتاحان: عام للتشفير وخاص لفك التشفير. أبطأ لكنه يحل مشكلة تبادل المفتاح. مثال: RSA وElGamal.</p></div></div>
<p class="text-xs mt-3" style="color:var(--muted)">أين نستخدمه يومياً؟ واتساب، الدخول للبنك، مواقع https، حفظ كلمات السر، والدفع الإلكتروني.</p>
</div>
    <div id="b-terms" class="bpanel"><div class="card-title mb-3"><i class="fa-solid fa-book"></i> المصطلحات المستخدمة</div><div class="gl"><div><b>النص الواضح<span>Plaintext</span></b><p>الرسالة الأصلية قبل التشفير.</p></div><div><b>النص المشفّر<span>Ciphertext</span></b><p>الرسالة بعد التشفير ولا يُفهم محتواها.</p></div><div><b>التشفير<span>Encryption</span></b><p>تحويل النص الواضح إلى مشفّر.</p></div><div><b>فك التشفير<span>Decryption</span></b><p>إرجاع النص المشفّر إلى أصله.</p></div><div><b>الخوارزمية<span>Algorithm / Cipher</span></b><p>الخطوات الرياضية التي تنفذ التشفير.</p></div><div><b>المفتاح<span>Key</span></b><p>القيمة السرية التي يعتمد عليها التشفير وفكه.</p></div><div><b>متناظر<span>Symmetric</span></b><p>مفتاح واحد للطرفين.</p></div><div><b>غير متناظر<span>Asymmetric</span></b><p>زوج مفاتيح: عام وخاص.</p></div><div><b>المفتاح العام<span>Public Key</span></b><p>يُنشر للجميع ويُستخدم للتشفير أو التحقق من التوقيع.</p></div><div><b>المفتاح الخاص<span>Private Key</span></b><p>يحتفظ به صاحبه سراً ويُستخدم لفك التشفير أو التوقيع.</p></div><div><b>دالة الهاش (البصمة)<span>Hash</span></b><p>تحويل أي نص إلى بصمة ثابتة الطول لا يمكن عكسها.</p></div><div><b>التوقيع الرقمي<span>Digital Signature</span></b><p>دليل رياضي على هوية المرسل وسلامة الرسالة.</p></div><div><b>تشفير الكتل<span>Block Cipher</span></b><p>يشفّر البيانات على كتل ثابتة الحجم مثل DES (64 بت).</p></div><div><b>العدد الأولي<span>Prime Number</span></b><p>عدد لا يقبل القسمة إلا على 1 ونفسه، وهو أساس RSA وElGamal.</p></div><div><b>باقي القسمة<span>Modulus (mod)</span></b><p>العملية الأساسية في RSA وElGamal، مثل 17 mod 5 = 2.</p></div><div><b>القوة الغاشمة<span>Brute Force</span></b><p>تجربة كل المفاتيح الممكنة حتى يظهر الصحيح.</p></div><div><b>تحليل التشفير<span>Cryptanalysis</span></b><p>محاولة كسر التشفير دون معرفة المفتاح.</p></div><div><b>الشهادة الرقمية<span>Certificate</span></b><p>وثيقة تربط المفتاح العام بهوية صاحبه، وتصدرها جهة موثوقة.</p></div></div></div>
    <div id="b-sig" class="bpanel">
<div class="card-title mb-2"><i class="fa-solid fa-signature"></i> التوقيع الرقمي (Digital Signature)</div>
<p class="text-sm leading-relaxed mb-4" style="color:#cdd5ff">التوقيع الرقمي يشبه التوقيع بخط اليد لكنه أقوى: يثبت <b>من أرسل الرسالة</b> ويثبت أنها <b>لم تتغير</b> بعد توقيعها. وهو لا يخفي محتوى الرسالة، فهدفه الإثبات وليس السرية.</p>
<div class="vid-stage mb-4" style="min-height:0"><div class="vrow">
<div class="vbox plain">رسالة<small>Message</small></div><div class="varrow">➜</div>
<div class="vbox net">Hash<small>بصمة</small></div><div class="varrow">➜</div>
<div class="vbox priv">مفتاح خاص<small>توقيع</small></div><div class="varrow">➜</div>
<div class="vbox cipher">Signature<small>التوقيع</small></div></div></div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
<div class="hbox"><h4>✍️ عند التوقيع (المرسل)</h4><ol><li>يحسب بصمة الرسالة (Hash).</li><li>يشفّر البصمة بـ<b>مفتاحه الخاص</b>، فتصبح هي التوقيع.</li><li>يرسل الرسالة مع التوقيع.</li></ol><div class="fm">s = hash(m)^d mod n</div></div>
<div class="hbox"><h4>✅ عند التحقق (المستلم)</h4><ol><li>يحسب بصمة الرسالة التي وصلته.</li><li>يفك التوقيع بـ<b>المفتاح العام</b> للمرسل.</li><li>إذا تطابقت البصمتان فالتوقيع صحيح.</li></ol><div class="fm">hash(m) == s^e mod n ?</div></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
<div class="hbox"><h4>أشهر الخوارزميات</h4><p>RSA، وDSA المشتق من فكرة ElGamal، وECDSA، وEd25519.</p></div>
<div class="hbox"><h4>أين يُستخدم؟</h4><p>تحديثات البرامج، شهادات HTTPS، العقود الإلكترونية، والعملات الرقمية.</p></div></div>
<div class="hbox"><h4><i class="fa-solid fa-flask" style="color:var(--accent2)"></i> جرّب بنفسك (RSA: n=3233, e=17, d=2753)</h4>
<input id="sgMsg" class="field mb-2" value="حوّل 100 دينار إلى علي" maxlength="60">
<div class="flex flex-wrap gap-2 mb-2"><button class="btn btn-ghost" onclick="sgSign()"><i class="fa-solid fa-pen-nib"></i> وقّع الرسالة</button><button class="btn btn-ghost" onclick="sgVerify()"><i class="fa-solid fa-circle-check"></i> تحقق من التوقيع</button></div>
<div id="sgOut" class="fm" style="white-space:pre-wrap">وقّع الرسالة أولاً، ثم غيّر حرفاً فيها واضغط «تحقق» لترى فشل التوقيع.</div>
<p class="text-xs mt-2" style="color:var(--muted)">للتوضيح فقط: الهاش هنا مبسّط جداً، أما الواقع فيستخدم SHA-256 ومفاتيح 2048 بت فأكثر.</p></div>
</div>
  </div>
</section>

<!-- RK ext: chapters 2 & 3 -->
<section id="ch23" class="max-w-6xl mx-auto w-full mb-6 fade-in"><div class="card p-5 sm:p-6">
<div class="mb-4"><span class="card-title"><i class="fa-solid fa-book-open"></i> ملخص الفصول الأول والثاني والثالث + الأشكال</span>
<p class="text-xs mt-1" style="color:var(--muted)">من كتاب «نظم التشفير» — شرح مبسّط مع المصطلحات الإنكليزية. المهمات صارت في قائمة مستقلة بجانب الخوارزميات. اضغط على أي عنوان ليفتح.</p></div>
<div class="flex flex-wrap gap-2 mb-4">
<button class="btn btn-ghost kxt on" data-k="c1">📘 الفصل 1: المقدمة</button>
<button class="btn btn-ghost kxt" data-k="c2">📐 الفصل 2: الرياضيات</button>
<button class="btn btn-ghost kxt" data-k="c3">🔤 الفصل 3: التقليدية</button>
<button class="btn btn-ghost kxt" data-k="figs">🖼️ الأشكال</button></div>

<div id="k-c1" class="kxp on"><figure class="ch-ill"><img src="data:image/svg+xml;base64," alt="الفصل الأول: مقدمة في التشفير" loading="lazy"><figcaption>🖼️ رسم توضيحي: النص الصريح يتحول إلى نص مشفّر بمفتاح، ويعود بفك التشفير · اضغط على الصورة للتكبير والتنزيل أو المشاركة</figcaption></figure><p class="text-sm mb-3" style="color:var(--muted)">ملخص الفصل الأول: ما هو التشفير ولماذا نحتاجه، أهداف الأمان، وأنواع التشفير (المتناظر وغير المتناظر).</p><details class="kd" open><summary>تعريف التشفير <span class="enx">(Encryption / Cryptography)</span></summary><div><p><b>التشفير</b> <span class="enx">(Encryption)</span> هو عملية ضمان الخصوصية <span class="enx">(Privacy)</span> بتحويل البيانات إلى صيغة غير مفهومة، ثم إعادتها إلى شكلها الأصلي عند وصولها إلى الجهة المخوّلة.</p><p>• <b>علم الشفرة</b> <span class="enx">(Cryptology)</span> = علم التشفير <span class="enx">(Cryptography)</span> + علم تحليل الشفرة <span class="enx">(Cryptanalysis)</span>.</p><p>• نظام التشفير <span class="enx">(Cryptosystem)</span>: خوارزمية مدخلاتها نص مفهوم ومخرجاتها نص مشفّر، وتُنفَّذ برمجياً <span class="enx">(Software)</span> أو مادياً <span class="enx">(Hardware)</span>.</p></div></details><details class="kd"><summary>أهداف الأمان <span class="enx">(Security Goals)</span></summary><div><p>1) <b>السرية والخصوصية</b> <span class="enx">(Confidentiality / Privacy)</span>: لا يقرأ الرسالة إلا المخوّل.</p><p>2) <b>تكاملية البيانات</b> <span class="enx">(Data Integrity)</span>: كشف أي حذف أو إضافة أو استبدال غير مصرّح به.</p><p>3) <b>إثبات الهوية</b> <span class="enx">(Authentication)</span>: إثبات الكينونة <span class="enx">(Entity Authentication)</span> وإثبات مصدر البيانات <span class="enx">(Data Origin Authentication)</span>.</p><p>4) <b>التوقيع الرقمي</b> <span class="enx">(Digital Signature)</span>.</p><p>5) <b>عدم الإنكار</b> <span class="enx">(Non-Repudiation)</span>: المرسل لا يستطيع إنكار إرساله.</p><p>6) <b>التفويض</b> <span class="enx">(Authorization)</span> مع التحكم بالوصول <span class="enx">(Access Control)</span>.</p><p>7) <b>الكفاءة والسرعة</b> <span class="enx">(Performance &amp; Rapidity)</span> &nbsp; 8) <b>المرونة</b> <span class="enx">(Flexibility)</span> &nbsp; 9) <b>الكلفة</b> <span class="enx">(Cost)</span>.</p></div></details><details class="kd"><summary>التشفير المتناظر <span class="enx">(Symmetric-Key Encryption)</span></summary><div><p>مفتاح <b>واحد سري</b> للتشفير وفك التشفير <span class="enx">(Secret Key)</span>، ويسمى أيضاً التقليدي أو الكلاسيكي <span class="enx">(Conventional / Classical)</span>.</p><p>• <b>انسيابي</b> <span class="enx">(Stream Cipher)</span>: يعالج بتاً أو بايتاً واحداً كل مرة. • <b>كتلي</b> <span class="enx">(Block Cipher)</span>: يعالج كتلاً بحجم 64 أو 128 بت.</p><p>✅ سريع وكفؤ. ⚠️ مشكلته إدارة المفاتيح <span class="enx">(Key Management)</span> وتوزيعها بأمان.</p></div></details><details class="kd"><summary>التشفير غير المتناظر <span class="enx">(Asymmetric / Public-Key Encryption)</span></summary><div><p>زوج مفاتيح: <b>عام</b> <span class="enx">(Public Key)</span> للتشفير و<b>خاص</b> <span class="enx">(Private Key)</span> لفك التشفير. أبطأ لكنه يحل مشكلة تبادل المفتاح، ومن أمثلته RSA وElGamal.</p></div></details><details class="kd"><summary>مصطلحات مهمة <span class="enx">(Basic Terminology)</span></summary><div><p>النص الواضح <span class="enx">(Plaintext)</span> • النص المشفّر <span class="enx">(Ciphertext)</span> • التشفير <span class="enx">(Encryption)</span> • فك التشفير <span class="enx">(Decryption)</span> • المفتاح <span class="enx">(Key)</span> • نظام التشفير <span class="enx">(Cryptosystem)</span></p></div></details><details class="kd"><summary>نبذة تاريخية <span class="enx">(Brief History)</span></summary><div><p>مع انتشار الحواسيب والاتصالات بذلت IBM في بداية السبعينيات جهداً لاعتماد طريقة جديدة سُمّيت DES <span class="enx">(Data Encryption Standard)</span> لحماية معلومات البنوك، ثم جاء RSA وElGamal كأنظمة مفتاح عام. التفاصيل في قائمة «تاريخ الخوارزميات».</p></div></details><details class="kd"><summary>أمنية أنظمة التشفير <span class="enx">(Security of Cryptosystems)</span></summary><div><p>مقاييس حماية مراكز المعلومات <span class="enx">(Security Requirements)</span>: الحماية من التهديدات الطبيعية، والتنصت الخارجي، والأمن الداخلي <span class="enx">(Internal Security)</span> والخارجي <span class="enx">(External Security)</span>، والتعريف <span class="enx">(Identification)</span> بكلمة السر <span class="enx">(Password)</span>، والنسخ الاحتياطي <span class="enx">(Backup)</span>.</p><p>التوقيع الرقمي يربط الرسالة بوقت التوقيع <span class="enx">(Timestamp)</span> وهوية المرسل.</p></div></details><details class="kd" open><summary>الشكل (1-1): تصنيف أنظمة التشفير <span class="enx">(Classification of Cryptosystems)</span></summary><div><figure class="fig"><img data-fig="f11" alt="الشكل (1-1): تصنيف أنظمة التشفير — Classification of Cryptosystems"><figcaption>الشكل (1-1): تصنيف أنظمة التشفير — Classification of Cryptosystems</figcaption></figure></div></details></div>

<div id="k-c2" class="kxp"><figure class="ch-ill"><img src="data:image/svg+xml;base64," alt="الفصل الثاني: الأساسيات الرياضية" loading="lazy"><figcaption>🖼️ رسم توضيحي: دالة أويلر والحساب المقياسي والمصفوفات والمنطق والأعداد الأولية · اضغط على الصورة للتكبير والتنزيل أو المشاركة</figcaption></figure>
<p class="text-sm mb-3" style="color:var(--muted)">الرياضيات التي يقوم عليها التشفير: أعداد، مصفوفات، احتمالات، ومنطق.</p>
<details class="kd" open><summary><i class="mi" data-i="bits"></i>الأنظمة الرقمية <span class="enx">(Number Systems)</span></summary><div>
<p>الأنظمة التي تعتمدها الحواسيب والاتصالات:</p><p>• <b>العشري</b> (0–9) • <b>الثنائي</b> (0,1) • <b>الثماني</b> (0–7) • <b>السداسي عشري</b> (0–9 وA–F).</p><p>الثنائي هو لغة الأجهزة، والتشفير يتعامل مع البتات.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="prime"></i>الأعداد الأولية <span class="enx">(Prime Numbers)</span></summary><div>
<p>العدد الأولي له قاسمان فقط: 1 ونفسه، مثل <span class="l">2, 3, 5, 7, 11, 13, 17</span>.</p>
<p>• العدد 2 هو الأولي <b>الزوجي</b> الوحيد.</p><p>• <b>غربال إراتوستين (Sieve)</b>: نحذف مضاعفات 2 ثم 3 ثم 5 ثم 7 فتبقى الأعداد الأولية.</p>
<p>• <b>النظرية الأساسية للحساب</b> <span class="enx">(Fundamental Theorem of Arithmetic)</span>: كل عدد أكبر من 1 يُكتب بشكل وحيد كحاصل ضرب أعداد أولية. مثال: <span class="l">2000 = 2⁴ × 5³</span></p></div></details>
<details class="kd"><summary><i class="mi" data-i="div"></i>القسمة وخوارزمية إقليدس <span class="enx">(Division &amp; Euclidean Algorithm)</span></summary><div>
<p>• <b>gcd</b> القاسم المشترك الأكبر، <b>lcm</b> المضاعف المشترك الأصغر: <span class="l">lcm = a·b / gcd</span></p>
<p>• عددان <b>أوليان نسبياً</b> إذا كان gcd = 1.</p><p>• <b>باقي القسمة mod</b> <span class="enx">(Modulo)</span>: <span class="l">13 mod 5 = 3</span></p>
<p>• <b>إقليدس</b> <span class="enx">(Euclid)</span>: <span class="l">gcd(a,b) = gcd(b, a mod b)</span> نكرر حتى يصبح الباقي صفراً.</p>
<p>مثال <span class="l">gcd(258,102)</span>: 258 = 2×102+54 ← 102 = 1×54+48 ← 54 = 1×48+6 ← 48 = 8×6+0 ⇒ الناتج <b>6</b>.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="phi"></i>دالة أويلر φ(n) <span class="enx">(Euler's Totient Function)</span></summary><div>
<p>φ(n) = عدد الأعداد الأصغر من n والأولية نسبياً معه.</p>
<p>• n أولي: <span class="l">φ(n) = n − 1</span></p><p>• n = p·q (أوليان): <span class="l">φ(n) = (p−1)(q−1)</span> — وهي أساس RSA.</p><p>• n = pᵏ: <span class="l">φ = pᵏ − pᵏ⁻¹</span></p></div></details>
<details class="kd"><summary><i class="mi" data-i="mat"></i>المصفوفات والمعادلات الخطية <span class="enx">(Matrices &amp; Linear Equations)</span></summary><div>
<p><b>المصفوفة</b> <span class="enx">(Matrix)</span>: ترتيب مستطيل من صفوف وأعمدة. أنواعها: مربعة، صفرية، قطرية، واحدية (I)، مدورة (Aᵀ)، مثلثية.</p>
<p><b>العمليات</b> <span class="enx">(Operations)</span>: الضرب بثابت، الجمع (لنفس الدرجة فقط)، والضرب (أعمدة الأولى = صفوف الثانية).</p>
<p><b>المحدد 2×2</b> <span class="enx">(Determinant)</span>: <span class="l">|A| = ad − bc</span>. إذا |A| ≠ 0 فللمصفوفة معكوس.</p>
<p><b>حل AX = B</b>: إما <span class="l">X = A⁻¹B</span> أو <b>قاعدة كرامر</b> <span class="l">xᵢ = Dᵢ / D</span>.</p>
<p>مثال: 3x₁−2x₂=6 و 2x₁+x₂=0.5 ⇒ |A|=7 ⇒ <span class="l">x₁=1 , x₂=−1.5</span></p></div></details>
<details class="kd"><summary><i class="mi" data-i="wave"></i>المتتابعات والمتسلسلات <span class="enx">(Sequences &amp; Series)</span></summary><div>
<p>• <b>المتتابعة</b> <span class="enx">(Sequence)</span>: قائمة مرتبة من الأعداد، والثنائية منها (مثل 1,0,0,1,1,0) مهمة للتشفير الانسيابي.</p>
<p>• المتتابعة <b>الدورية</b> <span class="enx">(Periodic)</span> تعيد نفسها بعد p حدّ.</p>
<p>• المتسلسلة الهندسية <span class="l">a + ar + ar² + …</span> تتقارب إذا |r| &lt; 1 وتتباعد إذا |r| ≥ 1.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="poly"></i>متعددات الحدود <span class="enx">(Polynomials)</span></summary><div>
<p>الدالة <span class="l">f(x) = aₙxⁿ + … + a₀</span> لها على الأكثر n جذراً.</p>
<p>في الحقل GF(2) المعاملات 0 أو 1، فتُكتب بالبتات: <span class="l">x³+x+1 ↔ 01011</span></p>
<p>• الجمع = <b>XOR</b> (1+1=0).</p><p>• مثال ضرب: <span class="l">(x²+x+1)(x³+x+1) = x⁵+x⁴+1</span></p>
<p>• <b>غير القابلة للاختزال</b> <span class="enx">(Irreducible)</span> لا تتحلل إلى عوامل، وهي تشبه الأعداد الأولية.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="dice"></i>الإحصاء والاحتمالية <span class="enx">(Statistics &amp; Probability)</span></summary><div>
<p>• <b>فضاء العينة S</b> <span class="enx">(Sample Space)</span>: كل النتائج الممكنة، و<b>الحدث E</b> <span class="enx">(Event)</span> جزء منها.</p>
<p>• <span class="l">0 ≤ P(E) ≤ 1</span> ، <span class="l">P(S)=1</span> ، <span class="l">P(E)=|E|/|S|</span> (للنتائج المتساوية)، <span class="l">P(Ē)=1−P(E)</span></p>
<p>• الحدثان <b>المتنافيان</b> <span class="enx">(Mutually Exclusive)</span>: <span class="l">P(E₁∩E₂)=0</span> فيكون <span class="l">P(E₁∪E₂)=P(E₁)+P(E₂)</span></p>
<p>مثال النرد: احتمال ظهور 2 = 1/6، واحتمال ظهور أقل من 4 = 3/6 = 0.5</p></div></details>
<details class="kd"><summary><i class="mi" data-i="gate"></i>المنطق الرياضي والدوائر المنطقية <span class="enx">(Mathematical Logic &amp; Logic Circuits)</span></summary><div>
<p>بوابات الدوائر الإلكترونية: <b>AND</b> (ضرب)، <b>OR</b> (جمع)، <b>NOT</b> (متمم)، <b>XOR</b> (جمع بدون حمل: 1⊕1=0).</p>
<p>الـ XOR هو قلب التشفير الحديث. وإذا اختفى متغير بعد تبسيط الدالة فهو غير مؤثر ويمكن حذفه من الدائرة.</p></div></details>
</div>

<div id="k-c3" class="kxp"><figure class="ch-ill"><img src="data:image/svg+xml;base64," alt="الفصل الثالث: أنظمة التشفير التقليدية" loading="lazy"><figcaption>🖼️ رسم توضيحي: عجلة قيصر (التعويضي) وجدول التبديل (الانتقالي) · اضغط على الصورة للتكبير والتنزيل أو المشاركة</figcaption></figure>
<p class="text-sm mb-3" style="color:var(--muted)"><b>التشفير المتناظر</b> = مفتاح واحد للتشفير وفك التشفير. هذه الأنظمة التقليدية هي أقدم طرق حماية المعلومات.</p>
<details class="kd" open><summary><i class="mi" data-i="bits"></i>المصطلحات الأساسية <span class="enx">(Basic Terms)</span></summary><div>
<p>• <b>النص الواضح</b> (Plaintext) • <b>النص المشفّر</b> (Ciphertext) • <b>المفتاح</b> (Key) • <b>الخوارزمية</b> (Cipher).</p>
<p>• <b>تعويضي</b> <span class="enx">(Substitution)</span>: نبدّل الحرف بحرف آخر. • <b>انتقالي</b> <span class="enx">(Transposition)</span>: نغيّر أماكن الحروف فقط.</p>
<p>• <b>تحليل التكرار</b> <span class="enx">(Frequency Analysis)</span>: كسر الشفرة بدراسة الحروف الأكثر ظهوراً.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="caesar"></i>النظام التعويضي (3 أنواع) <span class="enx">(Substitution Cipher (3 types))</span></summary><div>
<p>1) <b>القياسي (قيصر)</b> <span class="enx">(Caesar Cipher)</span>: إزاحة ثابتة. بإزاحة 2: <span class="l">HELP → JGNR</span></p>
<p>2) <b>العشوائي</b> <span class="enx">(Random Substitution)</span>: جدول تبديل عشوائي ثابت (CAT ← ZQV). أصعب، لكنه ينكسر بتحليل التكرار.</p>
<p>3) <b>متعدد القيم</b> <span class="enx">(Homophonic)</span>: الحرف الواحد له عدة رموز رقمية (الحرف R صار 60 مرة و41 مرة)، فيقاوم تحليل التكرار. مثال <span class="l">CRYPTOGRAPHY → 82 60 29 28 46 75 16 41 30 44 50 83</span></p>
<table class="kx-tbl"><tr><th>النوع</th><th>القاعدة</th><th>القوة</th></tr><tr><td>قياسي</td><td>إزاحة ثابتة</td><td>متوسطة</td></tr><tr><td>عشوائي</td><td>ربط عشوائي ثابت</td><td>أقوى</td></tr><tr><td>متعدد القيم</td><td>أكثر من رمز للحرف</td><td>الأقوى</td></tr></table></div></details>
<details class="kd"><summary><i class="mi" data-i="cols"></i>النظام الانتقالي (بسيط ومضاعف) <span class="enx">(Transposition Cipher (Simple &amp; Double))</span></summary><div>
<p>نكتب النص في جدول صفاً صفاً، ثم نقرأ <b>الأعمدة</b> بترتيب المفتاح (نضيف X للحشو).</p>
<p>مثال: <span class="l">MEETATDAWN</span> بمفتاح <span class="l">2,4,1,3</span> ⇒ <span class="l">ETNTAXMAWEDX</span></p>
<p>الانتقالي <b>المضاعف</b> <span class="enx">(Double)</span>: نكرر العملية مرتين بنفس المفتاح أو بمفتاحين.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="poly3"></i>نظام متعدد الأبجديات <span class="enx">(Polyalphabetic Cipher)</span></summary><div>
<p>• <b>بدون مفتاح</b> <span class="enx">(Keyless)</span>: عدة أبجديات تتناوب (إزاحات 1،2،3). <span class="l">CRYPTOSYSTEM → DTBQVRTAVUGP</span> والحرف T المكرر شُفّر مرة V ومرة U.</p>
<p>• <b>بمفتاح (فيجينر)</b> <span class="enx">(Vigenère Cipher)</span>: نجمع قيمة حرف المفتاح (mod 26). <span class="l">HELLO + KEY → RIJVS</span></p>
<p>✅ يصعب تحليله بالتكرار. ⚠️ ضعيف إذا كان المفتاح قصيراً.</p></div></details>
<details class="kd"><summary><i class="mi" data-i="mat"></i>التشفير بالمصفوفات <span class="enx">(Matrix (Hill) Cipher)</span></summary><div>
<p>نحوّل النص لأرقام (A=0…Z=25) ونضرب بمصفوفة المفتاح: <span class="l">C = K·P mod 26</span> ، والفك: <span class="l">P = K⁻¹·C</span></p>
<p><b>الشرط</b> <span class="enx">(Condition)</span>: المفتاح مربع وله معكوس mod 26 (أي gcd(det,26)=1).</p>
<p>مثال: <span class="l">HELP</span> بمفتاح <span class="l">[[3,3],[2,5]]</span> ⇒ <span class="l">HIAT</span></p></div></details>
<details class="kd"><summary><i class="mi" data-i="otp"></i>نظام المفتاح الواحد (OTP) <span class="enx">(One-Time Pad)</span></summary><div>
<p>مفتاح عشوائي بطول النص يُستخدم <b>مرة واحدة</b>: <span class="l">C = (P + K) mod 10</span> ، والفك <span class="l">P = (C − K) mod 10</span></p>
<p>✅ غير قابل للكسر نظرياً وسريع. ⚠️ مشكلته توزيع المفتاح بأمان، وإذا سُرق انكشفت كل البيانات.</p>
<p>نصائح: مفتاح طويل وعشوائي بدون تكرار، خزّنه بأمان، ولا ترسله برسائل غير مشفرة.</p></div></details>
<h4 class="font-bold text-sm text-white mt-4 mb-2">أسئلة سريعة من الكتاب</h4>
<details class="kd"><summary>ما الإزاحة 3 لحرف A؟ وماذا تعطي كلمة DOG؟</summary><div>A ← <b>D</b> ، و DOG ← <b>GRJ</b></div></details>
<details class="kd"><summary>HELLO بالانتقالي (تبديل كل حرفين)؟</summary><div><b>EHLLO</b></div></details>
<details class="kd"><summary>ما أبرز ضعف في شفرة قيصر؟</summary><div>سهولة كسرها بالتحليل الإحصائي أو بتجربة كل الإزاحات (25 احتمالاً فقط).</div></details>
<details class="kd"><summary>ما الشرط الأساسي لمصفوفة المفتاح؟</summary><div>أن يكون لها <b>معكوس</b> في حسابات mod 26.</div></details>
</div>

<div id="k-figs" class="kxp"><p class="text-sm mb-3" style="color:var(--muted)">أشكال الكتاب مجمّعة حسب الفصل، وكل شكل موجود أيضاً داخل الفصل الذي ينتمي إليه.</p><h4 class="font-bold text-sm text-white mb-1">الفصل الأول <span class="enx">(Chapter 1)</span></h4><figure class="fig"><img data-fig="f11" alt="الشكل (1-1): تصنيف أنظمة التشفير"><figcaption>الشكل (1-1): تصنيف أنظمة التشفير</figcaption></figure><h4 class="font-bold text-sm text-white mt-4 mb-1">الفصل الثاني <span class="enx">(Chapter 2)</span></h4><figure class="fig"><img data-fig="f24" alt="الشكل (2-1): البوابات المنطقية AND / OR / NOT / XOR"><figcaption>الشكل (2-1): البوابات المنطقية AND / OR / NOT / XOR</figcaption></figure><figure class="fig"><img data-fig="f25" alt="الجدول (2-1): جداول الحقيقة للبوابات الأربع"><figcaption>الجدول (2-1): جداول الحقيقة للبوابات الأربع</figcaption></figure><h4 class="font-bold text-sm text-white mt-4 mb-1">الفصل الثالث <span class="enx">(Chapter 3)</span></h4><figure class="fig"><img data-fig="f33" alt="الجدول (3-2): الفروقات بين النظم التعويضية"><figcaption>الجدول (3-2): الفروقات بين النظم التعويضية</figcaption></figure><figure class="fig"><img data-fig="f34" alt="الجدول (3-3): الانتقالي البسيط (MEET AT DAWN)"><figcaption>الجدول (3-3): الانتقالي البسيط (MEET AT DAWN)</figcaption></figure><figure class="fig"><img data-fig="f35" alt="الجدول (3-5): جدول الترميز القياسي"><figcaption>الجدول (3-5): جدول الترميز القياسي</figcaption></figure><figure class="fig"><img data-fig="f36" alt="الجدول (3-6): التشفير بنظام فيجينر HELLO + KEY → RIJVS"><figcaption>الجدول (3-6): التشفير بنظام فيجينر HELLO + KEY → RIJVS</figcaption></figure></div></div></section>


<!-- Main -->
<main id="lab" class="max-w-6xl mx-auto w-full flex-grow grid grid-cols-1 lg:grid-cols-12 gap-6">

  <div class="lg:col-span-6 flex flex-col gap-5 fade-in">
    <div class="card p-5 sm:p-6 space-y-5">
      <div>
        <label class="label"><i class="fa-solid fa-microchip"></i> اختر خوارزمية التشفير:</label>
        <select id="algorithm" onchange="toggleKeyInputs()" class="field font-bold">
          <option value="rsa">RSA - التشفير غير المتناظر بالمفتاح العام (Asymmetric)</option>
          <option value="elgamal">ElGamal - اللوغاريتمات المتقطعة</option>
          <option value="des">DES المبسط - تشفير متناظر (XOR)</option>
        </select>
      </div>

      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="inputText" class="label !mb-0"><i class="fa-solid fa-file-signature"></i> النص / الشفرة:</label>
          <button onclick="fillExample()" class="btn btn-ghost"><i class="fa-solid fa-wand-magic-sparkles"></i> مثال تجريبي</button>
        </div>
        <textarea id="inputText" rows="3" class="field mono" placeholder="اكتب النص للتشفير أو الرموز لفك التشفير... (عربي / English)"></textarea>
<div class="tools3"><button class="btn tb tb-copy" onclick="copyInput()"><i class="fa-solid fa-copy"></i> نسخ النص</button><button class="btn tb tb-paste" onclick="pasteInput()"><i class="fa-solid fa-paste"></i> لصق النص</button><button class="btn tb tb-del" onclick="clearInput()"><i class="fa-solid fa-trash-can"></i> حذف النص</button></div>
      </div>

      <div class="adv">
        <div class="adv-head" onclick="toggleAdvancedSettings()">
          <span><i class="fa-solid fa-sliders" style="color:var(--accent2)"></i> إعدادات المفاتيح (متقدم/اختياري)</span>
          <i id="settingsChevron" class="fa-solid fa-chevron-down text-xs transition-transform duration-200"></i>
        </div>
        <div id="advancedSettings" class="hidden mt-4 pt-3 space-y-3" style="border-top:1px solid var(--border)">
          <div id="rsaKeys" class="grid grid-cols-3 gap-2">
            <div><label class="k-label">P (أولي)</label><input type="number" id="rsaP" value="61" class="k-input"></div>
            <div><label class="k-label">Q (أولي)</label><input type="number" id="rsaQ" value="53" class="k-input"></div>
            <div><label class="k-label">E (عام)</label><input type="number" id="rsaE" value="17" class="k-input"></div>
          </div>
          <div id="elgamalKeys" class="hidden grid grid-cols-3 gap-2">
            <div><label class="k-label">P (أولي)</label><input type="number" id="elgamalP" value="467" class="k-input"></div>
            <div><label class="k-label">G (المولد)</label><input type="number" id="elgamalG" value="2" class="k-input"></div>
            <div><label class="k-label">X (خاص)</label><input type="number" id="elgamalX" value="153" class="k-input"></div>
          </div>
          <div id="desKeys" class="hidden">
            <label class="k-label">المفتاح (Hex Byte - 8 bit)</label>
            <input type="text" id="desKey" value="5A" maxlength="2" class="k-input">
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-1">
        <button onclick="handleEncrypt()" class="btn btn-enc"><i class="fa-solid fa-lock"></i> تشفير</button>
        <button onclick="handleDecrypt()" class="btn btn-dec"><i class="fa-solid fa-lock-open"></i> فك التشفير</button>
      </div>
    </div>

    <div class="card p-4 sm:p-5 text-sm space-y-2">
      <div id="algoInfoTitle" class="card-title"><i class="fa-solid fa-circle-info"></i> معلومات الخوارزمية</div>
      <p id="algoInfoDesc" class="leading-relaxed" style="color:var(--muted)"></p>
    </div>
  </div>

  <div class="lg:col-span-6 flex flex-col gap-5 fade-in">
    <div class="card p-5 sm:p-6 space-y-4">
      <div class="flex items-center justify-between">
        <span class="card-title"><i class="fa-solid fa-square-poll-vertical"></i> النتيجة النهائية (Output)</span>
        <button onclick="copyResult()" class="btn btn-ghost"><i class="fa-solid fa-copy"></i> نسخ النتيجة</button>
      </div>
      <div id="finalResult" class="result-box">النتيجة ستظهر هنا...</div>
    </div>

    <div class="card p-5 sm:p-6 flex-grow flex flex-col space-y-3">
      <div class="flex items-center justify-between">
        <span class="card-title"><i class="fa-solid fa-list-check"></i> الشرح الرياضي (Step-by-Step)</span>
        <button onclick="copyLog()" class="btn btn-ghost"><i class="fa-solid fa-clipboard-list"></i> نسخ خطوات الشرح (Copy Math Log)</button>
      </div>
      <div id="stepsLog" class="custom-scrollbar log-box">// لا يوجد تشغيل حالياً.
// أدخل النص واضغط تشفير أو فك التشفير لمشاهدة العمليات الرياضية.</div>
    </div>
  </div>
</main>

<section id="tasksSec" class="max-w-6xl mx-auto w-full mt-8 fade-in"><div class="card p-5 sm:p-6">
<div class="mb-4"><span class="card-title"><i class="fa-solid fa-list-check"></i> المهمات (Tasks)</span>
<p class="text-xs mt-1" style="color:var(--muted)">تمارين الفصلين الثاني والثالث تعمل مباشرة، وكل زر «مثال» يعطيك نصاً متعدد الكلمات وبمفاتيح عشوائية جديدة.</p></div><div class="hbox mb-4" id="matTask"><h4>🧱 مهمة المصفوفات (Matrices)</h4>
<details class="kd" open><summary>📘 شرح مبسّط <span class="enx">(Simple Explanation)</span></summary><div>
<p><b>المصفوفة</b> <span class="enx">(Matrix)</span> جدول أرقام مرتب في صفوف وأعمدة، مثل <span class="l">[[1,2],[3,4]]</span>.</p>
<p>• <b>الجمع</b> <span class="enx">(Addition)</span>: نجمع الخانات المتقابلة.</p>
<p>• <b>الضرب</b> <span class="enx">(Multiplication)</span>: نضرب <b>صفّ</b> الأولى في <b>عمود</b> الثانية ونجمع النواتج.</p>
<p>• <b>المحدد</b> <span class="enx">(Determinant)</span> للمصفوفة 2×2: <span class="l">ad − bc</span>. إذا كان ≠ 0 فلها معكوس.</p>
<p>• <b>المعكوس</b> <span class="enx">(Inverse)</span>: <span class="l">A⁻¹ = (1/|A|)·[[d,−b],[−c,a]]</span>، وبه نحل <span class="l">AX = C</span>.</p>
<p>• في التشفير (Hill Cipher) نعمل بالباقي <span class="l">mod 26</span> ونحتاج <span class="l">gcd(|A|,26)=1</span>.</p></div></details>
<div class="grid grid-cols-2 gap-3 mb-2" dir="ltr">
<div><div class="k-label">A</div><div class="grid grid-cols-2 gap-1"><input id="ma0" class="k-input" type="number" value="3"><input id="ma1" class="k-input" type="number" value="3"><input id="ma2" class="k-input" type="number" value="2"><input id="ma3" class="k-input" type="number" value="5"></div></div>
<div><div class="k-label">B</div><div class="grid grid-cols-2 gap-1"><input id="mb0" class="k-input" type="number" value="1"><input id="mb1" class="k-input" type="number" value="2"><input id="mb2" class="k-input" type="number" value="0"><input id="mb3" class="k-input" type="number" value="4"></div></div></div>
<div class="kx-row"><button class="btn btn-ghost" data-m="add">A + B</button><button class="btn btn-ghost" data-m="mul">A × B</button><button class="btn btn-ghost" data-m="det">|A|</button><button class="btn btn-ghost" data-m="inv">A⁻¹</button><button class="btn btn-ghost" data-m="mod">A⁻¹ mod 26</button><button class="btn btn-ghost" data-m="rnd">🎲 مثال عشوائي</button></div>
<div id="mout" class="kx-out mono" dir="ltr">اختر عملية لتظهر الخطوات.</div></div><div id="k-lab">
<p class="text-sm mb-3" style="color:var(--muted)">مهمات الكتاب العملية (تمرين 1 إلى 6) تعمل هنا مباشرة. اختر النظام ثم شفّر وفكّ.</p>
<div class="hbox mb-4"><h4>🧮 مهمة الفصل الثاني: إقليدس وأويلر</h4>
<div class="kx-row"><input id="xa" class="field" style="max-width:140px" type="number" inputmode="numeric" value="4864"><input id="xb" class="field" style="max-width:140px" type="number" inputmode="numeric" value="3458"><button class="btn btn-ghost" id="xgo"><i class="fa-solid fa-calculator"></i> احسب</button></div>
<div id="xout" class="kx-out mono" dir="ltr">اضغط «احسب» لترى خطوات gcd و lcm و φ.</div></div>
<div class="hbox"><h4>🔐 مهمات الفصل الثالث: مختبر الشفرات</h4>
<select id="cm" class="field mb-2" style="margin-top:.4rem">
<option value="caesar">تمرين 1: تعويضي قياسي (قيصر)</option><option value="rand">تمرين 1: تعويضي عشوائي</option><option value="trans">تمرين 3: انتقالي بسيط</option><option value="poly">تمرين 4: متعدد الأبجديات (بدون مفتاح)</option><option value="vig">متعدد الأبجديات (فيجينر)</option><option value="mat">تمرين 5: المصفوفات (2×2)</option><option value="otp">تمرين 6: المفتاح الواحد OTP</option></select>
<input id="ct" class="field mb-2 mono" dir="ltr" placeholder="النص (إنجليزي) / الأرقام عند فك OTP">
<input id="ck" class="field mono" dir="ltr" placeholder="المفتاح">
<p id="ch" class="text-xs mt-1" style="color:var(--muted)"></p>
<div class="kx-row"><button class="btn btn-ghost" id="cenc"><i class="fa-solid fa-lock"></i> تشفير</button><button class="btn btn-ghost" id="cdec"><i class="fa-solid fa-lock-open"></i> فك التشفير</button><button class="btn btn-ghost" id="cex"><i class="fa-solid fa-wand-magic-sparkles"></i> مثال الكتاب</button></div>
<div id="cout" class="kx-out mono" dir="ltr">النتيجة تظهر هنا.</div></div>
</div>
</div></section>
<!-- ===== مركز تسليم الملفات (قائمة منزلقة + زر عائم) ===== -->
<style>
#sendSec{scroll-margin-top:14px}
.sb-cta-in{display:flex;flex-wrap:wrap;align-items:center;gap:1rem}
.sb-ico{width:54px;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 10px 26px -8px rgba(124,92,255,.8)}
.sb-badge{position:absolute;top:-5px;left:-5px;min-width:21px;height:21px;padding:0 5px;border-radius:11px;background:#ef4444;color:#fff;font-size:.7rem;font-weight:900;display:flex;align-items:center;justify-content:center;border:2px solid #0b1030;font-family:Tajawal,sans-serif}
.sb-badge[data-n="0"]{display:none}
.sb-badge.in{position:static;border:0;display:inline-flex}
.sb-badge.in[data-n="0"]{display:none}
/* FAB */
#sbFab{position:fixed;right:14px;bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:58;width:56px;height:56px;border-radius:50%;border:0;color:#fff;font-size:1.25rem;cursor:pointer;background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 10px 30px -6px rgba(124,92,255,.85);display:flex;align-items:center;justify-content:center;transition:transform .2s,background .3s}
#sbFab:hover{transform:translateY(-3px) scale(1.05)}#sbFab:active{transform:scale(.9)}
#sbFab.pend::before{content:"";position:absolute;inset:-4px;border-radius:50%;border:2px solid var(--accent2);animation:sbpulse 1.8s ease-out infinite}
#sbFab.busy::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:3px solid transparent;border-top-color:#fff;border-left-color:rgba(255,255,255,.4);animation:sbspin .8s linear infinite}
#sbFab.ok{background:linear-gradient(135deg,#10b981,#14b8c4)}
@keyframes sbpulse{0%{transform:scale(.9);opacity:.9}100%{transform:scale(1.5);opacity:0}}
@keyframes sbspin{to{transform:rotate(360deg)}}
@media(min-width:700px){#sbFab{right:24px;bottom:26px}}
/* Sheet */
.sb-ov{position:fixed;inset:0;z-index:70;background:rgba(2,4,15,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0;pointer-events:none;transition:opacity .25s}
.sb-ov.on{opacity:1;pointer-events:auto}
#sbSheet{position:fixed;z-index:71;left:0;right:0;bottom:0;max-height:92vh;max-height:92dvh;display:flex;flex-direction:column;background:var(--cb,#0e1430);color:var(--text);border:1px solid var(--border);border-bottom:0;border-radius:26px 26px 0 0;box-shadow:0 -20px 60px -10px rgba(0,0,0,.75);padding-bottom:env(safe-area-inset-bottom,0px);transform:translateY(105%);visibility:hidden;transition:transform .38s cubic-bezier(.2,.9,.25,1),visibility 0s .38s}
#sbSheet.on{transform:none;visibility:visible;transition:transform .38s cubic-bezier(.2,.9,.25,1),visibility 0s}
@media(min-width:760px){#sbSheet{left:50%;right:auto;top:50%;bottom:auto;width:580px;max-height:88vh;border-radius:26px;border-bottom:1px solid var(--border);transform:translate(-50%,-46%) scale(.94);opacity:0;transition:transform .3s,opacity .25s,visibility 0s .3s}
 #sbSheet.on{transform:translate(-50%,-50%);opacity:1;transition:transform .3s,opacity .25s,visibility 0s}}
#sbSheet.drag{outline:2px dashed var(--accent2);outline-offset:-8px}
.sb-grab{display:flex;justify-content:center;padding:.6rem 0 .2rem;touch-action:none}
.sb-grab i{width:44px;height:5px;border-radius:5px;background:rgba(148,163,255,.4)}
@media(min-width:760px){.sb-grab{display:none}}
.sb-hd{display:flex;align-items:center;gap:.7rem;padding:.4rem 1.1rem .8rem;touch-action:none}
.sb-ttl{flex:1;min-width:0}.sb-ttl b{display:block;font-weight:900;font-size:1.02rem}.sb-ttl small{color:var(--muted);font-size:.72rem}
.sb-cl{width:38px;height:38px;border-radius:12px;border:1px solid var(--border);background:rgba(124,92,255,.14);color:inherit;cursor:pointer;font-size:1rem}
.sb-body{overflow-y:auto;padding:0 1.1rem 1rem;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.sb-ft{display:flex;gap:.6rem;padding:.8rem 1.1rem;border-top:1px solid var(--border)}
.sb-ft .btn{flex:1;font-size:.9rem;padding:.8rem}
.sb-ft .btn-ghost{flex:0 0 auto;font-size:.78rem}
.sb-chip{display:inline-flex;align-items:center;gap:.4rem;font-size:.72rem;font-weight:800;padding:.35rem .7rem;border-radius:20px;border:1px solid var(--border);background:rgba(5,8,22,.5);white-space:nowrap}
.sb-chip .d{width:8px;height:8px;border-radius:50%;background:#f87171}
.sb-chip.on .d{background:#34f5b8;box-shadow:0 0 8px #34f5b8}
.sb-grid{display:grid;grid-template-columns:1fr;gap:.7rem}
@media(min-width:560px){.sb-grid{grid-template-columns:1fr 1fr}}
.sb-shake{animation:sbsh .45s}
@keyframes sbsh{20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
.sb-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin-top:.9rem}
.sb-tile{position:relative;overflow:hidden;border:1px solid var(--border);background:rgba(124,92,255,.1);color:inherit;border-radius:18px;padding:.9rem .3rem;font:800 .85rem Tajawal,sans-serif;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.5rem;transition:transform .15s,border-color .2s}
.sb-tile span{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;color:#fff}
.sb-tile.t1 span{background:linear-gradient(135deg,#f59e0b,#ef4444)}.sb-tile.t2 span{background:linear-gradient(135deg,#7c5cff,#2f7bff)}.sb-tile.t3 span{background:linear-gradient(135deg,#0fb981,#14b8c4)}
.sb-tile:hover{transform:translateY(-3px);border-color:var(--accent2)}.sb-tile:active{transform:scale(.95)}
.rp{position:absolute;border-radius:50%;background:rgba(255,255,255,.35);transform:scale(0);animation:sbrp .6s ease-out;pointer-events:none}
@keyframes sbrp{to{transform:scale(3);opacity:0}}
.sb-opt{display:flex;align-items:center;gap:.6rem;margin-top:.9rem;font-size:.78rem;color:var(--muted);cursor:pointer}
.sb-opt input{width:18px;height:18px;accent-color:var(--accent)}
.sb-stats{display:flex;gap:1.1rem;margin-top:.9rem;font-size:.78rem;color:var(--muted)}.sb-stats b{color:var(--text)}
#sbList{display:flex;flex-direction:column;gap:.5rem;margin-top:.7rem}
.sb-empty{text-align:center;padding:1.6rem .5rem;color:var(--muted);font-size:.82rem;border:1px dashed var(--border);border-radius:14px}
.sb-it{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem;padding:.55rem .7rem;border:1px solid var(--border);border-radius:14px;background:rgba(5,8,22,.45)}
.sb-it.sb-in{animation:sbin .4s cubic-bezier(.2,1.4,.4,1)}
@keyframes sbin{from{opacity:0;transform:translateY(12px) scale(.96)}}
.sb-th{width:46px;height:46px;border-radius:10px;overflow:hidden;flex:0 0 46px;background:#02040f;display:flex;align-items:center;justify-content:center;color:var(--accent2);font-size:1.2rem}
.sb-th img{width:100%;height:100%;object-fit:cover}
.sb-nm{flex:1;min-width:0;font-size:.82rem;font-weight:700}
.sb-nm .n{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:ltr;text-align:right}
.sb-sz{display:block;font-size:.7rem;color:var(--muted);font-weight:500}
.sb-st{font-size:.72rem;font-weight:800;padding:.25rem .6rem;border-radius:20px;white-space:nowrap;transition:background .3s,color .3s}
.sb-st.w{background:rgba(245,158,11,.18);color:#fcd34d}.sb-st.s{background:rgba(124,92,255,.22);color:#c4b5fd}.sb-st.ok{background:rgba(16,185,129,.2);color:#6ee7b7}
.sb-x{background:none;border:0;color:#f87171;cursor:pointer;font-size:1rem;padding:.4rem}
.sb-pg{flex:1 0 100%;height:5px;border-radius:5px;background:rgba(148,163,255,.15);overflow:hidden;display:none}
.sb-pg i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2),var(--accent));background-size:200% 100%;animation:sbsh2 1.2s linear infinite;transition:width .2s}
@keyframes sbsh2{to{background-position:-200% 0}}
#sbNote{font-size:.78rem;margin-top:.8rem;color:var(--muted);min-height:1.2rem}
body.sb-open{overflow:hidden}
body.sb-open #toast{z-index:80;bottom:calc(96px + env(safe-area-inset-bottom,0px))}
</style>
<!-- Explainer video (collapsed; nothing runs until Play) -->
