  <div class="card p-5 sm:p-6">
    <div class="flex items-center justify-between cursor-pointer" onclick="toggleVideo()">
      <span class="card-title"><i class="fa-solid fa-circle-play"></i> شرح مرئي قصير: كيف تعمل الخوارزميات؟ (Video)</span>
      <i id="vidChevron" class="fa-solid fa-chevron-down text-xs transition-transform duration-200"></i>
    </div>
    <div id="vidBody" class="hidden mt-4">
      <div class="flex flex-wrap gap-2 mb-2">
        <button class="btn btn-ghost vlvl on" data-l="simple" onclick="vLevelSet('simple')">🍎 شرح مبسّط (للمبتدئين)</button>
        <button class="btn btn-ghost vlvl" data-l="detail" onclick="vLevelSet('detail')">🔬 شرح تفصيلي (بالأرقام)</button>
      </div>
      <div class="flex flex-wrap gap-2 mb-3">
        <button class="btn btn-ghost vtab on" data-k="general" onclick="vTab('general')">🔰 التشفير عموماً</button>
        <button class="btn btn-ghost vtab" data-k="des" onclick="vTab('des')">🔑 DES</button>
        <button class="btn btn-ghost vtab" data-k="rsa" onclick="vTab('rsa')">🔐 RSA</button>
        <button class="btn btn-ghost vtab" data-k="elgamal" onclick="vTab('elgamal')">🧮 ElGamal</button>
      </div>
      <div id="vStage" class="vid-stage"></div>
      <div class="vbar"><div id="vFill"></div></div>
