<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#050816">
<meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Crypto Lab">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin><link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&display=swap">
<meta name="description" content="المختبر التعليمي للتشفير: RSA وElGamal وDES بتجارب تفاعلية تعمل محلياً. من RK-TEAM.">
<meta property="og:title" content="المختبر التعليمي للتشفير | Cryptography Lab"><meta property="og:description" content="تجارب تفاعلية في التشفير تعمل داخل المتصفح بدون خادم."><meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔐</text></svg>">
<title>المختبر التعليمي للتشفير | Cryptography Lab</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>


:root{
  --bg1:#050816; --bg2:#0b1030; --bg3:#1a0b3b;
  --accent:#7c5cff; --accent2:#22d3ee; --good:#10b981; --warn:#f59e0b;
  --card:rgba(17,24,52,.62); --border:rgba(148,163,255,.18);
  --text:#e5e9ff; --muted:#93a0c9;
}
*{box-sizing:border-box}
body{
  font-family:'Tajawal',system-ui,sans-serif;
  color:var(--text);
  min-height:100vh;min-height:100dvh;
  -webkit-text-size-adjust:100%;text-size-adjust:100%;
  -webkit-tap-highlight-color:transparent;
  background:
    radial-gradient(900px 500px at 85% -10%, rgba(124,92,255,.35), transparent 60%),
    radial-gradient(800px 500px at -10% 110%, rgba(34,211,238,.22), transparent 60%),
    linear-gradient(160deg,var(--bg1),var(--bg2) 55%,var(--bg3));
  overflow-x:hidden;
}
#bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.55}
.grid-overlay{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(rgba(124,92,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(124,92,255,.07) 1px,transparent 1px);
  background-size:44px 44px;
  opacity:.6;
}
.wrap{position:relative;z-index:1}

.card{
  background:rgba(14,20,48,.92);
  border:1px solid var(--border);
  border-radius:20px;
  box-shadow:0 8px 24px -12px rgba(0,0,0,.7);
}
.card-title{font-weight:800;font-size:.95rem;display:flex;align-items:center;gap:.5rem;color:#fff}
.card-title i{color:var(--accent2)}
.label{display:block;font-size:.85rem;font-weight:700;color:#cdd5ff;margin-bottom:.5rem}
.label i{color:var(--accent2);margin-left:.35rem}

.field{
  width:100%;background:rgba(5,8,22,.6);color:#fff;
  border:1px solid var(--border);border-radius:14px;padding:.8rem 1rem;
  font-size:.95rem;transition:.2s;outline:none;
}
.field:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,92,255,.25)}
.field::placeholder{color:#6b77a3}
select.field{cursor:pointer}
select.field option{background:#0b1030;color:#fff}
.mono{font-family:'Courier New',monospace}

/* Buttons */
.btn{
  position:relative;overflow:hidden;border:0;cursor:pointer;color:#fff;
  font-weight:800;font-size:1rem;padding:.95rem 1rem;border-radius:14px;
  display:flex;align-items:center;justify-content:center;gap:.6rem;
  transition:transform .15s, box-shadow .25s, filter .25s;
  font-family:inherit;
}
.btn::after{
  content:"";position:absolute;top:0;left:-120%;width:60%;height:100%;
  background:linear-gradient(120deg,transparent,rgba(255,255,255,.35),transparent);
  transform:skewX(-20deg);transition:left .6s;
}
.btn:hover::after{left:140%}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn:active{transform:translateY(0) scale(.98)}
.btn-enc{background:linear-gradient(135deg,#6d4aff,#2f7bff);box-shadow:0 10px 30px -8px rgba(80,90,255,.8)}
.btn-dec{background:linear-gradient(135deg,#0fb981,#14b8c4);box-shadow:0 10px 30px -8px rgba(16,185,129,.7)}
.btn-ghost{
  background:rgba(124,92,255,.14);border:1px solid var(--border);color:#cfd6ff;
  font-size:.78rem;padding:.45rem .8rem;border-radius:10px;font-weight:700;
}
.btn-ghost:hover{background:rgba(124,92,255,.28)}
.btn-ghost::after{display:none}

/* Collapsible */
.adv{border:1px dashed var(--border);border-radius:14px;padding:1rem;background:rgba(5,8,22,.35)}
.adv-head{display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-weight:700;font-size:.85rem;color:#cdd5ff}
.k-label{display:block;font-size:.72rem;font-weight:700;color:var(--muted);margin-bottom:.25rem}
.k-input{width:100%;padding:.55rem;font-size:.8rem;background:rgba(5,8,22,.7);color:#fff;border:1px solid var(--border);border-radius:10px;font-family:'Courier New',monospace;outline:none}
.k-input:focus{border-color:var(--accent2)}

/* Output */
.result-box{
  min-height:76px;border-radius:14px;padding:1rem;word-break:break-all;
  background:#02040f;color:#34f5b8;border:1px solid rgba(52,245,184,.2);
  box-shadow:inset 0 0 25px rgba(52,245,184,.06);
  font-family:'Courier New',monospace;font-size:.95rem;display:flex;align-items:center;
}
.log-box{
  background:#02040f;border:1px solid var(--border);border-radius:14px;padding:1rem;
  direction:ltr;text-align:left;white-space:pre;overflow:auto;
  min-height:250px;max-height:420px;font-family:'Courier New',monospace;
  font-size:.78rem;line-height:1.7;color:#c9d2ff;
}
.custom-scrollbar::-webkit-scrollbar{width:8px;height:8px}
.custom-scrollbar::-webkit-scrollbar-track{background:rgba(5,8,22,.6);border-radius:4px}
.custom-scrollbar::-webkit-scrollbar-thumb{background:linear-gradient(var(--accent),var(--accent2));border-radius:4px}

/* Logo + badges */
.logo{
  width:54px;height:54px;border-radius:16px;display:grid;place-items:center;font-size:1.5rem;color:#fff;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 0 0 1px rgba(255,255,255,.15),0 12px 30px -8px rgba(124,92,255,.9);
}
.gradient-text{background:linear-gradient(90deg,#fff,#b6a8ff 50%,#7ee9ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.badge{display:inline-flex;align-items:center;gap:.4rem;padding:.35rem .8rem;border-radius:999px;font-size:.72rem;font-weight:700;background:rgba(16,185,129,.12);color:#6ee7b7;border:1px solid rgba(16,185,129,.35)}
.dot{width:8px;height:8px;border-radius:50%;background:#10b981;animation:pulse 1.6s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.7)}100%{box-shadow:0 0 0 10px rgba(16,185,129,0)}}

/* Credits */
.credits{position:relative;overflow:hidden}
.credits::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(500px 200px at 50% 0%,rgba(124,92,255,.25),transparent 70%);
  pointer-events:none;
}
.sup-chip{
  display:inline-flex;align-items:center;gap:.6rem;padding:.6rem 1.2rem;border-radius:14px;
  background:linear-gradient(135deg,rgba(245,158,11,.18),rgba(245,158,11,.06));
  border:1px solid rgba(245,158,11,.4);color:#fde68a;font-weight:800;
}
.designer{
  display:inline-block;max-width:100%;padding:1rem 2.4rem 1.1rem;margin:.4rem 0 1.6rem;border-radius:22px;
  background:linear-gradient(135deg,rgba(124,92,255,.28),rgba(34,211,238,.14));
  border:1px solid rgba(124,92,255,.6);
  box-shadow:0 0 32px -6px rgba(124,92,255,.65), inset 0 1px 0 rgba(255,255,255,.12);
}
.designer-tag{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:#fde68a;margin-bottom:.35rem}
.designer-name{
  font-size:clamp(1.8rem,7vw,2.6rem);font-weight:900;line-height:1.3;
  background:linear-gradient(90deg,#fff 0%,#c4b5fd 30%,#7ee9ff 55%,#fff 80%);
  background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;
  animation:nameShine 2.8s ease-out 1 both;
}
.designer-en{direction:ltr;font-weight:800;font-size:.9rem;letter-spacing:.35em;text-transform:uppercase;color:#cdd5ff;margin-top:.1rem}
@keyframes nameShine{from{background-position:100% 0}to{background-position:0 0}}
.stu{
  display:flex;align-items:center;gap:.65rem;padding:.65rem .9rem;border-radius:14px;
  background:rgba(124,92,255,.1);border:1px solid var(--border);transition:.2s;
}
.stu:hover{transform:translateY(-3px);background:rgba(124,92,255,.2);border-color:var(--accent)}
.stu .av{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:.8rem;color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent2));flex-shrink:0}
.stu .ar{font-weight:800;font-size:.88rem;color:#fff;line-height:1.2}
.stu .en{font-size:.72rem;color:var(--muted);direction:ltr;text-align:right;font-family:system-ui}

/* Mini explainer video (runs only on demand) */
.vtab.on,.vlvl.on{background:linear-gradient(135deg,#6d4aff,#2f7bff);color:#fff;border-color:transparent}
.vbox{unicode-bidi:plaintext}
.vbox.apple{color:#fecaca;border-color:rgba(248,113,113,.5);background:rgba(239,68,68,.12)}
.vbox.paint{color:#f5d0fe;border-color:rgba(232,121,249,.45);background:rgba(232,121,249,.1)}
.vbox.pub{color:#67e8f9;border-color:rgba(34,211,238,.45);background:rgba(34,211,238,.08)}
.vbox.priv{color:#f9a8d4;border-color:rgba(244,114,182,.45);background:rgba(244,114,182,.08)}
.vform{font-family:'Courier New',monospace;direction:ltr;white-space:pre;color:#c9d2ff;background:rgba(124,92,255,.1);border:1px solid var(--border);border-radius:10px;padding:.5rem .9rem;font-size:.92rem;font-weight:700;animation:vpop .5s both;max-width:100%;overflow-x:auto}
.vform em{font-style:normal;color:#34f5b8}
.vform u{text-decoration:none;color:#fde68a}
.vid-stage{min-height:260px;border-radius:14px;background:#02040f;border:1px solid var(--border);padding:1.2rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.1rem;text-align:center}
.vtitle{font-weight:900;font-size:1.15rem;color:#fff;animation:vpop .5s both}
.vrow{display:flex;align-items:center;justify-content:center;gap:.8rem;flex-wrap:wrap;direction:ltr}
.vbox{padding:.65rem 1.1rem;border-radius:12px;font-family:'Courier New',monospace;font-weight:800;font-size:1.05rem;border:1px solid var(--border);animation:vpop .5s both}
.vbox small{display:block;font-family:'Tajawal',sans-serif;font-weight:500;font-size:.68rem;opacity:.75;margin-top:.15rem}
.vbox.plain{color:#34f5b8;border-color:rgba(52,245,184,.4);background:rgba(52,245,184,.08)}
.vbox.cipher{color:#fca5a5;border-color:rgba(248,113,113,.4);background:rgba(248,113,113,.08)}
.vbox.key{color:#fde68a;border-color:rgba(245,158,11,.45);background:rgba(245,158,11,.1)}
.vbox.net{color:#a5b4fc;border-color:rgba(124,92,255,.5);background:rgba(124,92,255,.12)}
.varrow{color:var(--accent2);font-size:1.4rem;animation:vpop .5s both}
.vcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;width:100%}
.vcard{padding:.7rem;border-radius:12px;background:rgba(124,92,255,.12);border:1px solid var(--border);font-size:.8rem;color:#cdd5ff;animation:vpop .5s both}
.vcard b{display:block;color:#fff;font-size:.95rem;margin-bottom:.2rem}
@keyframes vpop{from{opacity:0;transform:scale(.75) translateY(8px)}to{opacity:1;transform:none}}
.vbar{height:6px;background:rgba(148,163,255,.15);border-radius:99px;margin-top:.9rem;overflow:hidden;direction:ltr}
#vFill{height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .1s linear}
#vCaption{margin-top:.8rem;font-size:.9rem;color:#cdd5ff;min-height:2.6rem;line-height:1.7}

/* History section */
.htab.on{background:linear-gradient(135deg,#6d4aff,#2f7bff);color:#fff;border-color:transparent}
.hpanel{display:none}.hpanel.on{display:block;animation:fade .4s both}
.chip{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .7rem;border-radius:999px;font-size:.72rem;font-weight:700;background:rgba(124,92,255,.14);border:1px solid var(--border);color:#cdd5ff}
.tl{position:relative;margin:0;padding:0 1.6rem 0 0;list-style:none;border-inline-start:2px solid rgba(124,92,255,.45)}
.tl li{position:relative;padding:0 0 1.15rem 0}
.tl li::before{content:"";position:absolute;right:-2.05rem;top:.35rem;width:12px;height:12px;border-radius:50%;background:var(--accent2);box-shadow:0 0 0 4px rgba(34,211,238,.18)}
.tl .yr{font-weight:900;color:#fde68a;font-size:.95rem}
.tl .tt{font-weight:800;color:#fff;font-size:.9rem}
.tl p{margin:.15rem 0 0;color:var(--muted);font-size:.83rem;line-height:1.8}
.hbox{background:rgba(5,8,22,.45);border:1px solid var(--border);border-radius:14px;padding:1rem}
.hbox h4{font-weight:800;font-size:.9rem;color:#fff;margin-bottom:.5rem}
.hbox li,.hbox p{font-size:.83rem;line-height:1.9;color:#cdd5ff}
.hbox ol{padding-inline-start:1.2rem;list-style:decimal}
.fm{direction:ltr;text-align:left;font-family:'Courier New',monospace;font-size:.82rem;color:#34f5b8;background:#02040f;border:1px solid rgba(52,245,184,.2);border-radius:10px;padding:.6rem .8rem;margin-top:.5rem;overflow-x:auto;white-space:pre}
.cmp{width:100%;border-collapse:collapse;font-size:.8rem;min-width:520px}
.cmp th{background:rgba(124,92,255,.2);color:#fff;font-weight:800;padding:.6rem;border:1px solid var(--border)}
.cmp td{padding:.55rem .6rem;border:1px solid var(--border);color:#cdd5ff;text-align:center}
.cmp td:first-child{font-weight:800;color:#fde68a;text-align:right}

/* Basics section */
.btab.on{background:linear-gradient(135deg,#6d4aff,#2f7bff);color:#fff;border-color:transparent}
.bpanel{display:none}.bpanel.on{display:block;animation:fade .4s both}
.gl{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:.6rem}
.gl div{padding:.7rem .85rem;border-radius:12px;background:rgba(124,92,255,.1);border:1px solid var(--border)}
.gl b{display:block;color:#fff;font-size:.88rem}.gl b span{direction:ltr;display:inline-block;color:var(--accent2);font-size:.78rem;margin-inline-start:.35rem;font-family:system-ui}
.gl p{margin:.2rem 0 0;font-size:.78rem;line-height:1.7;color:var(--muted)}
.goal{text-align:center}.goal i{font-size:1.4rem;color:var(--accent2);margin-bottom:.35rem}

/* Light animations: transform/opacity only, paused off-screen */
.anim-svg{display:block;width:100%;height:auto;direction:ltr}
.anim-svg text{font-family:inherit}
.anim .flow{animation:anDash 1.2s linear infinite}
@keyframes anDash{to{stroke-dashoffset:-22}}
.pk{animation:anPk 6s ease-in-out infinite}
@keyframes anPk{0%{transform:translateX(0)}25%,32%{transform:translateX(140px)}68%,75%{transform:translateX(380px)}100%{transform:translateX(520px)}}
.pp{animation:anPlain 6s infinite}
@keyframes anPlain{0%,24%{opacity:1}30%,72%{opacity:0}78%,100%{opacity:1}}
.pc{opacity:0;animation:anCipher 6s infinite}
@keyframes anCipher{0%,24%{opacity:0}30%,70%{opacity:1}76%,100%{opacity:0}}
.lk{transform-box:fill-box;transform-origin:center}
.lk1{animation:anL1 6s infinite}.lk2{animation:anL2 6s infinite}
@keyframes anL1{0%,20%{transform:scale(1)}27%{transform:scale(1.35)}34%,100%{transform:scale(1)}}
@keyframes anL2{0%,64%{transform:scale(1)}71%{transform:scale(1.35)}78%,100%{transform:scale(1)}}
.sh{transform:translateY(-12px);animation:anSh 7s ease-in-out infinite}
@keyframes anSh{0%,28%{transform:translateY(-12px)}34%,70%{transform:translateY(0)}78%,100%{transform:translateY(-12px)}}
.k1{animation:anK1 7s ease-in-out infinite}.k2{animation:anK2 7s ease-in-out infinite}
@keyframes anK1{0%,12%{transform:translateX(0)}26%,40%{transform:translateX(165px)}52%,100%{transform:translateX(0)}}
@keyframes anK2{0%,58%{transform:translateX(0)}70%,86%{transform:translateX(165px)}98%,100%{transform:translateX(0)}}
.c1{animation:anC1 7s infinite}.c2{opacity:0;animation:anC2 7s infinite}
@keyframes anC1{0%,46%{opacity:1}52%,100%{opacity:0}}
@keyframes anC2{0%,52%{opacity:0}58%,100%{opacity:1}}
.anim.paused *{animation-play-state:paused!important}
.logo{animation:anFloat 4s ease-in-out infinite}
@keyframes anFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
.floaties{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.fl{position:absolute;font-family:'Courier New',monospace;font-weight:700;color:#a5b4fc;opacity:.13;animation:anDrift var(--d,18s) ease-in-out infinite;will-change:transform}
@keyframes anDrift{0%,100%{transform:translate3d(0,0,0) rotate(0)}50%{transform:translate3d(18px,-46px,0) rotate(10deg)}}
@media (max-width:640px){.fl:nth-child(n+5){display:none}}
.rv{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.rv.in{opacity:1;transform:none}

/* ===== Extra light animations (transform/opacity only, GPU friendly) ===== */
.stage-chip{display:inline-flex;align-items:center;gap:.5rem;padding:.35rem .95rem;border-radius:999px;font-size:.74rem;font-weight:800;color:#fde68a;background:linear-gradient(135deg,rgba(245,158,11,.22),rgba(124,92,255,.2));border:1px solid rgba(245,158,11,.5);position:relative;overflow:hidden;margin-bottom:.45rem;max-width:100%;flex-wrap:wrap}
.stage-chip i{animation:anFloat 3s ease-in-out infinite}
.stage-chip .en{direction:ltr;font-family:system-ui;font-weight:700;opacity:.75;font-size:.68rem}
.stage-chip::after{content:"";position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);transform:translateX(-150%) skewX(-20deg);animation:chipShine 4.5s ease-in-out infinite;pointer-events:none}
@keyframes chipShine{0%,55%{transform:translateX(-150%) skewX(-20deg)}100%{transform:translateX(450%) skewX(-20deg)}}

/* orbit around the logo */
.logo{position:relative}
.logo::before{content:"";position:absolute;inset:-8px;border-radius:50%;border:1px dashed rgba(34,211,238,.45);animation:anSpin 12s linear infinite;pointer-events:none}
.logo::after{content:"";position:absolute;inset:-8px;border-radius:50%;background:radial-gradient(circle at 50% 0,#22d3ee 0 3px,transparent 4px);animation:anSpin 3.2s linear infinite;pointer-events:none}
@keyframes anSpin{to{transform:rotate(360deg)}}

/* binary rain (few columns, transform only) */
.rain{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.rc{position:absolute;top:-560px;font-family:'Courier New',monospace;font-size:14px;line-height:1.35;color:#34f5b8;white-space:pre;opacity:.2;
  -webkit-mask-image:linear-gradient(to bottom,transparent,#000 70%);mask-image:linear-gradient(to bottom,transparent,#000 70%);
  animation:rainFall var(--rd,14s) linear infinite;animation-delay:var(--rl,0s);will-change:transform}
@keyframes rainFall{from{transform:translate3d(0,0,0)}to{transform:translate3d(0,calc(100vh + 620px),0)}}
.rain.paused .rc{animation-play-state:paused}

/* scanning beam over the output box */
.result-box{position:relative;overflow:hidden}
.result-box::after{content:"";position:absolute;left:0;right:0;top:0;height:45%;background:linear-gradient(to bottom,transparent,rgba(52,245,184,.13),transparent);transform:translateY(-110%);animation:scanBeam 3.8s ease-in-out infinite;pointer-events:none}
@keyframes scanBeam{0%{transform:translateY(-110%)}100%{transform:translateY(240%)}}
.result-box.pop{animation:resPop .5s ease-out}
@keyframes resPop{0%{transform:scale(.97);opacity:.6}60%{transform:scale(1.01);opacity:1}100%{transform:scale(1)}}

/* gentle float for goal icons + hover lift for info boxes */
.goal i{display:inline-block;animation:anFloat 3.6s ease-in-out infinite}
.goal:nth-child(2) i{animation-delay:-.9s}.goal:nth-child(3) i{animation-delay:-1.8s}.goal:nth-child(4) i{animation-delay:-2.7s}
.hbox{transition:transform .25s ease,border-color .25s ease}
@media (hover:hover){.hbox:hover{transform:translateY(-3px);border-color:var(--accent)}}
.card-title i{display:inline-block;animation:anFloat 4s ease-in-out infinite}
@media (max-width:640px){.rc:nth-child(n+6){display:none}}

/* ===== RK-TEAM branding: intro, watermark, badge ===== */
#rkIntro{position:fixed;inset:0;z-index:100;display:grid;place-items:center;text-align:center;cursor:pointer;
  background:radial-gradient(600px 420px at 50% 45%,#141a4a,#02040f 72%);transition:opacity .7s ease}
#rkIntro.out{opacity:0;pointer-events:none}
#rkIntro .bgimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.2}
#rkIntro .in{position:relative;display:flex;flex-direction:column;align-items:center;gap:.9rem;padding:1rem}
.rk-hex{position:relative;width:150px;height:150px;animation:rkPop .9s cubic-bezier(.2,1.4,.4,1) both}
.rk-hex svg{width:100%;height:100%;display:block}
.rk-hex::before{content:"";position:absolute;inset:-18px;border-radius:50%;border:1px dashed rgba(34,211,238,.5);animation:anSpin 10s linear infinite}
.rk-hex::after{content:"";position:absolute;inset:-18px;border-radius:50%;background:radial-gradient(circle at 50% 0,#22d3ee 0 4px,transparent 5px);animation:anSpin 2.6s linear infinite}
.rk-glow{position:absolute;left:50%;top:38%;width:260px;height:260px;margin:-130px 0 0 -130px;border-radius:50%;background:radial-gradient(circle,rgba(124,92,255,.5),transparent 65%);animation:rkGlow 2.4s ease-in-out infinite;pointer-events:none}
@keyframes rkGlow{0%,100%{transform:scale(.85);opacity:.5}50%{transform:scale(1.1);opacity:.9}}
@keyframes rkPop{from{opacity:0;transform:scale(.4) rotate(-40deg)}to{opacity:1;transform:none}}

/* ===== network status bar ===== */
#netBar{position:sticky;top:6px;z-index:30;display:flex;flex-wrap:wrap;gap:.4rem;justify-content:center;align-items:center;margin:0 0 .6rem;direction:rtl}
.nb{display:inline-flex;align-items:center;gap:.4rem;padding:.24rem .65rem;border-radius:999px;background:var(--cb,var(--card));border:1px solid var(--border);color:var(--text,#e5e9ff);font-size:.72rem;font-weight:700;white-space:nowrap;cursor:pointer;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);user-select:none}
.nb b{font-weight:900;direction:ltr;unicode-bidi:isolate}
.nb small{color:var(--muted,#94a3b8);font-weight:600;font-size:.66rem}
.nb .d{width:8px;height:8px;border-radius:50%;background:#94a3b8;flex:none}
.nb.ok .d{background:#22c55e;box-shadow:0 0 8px #22c55e}
.nb.mid .d{background:#f59e0b;box-shadow:0 0 8px #f59e0b}
.nb.bad .d{background:#ef4444;box-shadow:0 0 8px #ef4444}
.nb.busy .d{animation:nbBlink .8s ease-in-out infinite}
@keyframes nbBlink{50%{opacity:.2}}
.nb i{font-size:.7rem;opacity:.85}
/* gateway activation */
.rk-ring{position:absolute;inset:0;border-radius:50%;border:2px solid #22d3ee;opacity:0;pointer-events:none;box-shadow:0 0 18px #22d3ee88}
#rkIntro.rk-go .rk-ring{animation:rkRing 1.6s cubic-bezier(.1,.7,.3,1) both}
#rkIntro.rk-go .rk-ring.r2{animation-delay:.3s;border-color:#a78bfa}
@keyframes rkRing{0%{opacity:.95;transform:scale(.7)}100%{opacity:0;transform:scale(5.5)}}
#rkIntro.rk-go .rk-hex{animation:rkPulse 1.8s ease-out both}
@keyframes rkPulse{0%{transform:scale(1);filter:brightness(1)}18%{transform:scale(.86);filter:brightness(2.4) drop-shadow(0 0 22px #22d3ee)}42%{transform:scale(1.16);filter:brightness(1.6)}100%{transform:scale(1);filter:brightness(1)}}
#rkIntro.rk-go .rk-glow{animation-duration:.8s}
#rkIntro.rk-go .rk-sub{color:#4ade80;text-shadow:0 0 12px #4ade8088}
#rkIntro.rk-go{cursor:default}
.rk-name{direction:ltr;font-family:'Arial Black',Impact,sans-serif;font-weight:900;font-size:clamp(1.8rem,8vw,3rem);letter-spacing:.28em;
  background:linear-gradient(90deg,#fff,#c4b5fd 40%,#7ee9ff 70%,#fff);-webkit-background-clip:text;background-clip:text;color:transparent;animation:rkUp .8s .5s both}
.rk-sub{direction:ltr;font-size:.72rem;font-weight:800;letter-spacing:.35em;color:#fde68a;animation:rkUp .8s .8s both}
.rk-hint{font-size:.8rem;color:var(--muted);animation:rkUp .8s 1.2s both}
.rk-bar{width:min(240px,70vw);height:3px;border-radius:99px;background:rgba(148,163,255,.18);overflow:hidden;animation:rkUp .6s 1s both}
.rk-bar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));transform-origin:left;transform:scaleX(0);animation:rkLoad 2.6s 1s linear forwards}
@keyframes rkLoad{to{transform:scaleX(1)}}
@keyframes rkUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.rk-wm{position:fixed;right:14px;bottom:14px;z-index:40;display:flex;align-items:center;gap:.45rem;opacity:.6;pointer-events:none;direction:ltr;
  font-family:'Arial Black',sans-serif;font-weight:900;font-size:.7rem;letter-spacing:.25em;color:#cdd5ff}
.rk-wm svg{width:30px;height:30px}
.rk-big{position:fixed;left:50%;top:50%;width:min(72vw,540px);height:min(72vw,540px);margin:calc(min(72vw,540px)/-2) 0 0 calc(min(72vw,540px)/-2);
  transform:rotate(-12deg);opacity:.05;z-index:0;pointer-events:none;animation:rkFloatBig 14s ease-in-out infinite}
.rk-big svg{width:100%;height:100%}
@keyframes rkFloatBig{0%,100%{transform:rotate(-12deg) translateY(0)}50%{transform:rotate(-8deg) translateY(-14px)}}
.rk-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .8rem;border-radius:999px;font-size:.72rem;font-weight:900;letter-spacing:.18em;direction:ltr;
  color:#c4b5fd;background:rgba(124,92,255,.14);border:1px solid rgba(124,92,255,.5);font-family:'Arial Black',sans-serif}
.rk-badge svg{width:20px;height:20px}
@media (max-width:640px){.rk-wm{font-size:.62rem;bottom:70px}.rk-hex{width:120px;height:120px}}

/* Toast */
#toast{position:fixed;bottom:20px;left:20px;z-index:50;background:#0b1030;border:1px solid var(--border);color:#fff;padding:.8rem 1.1rem;border-radius:14px;font-size:.85rem;font-weight:600;display:flex;gap:.5rem;align-items:center;box-shadow:0 20px 40px -10px #000;transform:translateY(80px);opacity:0;transition:.3s}
#toast.show{transform:translateY(0);opacity:1}
.fade-in{animation:fade .6s ease both}
@keyframes fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

/* ===== Responsive / mobile ===== */
.btn{max-width:100%;text-align:center}
main>*,.grid>*{min-width:0}
img,svg,canvas{max-width:100%}

/* touch screens: no sticky hover effects, no shine animation */
@media (hover:none){
  .btn:hover{transform:none;filter:none}
  .btn::after{display:none}
  .stu:hover{transform:none;background:rgba(124,92,255,.1);border-color:var(--border)}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
}

/* phones */
@media (max-width:640px){
  body{font-size:15px}
  /* 16px inputs stop iOS from zooming the page on focus */
  input,select,textarea,.field,.k-input{font-size:16px !important}
  .card{border-radius:16px}
  .btn{padding:.85rem .8rem;font-size:.95rem}
  .btn-ghost{min-height:42px;font-size:.8rem;padding:.5rem .8rem}
  .logo{width:46px;height:46px;font-size:1.25rem}
  .adv{padding:.8rem}
  .result-box{font-size:.9rem;min-height:64px}
  .log-box{font-size:.72rem;padding:.75rem;min-height:200px;max-height:300px}
  .vid-stage{padding:.8rem;min-height:220px;gap:.8rem}
  .vtitle{font-size:1rem}
  .vrow{gap:.5rem}
  .vbox{font-size:.9rem;padding:.5rem .7rem}
  .vform{font-size:.74rem;padding:.45rem .6rem;white-space:pre-wrap;text-align:left}
  .vcards{grid-template-columns:1fr}
  .varrow{font-size:1.1rem}
  #vCaption{font-size:.85rem}
  .sup-chip{flex-wrap:wrap;justify-content:center;padding:.5rem .8rem;font-size:.85rem}
  .sup-chip>span:nth-child(3){display:none}
  .stu{padding:.55rem .75rem}
  #toast{left:12px;right:12px;bottom:12px;font-size:.8rem}
}

/* very small phones */
@media (max-width:360px){
  .k-input{padding:.45rem}
  .vbox{font-size:.82rem}
  .vform{font-size:.68rem}
}
/* ===== RK ext: chapters, settings, themes ===== */
html{font-size:calc(100% * var(--fs,1))}
body,button,input,select,textarea{font-family:var(--ff,'Tajawal'),system-ui,sans-serif!important}
.l{direction:ltr;display:inline-block;unicode-bidi:isolate;font-family:'Courier New',monospace}
.kd{border:1px solid var(--border);border-radius:16px;margin-bottom:.6rem;background:rgba(124,92,255,.06);overflow:hidden}
.kd summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:.6rem;padding:.75rem .9rem;font-weight:800;font-size:.95rem;color:#fff;min-height:48px}
.kd summary::-webkit-details-marker{display:none}
.kd summary::after{content:"▾";margin-inline-start:auto;transition:transform .2s;color:var(--accent2)}
.kd[open] summary::after{transform:rotate(180deg)}
.kd>div{padding:.2rem 1rem 1rem;line-height:1.95;font-size:.92rem;color:#cdd5ff}
.kd[open]>div{animation:kxin .35s both}
.kd b{color:#fff}.kd p{margin:.35rem 0}
.mi{width:38px;height:38px;flex:none}
.kx-tbl{width:100%;border-collapse:collapse;font-size:.8rem;margin:.5rem 0}
.kx-tbl td,.kx-tbl th{border:1px solid var(--border);padding:.4rem .5rem;text-align:center}
.kx-out{background:rgba(5,8,22,.55);border:1px dashed var(--border);border-radius:12px;padding:.7rem;margin-top:.6rem;word-break:break-all;min-height:2.6rem;white-space:pre-wrap}
.kx-row{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem}
.kxp{display:none}.kxp.on{display:block;animation:kxin .35s both}
@keyframes kxin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes kxs{0%,100%{transform:translateX(0)}50%{transform:translateX(7px)}}
@keyframes kxb{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes kxr{to{transform:rotate(360deg)}}
@keyframes kxz{0%,100%{transform:scale(.8)}50%{transform:scale(1.15)}}
@keyframes kxd{to{stroke-dashoffset:-24}}
.mi .s{animation:kxs 1.6s ease-in-out infinite}.mi .b{animation:kxb 1.4s infinite}.mi .r{animation:kxr 5s linear infinite;transform-origin:24px 24px}.mi .z{animation:kxz 1.6s infinite;transform-origin:center;transform-box:fill-box}.mi .d{stroke-dasharray:6 6;animation:kxd 1s linear infinite}
.d1{animation-delay:.2s!important}.d2{animation-delay:.4s!important}.d3{animation-delay:.6s!important}
html.noanim *,html.noanim *::before,html.noanim *::after{animation:none!important;transition:none!important}
@media (prefers-reduced-motion:reduce){.mi *{animation:none!important}}
/* settings */
#stBtn{position:fixed;left:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:60;width:52px;height:52px;border-radius:50%;border:1px solid var(--border);background:var(--accent);color:#fff;font-size:1.25rem;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.45)}
#stBtn:active{transform:scale(.92)}
#stPan{position:fixed;left:12px;bottom:calc(76px + env(safe-area-inset-bottom,0px));z-index:60;width:min(92vw,330px);max-height:75vh;overflow:auto;background:#0e1430;color:#e5e9ff;border:1px solid var(--border);border-radius:18px;padding:1rem;display:none;box-shadow:0 14px 40px rgba(0,0,0,.6)}
#stPan.on{display:block;animation:kxin .25s both}
#stPan h5{font-weight:800;font-size:.85rem;margin:.8rem 0 .4rem;color:var(--accent2)}#stPan h5:first-child{margin-top:0}
.sw{display:flex;flex-wrap:wrap;gap:.5rem}
.sw button{width:44px;height:44px;border-radius:50%;border:3px solid transparent;cursor:pointer}
.sw button.on{border-color:#fff;box-shadow:0 0 0 2px var(--accent)}
.sz{display:flex;align-items:center;gap:.5rem}.sz button,.tg{min-height:44px;min-width:44px;border-radius:12px;border:1px solid var(--border);background:rgba(124,92,255,.2);color:inherit;font-weight:800;cursor:pointer;padding:0 .8rem}
.sz input{flex:1;accent-color:var(--accent)}
#stPan select{width:100%;min-height:44px;border-radius:12px;background:#0b1030;color:#fff;border:1px solid var(--border);padding:0 .6rem}
.tg.on{background:var(--accent);color:#fff}
/* themes */
:root[data-t=green]{--bg1:#02120a;--bg2:#052414;--bg3:#0a3a1f;--accent:#16a34a;--accent2:#86efac;--text:#dcfce7;--muted:#86b79a;--border:rgba(134,239,172,.28);--cb:rgba(4,28,16,.94)}
:root[data-t=red]{--bg1:#140404;--bg2:#2a0808;--bg3:#3b0d0d;--accent:#dc2626;--accent2:#fca5a5;--text:#ffe4e4;--muted:#d19a9a;--border:rgba(252,165,165,.28);--cb:rgba(40,8,8,.94)}
:root[data-t=blue]{--bg1:#020b1a;--bg2:#06204a;--bg3:#0a2f6b;--accent:#2563eb;--accent2:#7dd3fc;--text:#e0f0ff;--muted:#93b4d9;--border:rgba(125,211,252,.28);--cb:rgba(5,22,52,.94)}
:root[data-t=black]{--bg1:#000;--bg2:#000;--bg3:#0a0a0a;--accent:#fff;--accent2:#ddd;--text:#fff;--muted:#bbb;--border:rgba(255,255,255,.4);--cb:#000}
:root[data-t=white]{--bg1:#fff;--bg2:#fff;--bg3:#f4f4f4;--accent:#000;--accent2:#222;--text:#000;--muted:#333;--border:rgba(0,0,0,.65);--cb:#fff}
:root[data-t] body{background:linear-gradient(160deg,var(--bg1),var(--bg2) 55%,var(--bg3))!important}
:root[data-t] #stPan{background:var(--cb,#0e1430);color:var(--text)}
:root[data-t=black],:root[data-t=white]{filter:grayscale(1)}
:root[data-t=black] #bg,:root[data-t=white] #bg,:root[data-t=black] .grid-overlay,:root[data-t=white] .grid-overlay,:root[data-t=black] .floaties,:root[data-t=white] .floaties{display:none}
:root[data-t] .wrap *:not(.btn):not(.btn *):not(i){color:var(--text)!important;border-color:var(--border)}
:root[data-t] .wrap svg text{fill:var(--text)!important}
:root[data-t] .card,:root[data-t] .hbox,:root[data-t] .kd,:root[data-t] .field,:root[data-t] .fm,:root[data-t] .kx-out,:root[data-t] .vbox,:root[data-t] .chip,:root[data-t] .badge,:root[data-t] .sup-chip,:root[data-t] .stage-chip{background:var(--cb)!important}
:root[data-t] .wrap i{color:var(--accent2)!important}
:root[data-t] .gradient-text{background:none!important;-webkit-text-fill-color:var(--text)!important}
:root[data-t] .btn{background:var(--accent)!important;color:var(--bg1)!important;border:1px solid var(--border)}
:root[data-t] .btn *{color:var(--bg1)!important}
:root[data-t] .btn-ghost{background:transparent!important;color:var(--text)!important}
:root[data-t] .btn-ghost *{color:var(--text)!important}
:root[data-t] .btn.on{background:var(--accent)!important;color:var(--bg1)!important}
:root[data-t] .btn.on *{color:var(--bg1)!important}
:root[data-t=green] #stBtn,:root[data-t=red] #stBtn,:root[data-t=blue] #stBtn{color:#fff}
:root[data-t=black] #stBtn{color:#000}:root[data-t=white] #stBtn{color:#fff}
/* ===== additions ===== */
.enx{direction:ltr;unicode-bidi:isolate;display:inline-block;color:var(--accent2);font-size:.82em;font-family:system-ui,sans-serif;font-weight:700}
.fig{background:#fff;border-radius:12px;padding:.5rem;margin:.6rem 0;text-align:center;box-shadow:0 6px 18px rgba(0,0,0,.35)}
.fig img{max-width:100%;height:auto;display:block;margin:0 auto}.fig figcaption{color:#1e2350;font-size:.78rem;font-weight:800;margin-top:.3rem}
.tools3{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:.55rem}
.tb{font-weight:900;padding:.75rem .3rem;font-size:.9rem;border:2px solid transparent;transition:transform .15s,box-shadow .25s}
.tb:active{transform:scale(.94)}.tb i{margin-inline-end:.3rem}
.tb-copy{background:rgba(34,211,238,.16);border-color:#22d3ee;color:#a5f3fc}.tb-copy:hover{box-shadow:0 0 18px #22d3ee88}
.tb-paste{background:rgba(52,245,184,.14);border-color:#34f5b8;color:#a7f3d0}.tb-paste:hover{box-shadow:0 0 18px #34f5b888}
.tb-del{background:rgba(244,63,94,.16);border-color:#fb7185;color:#fecdd3}.tb-del:hover{box-shadow:0 0 18px #fb718588}
.shk{animation:shk .35s}@keyframes shk{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.bst{position:fixed;z-index:9999;pointer-events:none;font-size:20px}
/* history wheel */
.wh-wrap{display:flex;flex-direction:column;align-items:center;gap:.8rem}
.wh-stage{width:min(100%,300px)}.wh-svg{width:100%;height:auto;display:block;overflow:visible}
.wh-ring{fill:none;stroke:rgba(124,92,255,.45);stroke-width:2}
.wh-rot{transition:transform 1.1s cubic-bezier(.65,0,.25,1)}
.wh-dot{fill:#3a3f7a;stroke:#94a0ff;stroke-width:2;cursor:pointer;transition:fill .4s,r .4s}.wh-dot{r:10}.wh-dot.on{fill:#22d3ee;stroke:#fff;r:13}.wh-n{font-size:11px;font-weight:900;fill:#fff;text-anchor:middle;dominant-baseline:central;pointer-events:none;transform-origin:150px 32px;transition:transform 1.1s cubic-bezier(.65,0,.25,1)}.wh-n.on{fill:#021018;font-size:13px}.noanim .wh-n{transition:none}
.wh-in{transform-origin:150px 150px;animation:whs 24s linear infinite}@keyframes whs{to{transform:rotate(360deg)}}
.wh-ptr{fill:#fde68a;filter:drop-shadow(0 0 6px #fde68a)}
.wh-year{fill:#fde68a;font-weight:900;font-size:20px;text-anchor:middle}
.wh-card{width:100%;text-align:center;animation:fade .5s both}
.wh-yr{font-weight:900;color:#fde68a;font-size:1.3rem}.wh-tt{font-weight:800;color:#fff}.wh-p{color:var(--muted);font-size:.85rem;line-height:1.9;margin:.3rem 0}
.wh-ctl{display:flex;gap:.4rem;justify-content:center;align-items:center;flex-wrap:wrap}
.sc{position:relative;width:110px;height:110px;margin:0 auto .4rem;display:grid;place-items:center}
.sc i{position:absolute;inset:0;border-radius:50%;border:2px dashed rgba(34,211,238,.6);animation:whs 8s linear infinite}
.sc i.r2{inset:12px;border-color:rgba(124,92,255,.7);animation-direction:reverse;animation-duration:5s}
.sc-ic{font-size:44px;animation:scin .8s both,scb 2.4s ease-in-out .8s infinite;filter:drop-shadow(0 0 12px rgba(34,211,238,.6))}
@keyframes scin{from{transform:scale(0) rotate(-180deg);opacity:0}}@keyframes scb{50%{transform:translateY(-6px) scale(1.08)}}
.sc b{position:absolute;color:#fde68a;font-size:14px;animation:orb 4s linear infinite;transform-origin:55px 55px;left:48px;top:-4px}
.sc b.s2{animation-duration:6s;color:#f9a8d4}.sc b.s3{animation-duration:3s;color:#34f5b8}
@keyframes orb{to{transform:rotate(360deg)}}
.noanim .wh-in,.noanim .sc i,.noanim .sc b,.noanim .sc-ic{animation:none}.noanim .wh-rot{transition:none}

</style>
<script>(function(n){
var T=String.fromCharCode(82,75,45,84,69,65,77),C=T+' \u00a9 2026',st=0,h,d,b,mo;
function sv(){return'url("data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="260" height="170"><text x="130" y="85" transform="rotate(-24 130 85)" text-anchor="middle" font-family="Arial" font-weight="900" font-size="22" letter-spacing="4" fill="rgba(255,255,255,.018)" stroke="rgba(0,0,0,.02)" stroke-width=".6">'+T+'</text><text x="130" y="112" transform="rotate(-24 130 112)" text-anchor="middle" font-family="Arial" font-size="9" fill="rgba(255,255,255,.018)">'+C+'</text></svg>')+'")'}
function mk(){try{if(h&&h.parentNode)h.remove()}catch(e){}
 h=document.createElement('div');h.style.cssText='position:fixed!important;inset:0!important;z-index:2147483647!important;pointer-events:none!important;display:block!important;visibility:visible!important;opacity:1!important;transform:none!important;filter:none!important;mix-blend-mode:normal!important;margin:0!important;padding:0!important';
 var sr=h.attachShadow({mode:'closed'});d=document.createElement('div');d.style.cssText='position:absolute;inset:0;background-image:'+sv()+';background-size:260px 170px;background-position:'+(n*43)+'px '+(n*29)+'px';
 b=document.createElement('div');b.textContent=C;b.style.cssText='position:absolute;bottom:2px;left:50%;transform:translateX(-50%);font:700 9px Arial;letter-spacing:.25em;color:rgba(255,255,255,.28);padding:1px 8px;direction:ltr;white-space:nowrap';
 sr.appendChild(d);sr.appendChild(b);document.documentElement.appendChild(h);
 try{mo&&mo.disconnect();mo=new MutationObserver(chk);mo.observe(h,{attributes:true});mo.observe(document.documentElement,{childList:true})}catch(e){}}
function ok(){try{if(!h||!h.isConnected||!d||!d.isConnected||!b||!b.isConnected)return false;
 var s=getComputedStyle(h),x=getComputedStyle(d),y=getComputedStyle(b);
 if(s.display==='none'||s.visibility!=='visible'||+s.opacity<.9||s.pointerEvents!=='none'||s.position!=='fixed')return false;
 if(x.backgroundImage==='none'||+x.opacity<.9||y.display==='none'||y.visibility!=='visible'||+y.opacity<.9)return false;
 var r=h.getBoundingClientRect();return r.width>=innerWidth*.9&&r.height>=innerHeight*.9}catch(e){return false}}
function chk(){if(!ok()){st++;mk();if(st>5)try{document.documentElement.style.setProperty('filter','blur(3px) grayscale(1)','important')}catch(e){}}
 try{if(document.title.indexOf(T)<0)document.title=document.title+' \u00b7 '+T}catch(e){}}
mk();setInterval(chk,700);
})(0);</script>
<style>
#ch23,#tasksSec,#sec-video,#sec-history,#closing{content-visibility:auto;contain-intrinsic-size:auto 900px}
html.rk-hid *,html.rk-hid *::before,html.rk-hid *::after{animation-play-state:paused!important}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
#rkPg{position:fixed;top:0;left:0;right:0;height:3px;z-index:100;transform:scaleX(0);transform-origin:right;background:linear-gradient(270deg,var(--accent,#7c5cff),var(--accent2,#22d3ee));pointer-events:none;will-change:transform}
.rk-skip{position:fixed;top:-60px;right:10px;z-index:101;background:#7c5cff;color:#fff;padding:.6rem 1rem;border-radius:10px;font-weight:800;text-decoration:none;transition:top .2s}.rk-skip:focus{top:10px}
</style>
</head>
<body class="p-3 sm:p-6 antialiased flex flex-col" id="top">
<script>
/* ===== إعدادات الأمان ===== */
window.RK_FB='https://test-a74ae-default-rtdb.firebaseio.com';       // رابط Firebase Realtime Database مثل https://اسم-المشروع-default-rtdb.firebaseio.com (بدون / في النهاية). فارغ = بدون Firebase
window.RK_WORKER='';   // ضع هنا رابط الـ Worker مثل https://rk-proxy.xxx.workers.dev (بدون / في النهاية)
window.RK_CHAT='5742308172';     // رقم المحادثة الرقمي (Chat ID)
window.RK_ALLOW=[];    // نطاقات الموقع المسموحة مثل ['mysite.com']؛ فارغ = بدون قفل
window.RK_TG=RK_WORKER||'https://api.telegram.org';
window.RK_TOK=RK_WORKER?'proxy':atob('OTAwMjk2MTU5OTpBQUdVTVk5MFJLVmxfc0FuQkJYZzR5UGxFMy1EQUZwUWpzdw==');
/* ===== Firebase helpers (مشتركة): قراءة بدون مكتبات + مهلة للشبكة ===== */
window.rkTmo=function(ms){try{var a=new AbortController();setTimeout(function(){a.abort()},ms);return a.signal}catch(e){return undefined}};
window.rkFbGet=function(path){if(!window.RK_FB)return Promise.reject(0);return fetch(RK_FB.replace(/\/$/,'')+'/'+path+'.json',{cache:'no-store',signal:rkTmo(12000)}).then(function(r){if(!r.ok)throw new Error('fb '+r.status);return r.json()})};
window.rkFbPut=function(path,body){if(!window.RK_FB)return Promise.reject(0);return fetch(RK_FB.replace(/\/$/,'')+'/'+path+'.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),signal:rkTmo(60000)}).then(function(r){if(!r.ok)throw new Error('fb '+r.status);return r.json()})};
/* وقت المنشور: t رقم (ميلي ثانية) أو d نص مثل 2026-11-17 14:30 أو أول مرة شوهد */
window.rkFbTime=function(id,x){var t=+x.t;if(t>1e11)return t;if(x.d){var v=Date.parse(String(x.d).replace(' ','T'));if(!isNaN(v))return v}
 try{var k='rk_fbt_'+id,o=+localStorage.getItem(k);if(!o){o=Date.now();localStorage.setItem(k,String(o))}return o}catch(e){return Date.now()}};
/* روابط كوكل درايف تتحول لرابط تنزيل مباشر */
window.rkFixUrl=function(u){u=String(u||'').trim();var m=u.match(/drive\.google\.com\/file\/d\/([^\/?#]+)/)||u.match(/drive\.google\.com\/(?:open|uc)\?[^#]*id=([^&#]+)/);return m?'https://drive.google.com/uc?export=download&id='+m[1]:u};
window.rkList=function(v){return v?(Array.isArray(v)?v:Object.keys(v).map(function(k){var o=v[k];if(typeof o==='string')o={text:o};if(o&&typeof o==='object'&&!o.id)o.id=k;return o})).filter(Boolean):[]};
if(RK_ALLOW.length&&!/^(localhost|127\.0\.0\.1)$/.test(location.hostname)&&RK_ALLOW.indexOf(location.hostname)<0){document.documentElement.innerHTML='<body style="background:#050816;color:#e5e9ff;font-family:sans-serif;display:grid;place-items:center;height:100vh;margin:0">هذه النسخة غير مصرّح بها.</body>';throw new Error('domain')}
</script>

