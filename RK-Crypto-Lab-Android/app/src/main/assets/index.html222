<script>
(function(){var B=document.body,p=document.createElement('div');p.id='rkPg';B.appendChild(p);
var a=document.createElement('a');a.className='rk-skip';a.href='#lab';a.textContent='تخطي إلى المختبر';B.insertBefore(a,B.firstChild);
var tk=0;function u(){tk=0;var m=document.documentElement.scrollHeight-innerHeight;p.style.transform='scaleX('+(m>0?Math.min(1,scrollY/m):0)+')'}
addEventListener('scroll',function(){tk||(tk=requestAnimationFrame(u))},{passive:true});addEventListener('resize',u);u();
document.addEventListener('visibilitychange',function(){document.documentElement.classList.toggle('rk-hid',document.hidden)})})();
</script>

<style id="rk-mobile">
/* ===== RK mobile polish ===== */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
*{-webkit-tap-highlight-color:transparent}
a,button,input,select,textarea,label,summary,[role=button]{touch-action:manipulation}
img,video,svg{max-width:100%}
pre,code,textarea,.mono{max-width:100%}
pre{overflow-x:auto;-webkit-overflow-scrolling:touch}
main#lab>*,.card,.grid>*{min-width:0}
.card p,.card li,.card td,.card th,.card h1,.card h2,.card h3,.card code{overflow-wrap:anywhere}
table{max-width:100%}
.al-ph .ad button{width:36px;height:36px}
@media(hover:none){
 .al-ph .cp{opacity:1!important;transform:none!important}
 .btn:hover,#dock a:hover,#sbFab:hover,#rkMenu:hover,.al-ph:hover img,.fl-it:hover{transform:none!important}
}
@media(max-width:700px){
 html,body{max-width:100%;overflow-x:hidden}
 body{padding-top:calc(66px + env(safe-area-inset-top,0px))!important;padding-left:max(12px,env(safe-area-inset-left))!important;padding-right:max(12px,env(safe-area-inset-right))!important;padding-bottom:calc(96px + env(safe-area-inset-bottom,0px))!important}
 #rkMenu{width:44px;height:44px;top:calc(10px + env(safe-area-inset-top,0px))}
 input,select,textarea,.field{font-size:16px!important}
 .btn{min-height:44px}
 .fl-chip{min-height:38px;display:inline-flex;align-items:center}
 header .btn,header .badge,header .rk-badge{max-width:100%}
 header .flex-wrap>.btn{width:100%;justify-content:center}
 header h1{line-height:1.5}
 .stage-chip{flex-wrap:wrap;justify-content:center;max-width:100%;white-space:normal;text-align:center}
 .card{border-radius:20px}
 .an-hd{gap:.5rem}
 .an-bt{width:100%}.an-bt .btn{width:100%;justify-content:center}
 #toast{left:12px;right:12px;bottom:calc(84px + env(safe-area-inset-bottom,0px));justify-content:center;text-align:center;max-width:none}
 #rkLb img{max-width:100%;max-height:78vh;max-height:78dvh;object-fit:contain}
 #alMd .bx,#rkAdmin>div,#trOv>*,#stPan{max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px);overflow-y:auto;-webkit-overflow-scrolling:touch}
 .al-grid{column-gap:.5rem}.al-ph{margin-bottom:.5rem;border-radius:14px}
 .rain,.floaties{display:none!important}
 *{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
}
@media(max-width:380px){
 body{font-size:14px}
 header h1{font-size:1.15rem}
 #dock .dk{padding:4px}#dock a{padding:7px 7px;min-width:36px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>

<style id="rk-extra">
.dl-tag{display:inline-block;margin-inline-start:.4rem;padding:.05rem .5rem;border-radius:99px;background:rgba(255,255,255,.22);font-size:.62rem;font-weight:800}
.ch-ill{margin:0 0 1rem;border-radius:16px;overflow:hidden;border:1px solid var(--border);background:#0b1030;box-shadow:0 8px 22px -12px rgba(0,0,0,.7)}
.ch-ill img{display:block;width:100%;height:auto;cursor:zoom-in}
.ch-ill figcaption{padding:.5rem .8rem;font-size:.75rem;font-weight:700;color:var(--muted);text-align:center;line-height:1.8}
section figure.fig img{cursor:zoom-in}
#rkIT{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:130;display:none;gap:.6rem;width:max-content;max-width:calc(100vw - 24px)}
body.lbopen #rkIT{display:flex}
#rkIT button{display:flex;align-items:center;justify-content:center;gap:.5rem;min-height:46px;padding:.6rem 1.2rem;border-radius:14px;border:1px solid rgba(255,255,255,.25);color:#fff;font:800 .95rem Tajawal,system-ui,sans-serif;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.5)}
#rkIT .dl{background:linear-gradient(135deg,#0fb981,#14b8c4)}
#rkIT .sh{background:linear-gradient(135deg,#6d4aff,#2f7bff)}
#rkIT button:disabled{opacity:.6}
body.lbopen #rkLb img,body.lbopen #anLb img{max-height:70vh;max-height:70dvh}
#rkApkDlg{position:fixed;inset:0;z-index:140;display:none;align-items:center;justify-content:center;padding:14px;background:rgba(2,4,15,.78)}
#rkApkDlg.on{display:flex}
#rkApkDlg .bx{width:min(100%,430px);max-height:92dvh;overflow:auto;background:#0e1430;border:1px solid var(--border);border-radius:22px;padding:1.2rem;box-shadow:0 30px 70px rgba(0,0,0,.6)}
#rkApkDlg h3{font-weight:900;color:#fff;font-size:1.05rem;margin-bottom:.4rem}
#rkApkDlg p,#rkApkDlg li{font-size:.86rem;line-height:2;color:#cdd5ff}
#rkApkDlg ol{padding-inline-start:1.2rem;list-style:decimal;margin:.3rem 0 .8rem}
#rkApkDlg .nt{background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.35);color:#fde68a;border-radius:12px;padding:.6rem .8rem;font-size:.8rem;line-height:1.9;margin-bottom:.8rem}
#rkApkDlg .row{display:flex;gap:.5rem;flex-wrap:wrap}#rkApkDlg .row .btn{flex:1;min-width:140px;font-size:.85rem;padding:.7rem .8rem}
</style>
<div id="rkIT" role="toolbar" aria-label="أدوات الصورة"><button type="button" class="dl" id="rkItDl"><i class="fa-solid fa-download"></i> تنزيل الصورة</button><button type="button" class="sh" id="rkItSh"><i class="fa-solid fa-share-nodes"></i> مشاركة</button></div>
<div id="rkApkDlg" role="dialog" aria-modal="true" aria-label="تحميل التطبيق"><div class="bx">
<h3>📱 تثبيت التطبيق على الهاتف</h3>
<div class="nt" id="apkNote">ملف الـ APK غير متوفر حالياً على هذا الرابط. يمكنك تثبيت الموقع كتطبيق مباشرة من المتصفح بهذه الخطوات:</div>
<p><b>أندرويد (Chrome):</b></p><ol><li>اضغط قائمة المتصفح ⋮</li><li>اختر «تثبيت التطبيق» أو «إضافة إلى الشاشة الرئيسية»</li><li>اضغط «تثبيت» وسيظهر بأيقونته مع تطبيقاتك</li></ol>
<p><b>آيفون (Safari):</b></p><ol><li>اضغط زر المشاركة ⬆️</li><li>اختر «إضافة إلى الشاشة الرئيسية»</li></ol>
<div class="row"><button type="button" class="btn btn-enc" id="apkHtml"><i class="fa-solid fa-file-code"></i> تحميل ملف HTML</button><button type="button" class="btn btn-ghost" id="apkX">إغلاق</button></div>
</div></div>
<script id="rk-extra-js">
(function(){
var $=function(i){return document.getElementById(i)};
function toast(m,ic){try{window.showToast&&window.showToast(m,ic||'fa-circle-check text-emerald-400')}catch(e){}}

/* ===== رابط ملف APK: ضع رابط الملف هنا بعد رفعه (أو ضع الملف Cryptography-Lab.apk بجانب هذه الصفحة) ===== */
window.RK_APK_URL=window.RK_APK_URL||'';

/* ---- manifest (تثبيت كتطبيق عندما لا يتوفر APK) ---- */
try{
 var ic='data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#0b1030"/><text y=".78em" x="50" text-anchor="middle" font-size="62">🔐</text></svg>');
 var mf={name:'المختبر التعليمي للتشفير',short_name:'Crypto Lab',lang:'ar',dir:'rtl',display:'standalone',start_url:location.href.split('#')[0],background_color:'#050816',theme_color:'#050816',icons:[{src:ic,sizes:'any',type:'image/svg+xml',purpose:'any'}]};
 var l=document.createElement('link');l.rel='manifest';l.href=URL.createObjectURL(new Blob([JSON.stringify(mf)],{type:'application/manifest+json'}));document.head.appendChild(l);
}catch(e){}

/* ---- أزرار التحميل في أول الصفحة ---- */
var mob=/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
var tag=document.querySelector(mob?'#dlApk .dl-tag':'#dlHtml .dl-tag');if(tag)tag.hidden=false;
var dip=null;
addEventListener('beforeinstallprompt',function(e){e.preventDefault();dip=e});
addEventListener('appinstalled',function(){toast('تم تثبيت التطبيق','fa-mobile-screen text-emerald-300')});
function saveUrl(u,n){var a=document.createElement('a');a.href=u;a.download=n;a.rel='noopener';document.body.appendChild(a);a.click();a.remove()}
$('dlApk').onclick=async function(){
 var u=window.RK_APK_URL||'',n=$('apkNote');
 if(!u&&/^https?:$/.test(location.protocol)){
  try{var r=await fetch('Cryptography-Lab.apk',{method:'HEAD',cache:'no-store'});var ct=r.headers.get('content-type')||'';if(r.ok&&!/text\/html/i.test(ct))u='Cryptography-Lab.apk'}catch(e){}
 }
 if(u){saveUrl(u,'Cryptography-Lab.apk');toast('بدأ تحميل التطبيق. افتح الملف بعد انتهائه لتثبيته','fa-mobile-screen text-emerald-300');return}
 if(dip){try{dip.prompt();await dip.userChoice}catch(e){}dip=null;return}
 n.style.display='block';$('rkApkDlg').classList.add('on');
};
$('apkX').onclick=function(){$('rkApkDlg').classList.remove('on')};
$('rkApkDlg').onclick=function(e){if(e.target===this)this.classList.remove('on')};
$('apkHtml').onclick=function(){$('rkApkDlg').classList.remove('on');window.downloadLab&&window.downloadLab()};

/* ---- تنزيل ومشاركة أي صورة في الموقع ---- */
var Lb=$('rkLb'),An=$('anLb');
function curSrc(){
 if(Lb&&Lb.classList.contains('on')){var i=Lb.querySelector('img');return i?i.getAttribute('src')||'':''}
 if(An&&An.classList.contains('on')){var j=An.querySelector('img');return j?j.getAttribute('src')||'':''}
 return''}
function raster(url){return new Promise(function(res,rej){var im=new Image();im.onload=function(){var w=im.naturalWidth||1200,h=im.naturalHeight||420,k=Math.min(2,2000/w),c=document.createElement('canvas');c.width=Math.round(w*k);c.height=Math.round(h*k);var x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);c.toBlob(function(b){b?res(b):rej()},'image/png')};im.onerror=rej;im.src=url})}
async function getBlob(u){var r=await fetch(u);if(!r.ok)throw 0;var b=await r.blob();if(/svg/i.test(b.type))b=await raster(u);return b}
function fname(b){var t=(b.type||'').toLowerCase(),e=t.indexOf('png')>=0?'png':t.indexOf('webp')>=0?'webp':t.indexOf('gif')>=0?'gif':'jpg',d=new Date(),p=function(x){return('0'+x).slice(-2)};
 return'RK-Crypto-Lab-'+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'-'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds())+'.'+e}
function busy(on){$('rkItDl').disabled=on;$('rkItSh').disabled=on}
async function dlImg(){
 var u=curSrc();if(!u){toast('الصورة لم تُحمَّل بعد، انتظر لحظة','fa-triangle-exclamation text-amber-300');return}
 busy(true);
 try{var b=await getBlob(u),url=URL.createObjectURL(b);saveUrl(url,fname(b));setTimeout(function(){URL.revokeObjectURL(url)},4000);toast('تم تنزيل الصورة','fa-download text-emerald-300')}
 catch(e){if(/^https?:/i.test(u)){window.open(u,'_blank','noopener');toast('تعذر التنزيل المباشر، فُتحت الصورة في تبويب جديد. اضغط عليها مطولاً لحفظها','fa-triangle-exclamation text-amber-300')}else toast('تعذر تنزيل الصورة','fa-triangle-exclamation text-rose-300')}
 busy(false)}
async function shImg(){
 var u=curSrc();if(!u){toast('الصورة لم تُحمَّل بعد، انتظر لحظة','fa-triangle-exclamation text-amber-300');return}
 busy(true);
 try{
  var b=await getBlob(u),f=new File([b],fname(b),{type:b.type||'image/jpeg'});
  if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:'المختبر التعليمي للتشفير',text:'RK-TEAM · المختبر التعليمي للتشفير'})}
  else{var url=URL.createObjectURL(b);saveUrl(url,f.name);setTimeout(function(){URL.revokeObjectURL(url)},4000);toast('المشاركة غير مدعومة في هذا المتصفح، تم تنزيل الصورة بدلاً منها','fa-circle-info text-sky-300')}
 }catch(e){if(!e||e.name!=='AbortError')toast('تعذرت المشاركة، جرّب زر التنزيل','fa-triangle-exclamation text-rose-300')}
 busy(false)}
$('rkItDl').onclick=dlImg;$('rkItSh').onclick=shImg;

/* ---- فتح أي صورة أخرى في الموقع (الأشكال ورسومات الفصول) بنفس العارض ---- */
document.addEventListener('click',function(e){
 var im=e.target&&e.target.closest?e.target.closest('img'):null;if(!im||!An)return;
 if(im.closest('#rkLb,#anLb,#rkIntro,#alMd,#anList,#albumSec,#rkApkDlg'))return;
 if(!im.closest('section'))return;
 var u=im.currentSrc||im.getAttribute('src')||'';if(!u||(im.naturalWidth&&im.naturalWidth<60))return;
 var big=An.querySelector('img');big.src=u;An.classList.add('on')
});
})();
</script>
</body>
</html>
