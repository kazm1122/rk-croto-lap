<script>
(function(){
var links=[].slice.call(document.querySelectorAll('#dock a')),box=document.getElementById('dockIn'),cur='',tk=0;
function go(e){var id=this.dataset.t;e.preventDefault();var el=id==='top'?null:document.getElementById(id);
 if(!el)window.scrollTo({top:0,behavior:'smooth'});else el.scrollIntoView({behavior:'smooth',block:'start'})}
links.forEach(function(a){a.addEventListener('click',go)});
function upd(){tk=0;var y=window.innerHeight*.4,id='top',nearEnd=window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-6;
 if(window.scrollY>160){links.forEach(function(a){var el=document.getElementById(a.dataset.t);if(el&&el.getBoundingClientRect().top<=y)id=a.dataset.t})}
 if(nearEnd&&window.scrollY>160)id='closing';
 if(id===cur)return;cur=id;links.forEach(function(a){var on=a.dataset.t===id;a.classList.toggle('on',on);if(on)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current')});
 var a=box.querySelector('a.on');if(a&&box.scrollWidth>box.clientWidth)box.scrollTo({left:a.offsetLeft-box.clientWidth/2+a.offsetWidth/2,behavior:'smooth'})}
window.addEventListener('scroll',function(){if(!tk)tk=requestAnimationFrame(upd)},{passive:true});
window.addEventListener('resize',upd);upd();
})();
</script>

