<!-- Bottom navigation dock -->
<style>
#dock{position:fixed;z-index:55;bottom:calc(12px + env(safe-area-inset-bottom,0px));left:74px;right:10px;display:flex;justify-content:center;pointer-events:none}
#dock .dk{pointer-events:auto;display:flex;gap:2px;direction:rtl;max-width:100%;overflow-x:auto;scrollbar-width:none;padding:6px;border-radius:22px;background:var(--cb,rgba(11,16,48,.9));border:1px solid var(--border);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 10px 34px rgba(0,0,0,.45),inset 0 0 0 1px rgba(255,255,255,.04)}
#dock .dk::-webkit-scrollbar{display:none}
#dock a{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-width:40px;padding:8px 9px;border-radius:16px;color:var(--muted);text-decoration:none;font-size:10.5px;font-weight:700;line-height:1;transition:background .2s,color .2s,transform .2s}
#dock a svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#dock a span{display:none;white-space:nowrap}
#dock a:hover{color:var(--text);background:rgba(124,92,255,.16);transform:translateY(-2px)}
#dock a:focus-visible{outline:2px solid var(--accent2);outline-offset:1px}
#dock a.on{color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 4px 14px rgba(0,0,0,.35)}
#dock a.on span{display:block}
@media(min-width:700px){#dock{left:50%;right:auto;transform:translateX(-50%)}#dock a{padding:9px 14px;min-width:58px}#dock a span{display:block}#dock a svg{width:20px;height:20px}}
html{scroll-behavior:smooth}
#ch23,#tasksSec,#closing,#lab,#sec-basics,#sec-video,#sec-history{scroll-margin-top:14px}
</style>
<nav id="dock" aria-label="قائمة التنقل في الموقع"><div class="dk" id="dockIn">
<a href="#top" data-t="top" class="on"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg><span>الرئيسية</span></a><a href="#annSec" data-t="annSec"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 21a2 2 0 0 0 4 0"/></svg><span>التبليغات</span><i class="dk-n" data-n="0"></i></a><a href="#sendSec" data-t="sendSec"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg><span>التسليم</span></a><button type="button" class="dkb" id="dkHelp" aria-label="جولة الشرح"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7"/><path d="M12 17h.01"/></svg><span>الدليل</span></button>
